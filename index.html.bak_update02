const newStyles = `
    /* ============================================================
       TYPOGRAPHY TOKENS (MONTSERRAT BOLD & POP WARNER)
       ============================================================ */
    :root {
      --font-heading: 'Montserrat', sans-serif;
      --font-pop-warner: 'Pop Warner', sans-serif;
      
      /* Dark Theme (Layered Graphite System) */
      --dbl-bg-root: #101114;
      --dbl-bg-section: #15161A;
      --dbl-surface-matte: #15161A;
      --dbl-surface-charcoal: #1A1B20;
      --dbl-surface-graphite: #222329;
      --dbl-surface-elevated: #292A31;
      --dbl-surface-active: #32333B;

      --dbl-border-subtle: rgba(255, 255, 255, 0.06);
      --dbl-border-base: rgba(255, 255, 255, 0.10);
      --dbl-border-strong: rgba(255, 255, 255, 0.20);
      --dbl-border-hover: rgba(255, 255, 255, 0.35);

      --dbl-text-primary: #F3F3F1;
      --dbl-text-secondary: #8E8E96;
      --dbl-text-tertiary: #6E6E7A;
      --dbl-text-dim: rgba(255, 255, 255, 0.38);

      --dbl-crimson: #FF3038;
      --dbl-crimson-subtle: rgba(255, 48, 56, 0.12);
      --dbl-crimson-border: rgba(255, 48, 56, 0.42);
      --dbl-crimson-glow: rgba(255, 48, 56, 0.28);
    }

    /* Light Theme (Refined Neumorphism System) */
    [data-theme="light"] {
      --dbl-bg-root: #EAE9E7;
      --dbl-bg-section: #EAE9E7;
      --dbl-surface-matte: #F1F0EE;
      --dbl-surface-charcoal: #F1F0EE;
      --dbl-surface-graphite: #E4E2DF;
      --dbl-surface-elevated: #F1F0EE;
      --dbl-surface-active: #E4E2DF;

      --dbl-border-subtle: rgba(0, 0, 0, 0.05);
      --dbl-border-base: #D5D3CF;
      --dbl-border-strong: rgba(0, 0, 0, 0.16);
      --dbl-border-hover: rgba(0, 0, 0, 0.32);

      --dbl-text-primary: #18181A;
      --dbl-text-secondary: #69696F;
      --dbl-text-tertiary: #848492;
      --dbl-text-dim: rgba(24, 24, 26, 0.45);

      --dbl-crimson: #D9242C;
      --dbl-crimson-subtle: rgba(217, 36, 44, 0.10);

      /* Neumorphic Soft Elevations */
      --neu-raised: 6px 6px 16px rgba(185, 181, 174, 0.50), -6px -6px 16px #FFFFFF;
      --neu-raised-sm: 3px 3px 8px rgba(185, 181, 174, 0.45), -3px -3px 8px #FFFFFF;
      --neu-recessed: inset 3px 3px 7px rgba(185, 181, 174, 0.45), inset -3px -3px 7px #FFFFFF;
    }

    /* Montserrat Bold for Headings */
    .dbl-title-main,
    .build-headline,
    .section-heading-bold {
      font-family: var(--font-heading) !important;
      font-weight: 800 !important;
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }

    /* Pop Warner for Numerical Metrics */
    .number-val {
      font-family: var(--font-pop-warner), sans-serif !important;
      font-weight: normal !important;
      font-size: clamp(2.4rem, 3.8vw, 3.6rem) !important;
      letter-spacing: 0.02em !important;
      line-height: 1 !important;
      color: var(--dbl-text-primary);
    }
    .number-val .plus-sym {
      font-family: var(--font-pop-warner), sans-serif !important;
      color: var(--dbl-crimson);
      font-size: 0.82em;
    }

    /* Neumorphic surfaces in light theme */
    [data-theme="light"] .number-tile {
      background: var(--dbl-surface-matte);
      border-color: rgba(255, 255, 255, 0.8);
      box-shadow: var(--neu-raised);
    }
    [data-theme="light"] .number-tile:hover,
    [data-theme="light"] .number-tile.is-expanded {
      box-shadow: 8px 8px 20px rgba(180, 176, 168, 0.60), -8px -8px 20px #FFFFFF;
    }
    [data-theme="light"] .expertise-row {
      background: var(--dbl-surface-matte);
