      left: 0;
      width: 22px;
      height: 22px;
      pointer-events: none;
      z-index: 9999999;
      opacity: 0;
      visibility: hidden;
      will-change: transform;
      transform: translate3d(-100px, -100px, 0);
      mix-blend-mode: difference;
      transition: opacity 0.16s ease, visibility 0.16s ease;
    }
    .section-cursor.is-active {
      opacity: 1;
