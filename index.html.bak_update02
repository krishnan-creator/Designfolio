      gap: 14px;
    }
    .catalog-arrow-btn {
      width: 38px;
      height: 38px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .catalog-counter {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      letter-spacing: 0.1em;
    }

    .catalog-track-viewport {
      position: relative;
      width: 100%;
      min-height: 440px;
      perspective: 1200px;
      overflow: hidden;
      cursor: grab;
      user-select: none;
    }
    .catalog-track-viewport:active {
      cursor: grabbing;
    }
    .catalog-cards-track {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100%;
      height: 380px;
      transform: translate(-50%, -50%);
      transform-style: preserve-3d;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .catalog-card-item {
      position: absolute;
      top: 50%;
      left: 50%;
      width: clamp(260px, 32vw, 320px);
      height: 370px;
      margin-left: calc(-1 * clamp(260px, 32vw, 320px) / 2);
      margin-top: -185px;
      border-radius: 12px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      cursor: pointer;
      transform-style: preserve-3d;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .catalog-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .catalog-card-index {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      opacity: 0.75;
    }
    .catalog-card-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--dbl-crimson);
    }
    .catalog-card-img-wrap {
      width: 100%;
      height: 140px;
      border-radius: 8px;
      overflow: hidden;
      margin: 14px 0;
      position: relative;
    }
    .catalog-card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .catalog-card-item:hover .catalog-card-img-wrap img {
      transform: scale(1.05);
    }
    .catalog-card-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 17px;
      letter-spacing: -0.01em;
      line-height: 1.25;
      margin-bottom: 8px;
      text-transform: uppercase;
    }
    .catalog-card-desc {
      font-size: 12.5px;
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .catalog-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 10px;
      border-top: 1px solid rgba(128, 128, 128, 0.15);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      letter-spacing: 0.1em;
    }
    .catalog-drag-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
    }

    /* Catalog Detail Drawer */
    .catalog-detail-drawer {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 99999999;
      display: none;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .catalog-detail-drawer.is-open {
      display: flex;
      opacity: 1;
    }
    .drawer-backdrop {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(10px);
    }
    .drawer-content-box {
      position: relative;
      z-index: 2;
      width: min(92vw, 760px);
      max-height: 88vh;
      overflow-y: auto;
      border-radius: 12px;
      padding: clamp(24px, 4vw, 40px);
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-strong);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.60);
      color: var(--dbl-text-primary);
    }
    .drawer-close-btn {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--dbl-surface-graphite);
      color: var(--dbl-text-primary);
      border: 1px solid var(--dbl-border-base);
      font-size: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .drawer-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 28px;
    }
    @media (max-width: 680px) {
      .drawer-grid { grid-template-columns: 1fr; }
    }
    .drawer-image-wrap {
      width: 100%;
      height: 240px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--dbl-border-base);
    }
    .drawer-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .drawer-media-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--dbl-text-secondary);
      margin-top: 8px;
    }
    .drawer-index-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.16em;
      color: var(--dbl-crimson);
      display: block;
      margin-bottom: 6px;
    }
    .drawer-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(20px, 2.5vw, 26px);
      letter-spacing: -0.01em;
      text-transform: uppercase;
      margin-bottom: 12px;
      color: var(--dbl-text-primary);
    }
    .drawer-desc {
      font-size: 14px;
      line-height: 1.6;
      color: var(--dbl-text-secondary);
      margin-bottom: 20px;
    }
    .drawer-caps-heading {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 10px;
      color: var(--dbl-text-primary);
    }
    .drawer-caps-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .drawer-cap-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      padding: 5px 12px;
      border-radius: 4px;
      background: var(--dbl-surface-graphite);
      border: 1px solid var(--dbl-border-base);
      color: var(--dbl-text-primary);
    }

    /* ============================================================
       SECTION 05 — A BIT ABOUT ME (REPLACES THE PIPELINE)
       ============================================================ */
    .about-me-section {
      position: relative;
      margin-bottom: clamp(70px, 9vw, 120px);
    }
    .about-me-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 20px;
    }
    @media (max-width: 900px) {
      .about-me-grid { grid-template-columns: 1fr; }
    }
    .about-card {
      border-radius: 12px;
      padding: clamp(24px, 3.5vw, 34px);
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      position: relative;
    }
    .about-card-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      letter-spacing: 0.16em;
      color: var(--dbl-crimson);
      text-transform: uppercase;
      margin-bottom: 10px;
    }
    .about-card-title {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: clamp(22px, 2.8vw, 30px);
      letter-spacing: -0.01em;
      text-transform: uppercase;
      margin-bottom: 14px;
      color: var(--dbl-text-primary);
    }
    .about-intro-lead {
      font-size: 15.5px;
      font-weight: 500;
      line-height: 1.55;
      color: var(--dbl-text-primary);
      margin-bottom: 14px;
    }
    .about-intro-body {
      font-size: 14px;
      line-height: 1.65;
      color: var(--dbl-text-secondary);
      margin-bottom: 22px;
    }
    .about-meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .about-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      letter-spacing: 0.1em;
      padding: 5px 12px;
      border-radius: 20px;
      background: var(--dbl-surface-graphite);
      border: 1px solid var(--dbl-border-base);
      color: var(--dbl-text-primary);
    }

    .about-portrait-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }
    .about-portrait-wrap {
      width: 100%;
      height: 260px;
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      border: 1px solid var(--dbl-border-base);
    }
    .about-portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      filter: grayscale(20%) contrast(1.05);
    }
    .about-portrait-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 60%, rgba(0, 0, 0, 0.65) 100%);
    }
    .about-portrait-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
    }
    .portrait-name-label {
      color: var(--dbl-text-primary);
      font-weight: 700;
    }
    .portrait-role-label {
      color: var(--dbl-crimson);
    }

    .about-card-subheading {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 17px;
      letter-spacing: -0.01em;
      text-transform: uppercase;
      margin-bottom: 12px;
      color: var(--dbl-text-primary);
    }
    .about-foundation-text {
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--dbl-text-secondary);
      margin-bottom: 18px;
    }
    .foundation-pillars {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .pillar-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      color: var(--dbl-text-primary);
    }
    .pillar-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dbl-crimson);
    }

    /* Timeline step */
    .about-timeline-track {
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
      padding-left: 14px;
      border-left: 1.5px solid var(--dbl-border-strong);
    }
    .timeline-step {
      position: relative;
    }
    .step-bullet {
      position: absolute;
      left: -19px;
      top: 4px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--dbl-crimson);
      border: 1.5px solid var(--dbl-bg-root);
    }
    .step-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .step-company {
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.04em;
      color: var(--dbl-text-primary);
    }
    .step-role {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--dbl-text-secondary);
    }

    /* DRAWING ARTIST PANEL (Full Width Span) */
    .about-drawing-card {
      grid-column: 1 / -1;
      border-left: 3px solid var(--dbl-crimson);
    }
    .drawing-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .drawing-headline {
      font-family: var(--font-heading);
      font-weight: 900;
      font-size: clamp(24px, 3.2vw, 34px);
      letter-spacing: -0.01em;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
    }
    .drawing-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      padding: 5px 12px;
      border-radius: 4px;
      background: var(--dbl-crimson-subtle);
      border: 1px solid var(--dbl-crimson);
      color: var(--dbl-crimson);
    }
    .drawing-quote {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(15px, 1.3vw, 17.5px);
      font-style: italic;
      line-height: 1.6;
      color: var(--dbl-text-primary);
      margin: 14px 0 24px 0;
      padding-left: 18px;
      border-left: 2px solid var(--dbl-crimson);
      max-width: 820px;
    }
    .drawing-gallery-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }
    @media (max-width: 800px) {
      .drawing-gallery-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .drawing-artwork-thumb {
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--dbl-border-base);
      background: var(--dbl-surface-charcoal);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .drawing-artwork-thumb:hover {
      transform: translateY(-4px);
      border-color: var(--dbl-crimson);
    }
    .drawing-artwork-thumb img {
      width: 100%;
      height: 150px;
      object-fit: cover;
    }
    .artwork-thumb-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      letter-spacing: 0.1em;
      padding: 8px 10px;
      color: var(--dbl-text-secondary);
      text-transform: uppercase;
    }

    /* Interests Panel */
    .about-interests-card {
      grid-column: 1 / -1;
    }
    .interests-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 14px;
    }
    @media (max-width: 780px) {
      .interests-grid { grid-template-columns: 1fr; }
    }
    .interest-pill-box {
      padding: 16px;
      border-radius: 8px;
      background: var(--dbl-surface-graphite);
      border: 1px solid var(--dbl-border-base);
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .interest-icon {
      color: var(--dbl-crimson);
      font-size: 16px;
      line-height: 1;
      margin-top: 2px;
    }
    .interest-pill-box strong {
      display: block;
      font-family: var(--font-heading);
      font-size: 13.5px;
      color: var(--dbl-text-primary);
      margin-bottom: 4px;
    }
    .interest-pill-box p {
      font-size: 12.5px;
      color: var(--dbl-text-secondary);
      line-height: 1.45;
    }
`;

fs.writeFileSync('scratch/new_master_styles.css', newStyles, 'utf8');
console.log('Saved scratch/new_master_styles.css');

  </style>
</head>

<body>

  <!-- AQUA GLOW TRAIL CANVAS -->
  <canvas id="cursor-trail-canvas" aria-hidden="true"></canvas>

  <!-- SECTION-AWARE VECTOR TRIANGULAR ARROWHEAD CURSOR -->
  <div id="section-cursor" class="section-cursor" aria-hidden="true">
    <svg class="section-cursor-svg" viewBox="0 0 24 24" width="18" height="18">
      <polygon points="2,2 18,7 11,11 7,18" />
    </svg>
  </div>

  <!-- CIRCULAR THEME REVEAL CURTAIN (EXPANDS FROM THEME ICON POSITION IN POST-HERO) -->
  <div id="theme-circle-curtain" aria-hidden="true"></div>

  <!-- HERO-ONLY THIN GLOSSY CIRCULAR RIPPLE RING -->
  <div id="hero-theme-gloss-ring" aria-hidden="true"></div>

  <!-- ============================================================
       0. OPENING CENTER SPLASH (GLYPH LOTTERY BRANDING + GLITCH — EXACT 0.5S)
       ============================================================ -->
  <div class="center-splash" id="center-splash">
    <div class="splash-content splash-glitching" id="splash-content">
      <span class="splash-title" id="splash-title">CBK <span id="splash-df">DESIGNFOLIO</span></span>
    </div>
  </div>

  <!-- MULTIVERSE / DIMENSIONAL GLITCH LAYER (SECOND GLITCH TRANSITION) -->
  <div class="multiverse-glitch-layer" id="multiverse-glitch-layer" aria-hidden="true"></div>

  <!-- ============================================================
       1. FIXED DBL HEADER (THEME TOGGLE + LIVE CLOCK)
       ============================================================ -->
  <header class="hero-header" id="hero-header">
    <div class="header-left">
      <a href="#hero-section" class="brand-group" aria-label="Home — C. Bala Krishnan">
        <span class="brand-cbk">CBK</span>
        
        <span class="brand-designfolio" id="brand-df"><span class="df-char" data-orig="D" data-idx="0">D</span><span class="df-char" data-orig="E" data-idx="1">E</span><span class="df-char" data-orig="S" data-idx="2">S</span><span class="df-char" data-orig="I" data-idx="3">I</span><span class="df-char" data-orig="G" data-idx="4">G</span><span class="df-char" data-orig="N" data-idx="5">N</span><span class="df-char" data-orig="F" data-idx="6">F</span><span class="df-char" data-orig="O" data-idx="7">O</span><span class="df-char" data-orig="L" data-idx="8">L</span><span class="df-char" data-orig="I" data-idx="9">I</span><span class="df-char" data-orig="O" data-idx="10">O</span><span class="df-slot-indicator" id="df-slot"></span></span>
      </a>

      <span class="header-tag-pill">DBL // V3 ARCHIVE</span>
    </div>

    <div class="header-right">
      <div class="time-block">
        <span class="time-prefix">LOCAL</span>
        <span class="time-digits" id="time-digits">--:--:--</span>
        <span class="time-period" id="time-period">--</span>
      </div>

      <!-- THEME TOGGLE ICON (COMPACT, MINIMAL, NO TEXT) -->
      <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle visual theme">
        <!-- Sun icon (for dark mode: click to switch to light) -->
        <svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (for light mode: click to switch to dark) -->
        <svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </header>

  <!-- ============================================================
       SECTION 01 — HERO (PERMANENTLY DARK IN BOTH THEMES)
       ============================================================ -->
  <section id="hero-section">

    <!-- 291-FRAME HIGH-RESOLUTION CANVAS SEQUENCE LAYER -->
    <canvas id="canvas"></canvas>
    
    <div class="left-stage-backdrop"></div>

    <!-- SCROLL DOWN TUTORIAL (UPPER RIGHT OF HERO) -->
    <div class="scroll-down-widget" id="scroll-widget">
      <div class="sd-visual">
        <div class="sd-mouse-icon">
          <div class="sd-wheel-dot"></div>
        </div>
        <svg class="sd-arrow-icon" width="9" height="11" viewBox="0 0 9 11" fill="none">
          <path d="M4.5 1V9.5M4.5 9.5L1.5 6.5M4.5 9.5L7.5 6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="sd-label-wrap">
        <span class="sd-label">SCROLL DOWN</span>
        <span class="sd-sub">EXPLORE ARCHIVE</span>
      </div>
    </div>

    <!-- HERO LEFT IDENTITY STAGE -->
    <div class="hero-left-stage" id="hero-left-stage">

      <!-- MAIN HERO NAME: DENSE FERROFLUID PARTICLE TYPOGRAPHY -->
      <div class="hero-name-wrap" id="hero-name-wrap" tabindex="0" aria-label="Chithambaram Bala Krishnan">
        <h1 class="sr-only">CHITHAMBARAM BALA KRISHNAN</h1>
        <canvas id="name-particle-canvas"></canvas>
      </div>

      <!-- QUOTE: TURNING IDEAS INTO VISUALS -->
      <div class="hero-quote-wrap" id="hero-quote-wrap">
        <div class="quote-mask-track">
          <span class="quote-bracket" id="q-bracket">//</span>
          <div class="quote-text-reveal" id="quote-text">Turning Ideas into Visuals</div>
        </div>
        <div class="quote-guide-bar" id="q-bar"></div>
      </div>

      <!-- ABOUT ME: CURLED PAPER STICKY NOTE WITH ISOMETRIC FOREGROUND PIN -->
      <div class="sticky-note" id="hero-sticky-note">
        <div class="isometric-push-pin" id="isometric-push-pin" aria-hidden="true">
          <svg width="36" height="44" viewBox="0 0 36 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="office-needle" x1="19" y1="21" x2="8" y2="38" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#E2E4E8"/>
                <stop offset="40%" stop-color="#A2A7B0"/>
                <stop offset="70%" stop-color="#CBD0D8"/>
                <stop offset="100%" stop-color="#4B4E54"/>
              </linearGradient>
              <radialGradient id="office-pin-cap" cx="35%" cy="30%" r="70%">
                <stop offset="0%" stop-color="#FF6B72"/>
                <stop offset="35%" stop-color="#E51E28"/>
                <stop offset="75%" stop-color="#A80D15"/>
                <stop offset="100%" stop-color="#5E050A"/>
              </radialGradient>
              <linearGradient id="office-pin-neck" x1="14" y1="16" x2="26" y2="25" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#FF4D55"/>
                <stop offset="50%" stop-color="#C4131B"/>
                <stop offset="100%" stop-color="#6A050B"/>
              </linearGradient>
            </defs>
            <!-- Paper pierce puncture slit & contact shadow -->
            <ellipse cx="8" cy="38" rx="6.5" ry="3.0" fill="rgba(0,0,0,0.38)"/>
            <path d="M6 38.5 L10 37.5" stroke="#7A6618" stroke-width="1.3" stroke-linecap="round"/>
            <!-- Pointed metal needle piercing paper -->
            <path d="M19 21 L8 38" stroke="url(#office-needle)" stroke-width="2.4" stroke-linecap="round"/>
            <path d="M18.5 20.5 L8.5 37.2" stroke="rgba(255,255,255,0.75)" stroke-width="0.8" stroke-linecap="round"/>
            <!-- Wide lower rim collar sitting directly against paper -->
            <ellipse cx="19" cy="21" rx="6.8" ry="3.6" transform="rotate(-20 19 21)" fill="url(#office-pin-neck)"/>
            <!-- Contoured hourglass grip waist -->
            <path d="M15 17 C16 13, 20 10, 24 13 L26 18 C22 22, 17 21, 15 17 Z" fill="url(#office-pin-neck)"/>
            <!-- Classic rounded plastic dome head -->
