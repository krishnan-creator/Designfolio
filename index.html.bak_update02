  <!-- ============================================================
       04. JAVASCRIPT ENGINE: HIGH-PERFORMANCE 60FPS SYSTEM
       ============================================================ -->
  <script>
    (() => {
      "use strict";

      // ============================================================
      // 1. THEME CONTROLLER — CIRCULAR REVEAL FROM THEME ICON ORIGIN
      // ============================================================
      const themeToggleBtn = document.getElementById('theme-toggle');
      const circleCurtain = document.getElementById('theme-circle-curtain');
      let currentTheme = localStorage.getItem('dbl-theme') || 'dark';

      function applyTheme(theme) {
        currentTheme = theme;
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'light') {
          document.body.classList.add('light-theme');
          document.body.classList.remove('dark-theme');
        } else {
          document.body.classList.remove('light-theme');
          document.body.classList.add('dark-theme');
        }
        localStorage.setItem('dbl-theme', theme);
      }
      applyTheme(currentTheme);

      let isThemeTransitioning = false;

      const themeGlossRing = document.getElementById('hero-theme-gloss-ring');

      function triggerCircularThemeSwitch() {
        if (isThemeTransitioning) return;
        isThemeTransitioning = true;

        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

        // Calculate origin from the theme toggle button's actual center position in the viewport
        let cx = window.innerWidth - 48;
        let cy = 36;
        if (themeToggleBtn) {
          const rect = themeToggleBtn.getBoundingClientRect();
          cx = rect.left + rect.width * 0.5;
          cy = rect.top + rect.height * 0.5;
        }

        const maxDistX = Math.max(cx, window.innerWidth - cx);
        const maxDistY = Math.max(cy, window.innerHeight - cy);
        const targetRadius = Math.ceil(Math.hypot(maxDistX, maxDistY));

        // Check if user is currently inside Hero section
        const heroEl = document.getElementById('hero-section');
        const scrollY = window.scrollY || window.pageYOffset;
        const heroH = heroEl ? heroEl.offsetHeight : window.innerHeight;
        const isUserInHero = scrollY < heroH * 0.85;

        if (isUserInHero) {
          // HERO: Thin glossy transparent glass-like expanding circular ring
          applyTheme(nextTheme);
          if (window.triggerHeroNameWave) {
            window.triggerHeroNameWave(cx, cy);
          }

          if (themeGlossRing) {
            themeGlossRing.className = nextTheme === 'light' ? 'theme-ring-light' : 'theme-ring-dark';
            themeGlossRing.style.left = `${cx}px`;
            themeGlossRing.style.top = `${cy}px`;
            themeGlossRing.style.width = '0px';
            themeGlossRing.style.height = '0px';
            themeGlossRing.style.display = 'block';
            themeGlossRing.style.opacity = '1';

            const anim = themeGlossRing.animate([
              { width: '0px', height: '0px', opacity: 1, borderWidth: '2.5px' },
              { width: `${targetRadius * 2.2}px`, height: `${targetRadius * 2.2}px`, opacity: 0, borderWidth: '1px' }
            ], {
              duration: 650,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
              fill: 'forwards'
            });

            anim.onfinish = () => {
              themeGlossRing.style.display = 'none';
              themeGlossRing.style.opacity = '0';
              isThemeTransitioning = false;
            };
          } else {
            isThemeTransitioning = false;
          }
        } else {
          // POST-HERO: Normal Visuvate-inspired circular reveal curtain
          if (document.startViewTransition) {
            const transition = document.startViewTransition(() => {
              applyTheme(nextTheme);
            });
            transition.ready.then(() => {
              const anim = document.documentElement.animate(
                {
                  clipPath: [
                    `circle(0px at ${cx}px ${cy}px)`,
                    `circle(${targetRadius}px at ${cx}px ${cy}px)`
                  ]
                },
                {
                  duration: 680,
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                  pseudoElement: '::view-transition-new(root)'
                }
              );
              anim.onfinish = () => { isThemeTransitioning = false; };
            }).catch(() => {
              applyTheme(nextTheme);
              isThemeTransitioning = false;
            });
          } else if (circleCurtain) {
            circleCurtain.style.backgroundColor = nextTheme === 'light' ? '#F4F2EE' : '#0B0B0D';
            circleCurtain.style.display = 'block';
            circleCurtain.style.clipPath = `circle(0px at ${cx}px ${cy}px)`;
            circleCurtain.style.opacity = '1';

            const anim = circleCurtain.animate([
              { clipPath: `circle(0px at ${cx}px ${cy}px)` },
              { clipPath: `circle(${targetRadius}px at ${cx}px ${cy}px)` }
            ], {
              duration: 680,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards'
            });

            anim.onfinish = () => {
              applyTheme(nextTheme);
              circleCurtain.style.opacity = '0';
              setTimeout(() => {
                circleCurtain.style.display = 'none';
                isThemeTransitioning = false;
              }, 50);
            };
          } else {
            applyTheme(nextTheme);
            isThemeTransitioning = false;
          }
        }
      }

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', triggerCircularThemeSwitch);
      }

      // ============================================================
      // 2. LIVE TIME DISPLAY (DEVICE TIMEZONE)
      // ============================================================
      function updateLiveTime() {
        try {
          const now = new Date();
          const userTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
          const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: userTimeZone,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
          });
          const parts = formatter.formatToParts(now);
          let h = '00', m = '00', s = '00', dayPeriod = 'AM';
          for (const p of parts) {
            if (p.type === 'hour') h = p.value;
            if (p.type === 'minute') m = p.value;
            if (p.type === 'second') s = p.value;
            if (p.type === 'dayPeriod') dayPeriod = p.value.toUpperCase();
          }
          const digitsEl = document.getElementById('time-digits');
          const periodEl = document.getElementById('time-period');
          if (digitsEl) digitsEl.textContent = `${h}:${m}:${s}`;
          if (periodEl) periodEl.textContent = dayPeriod;
        } catch(e) {}
      }
      setInterval(updateLiveTime, 1000);
      updateLiveTime();

      // ============================================================
      // 3. EMOTION-INSPIRED LIVING FLUID ENVIRONMENTAL FIELD (STRICTLY POST-HERO)
      //     - Real continuous fluid displacement field (ZERO PARTICLES)
      //     - Multi-layer: Low-frequency broad flow + secondary organic flow + atmospheric drift
      //     - Localized mouse-force wake & physical deformation strictly behind post-hero sections
      //     - Smooth relaxation on mouse stop; dissipation on mouse leave
      //     - Continuous organic motion even when mouse is completely still
      //     - Absolutely clean/hidden inside Hero (opacity = 0 while viewing Hero)
      // ============================================================
      // ============================================================
      // 3. REACT BITS DUAL-MODE POST-HERO BACKGROUND:
      //    - Dark Theme: GLITTER WARP (radial starfield warp tunnel, lavender-violet streaks #B19EEF)
      //    - Light Theme: LANDSCAPE (raymarched terrain: bright sky, hazy ridges, dark foreground, magenta ribbon #E93CF8)
      //    - Strictly behind post-hero sections (clean/hidden in Hero)
      //    - Smooth theme transitions, continuous motion, zero mouse-driven deformation
      // ============================================================
      // Replaced with React Bits SplashCursor & LaserFlow


      // ============================================================
      // 4. HEADER BRANDING — GLYPH LOTTERY (REACT BITS PRO)
      //    - DESIGNFOLIO remains one word with zero layout jump
      //    - Initial subtle spin, then repeats at restrained 14s interval
      // ============================================================
      const dfContainer = document.getElementById('brand-df');
      const dfChars = dfContainer ? dfContainer.querySelectorAll('.df-char') : [];
      const GLYPH_CHARSET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_-';

      function runGlyphLotteryOnChars(charsList, duration = 480) {
        if (!charsList || !charsList.length) return;
        const startTime = performance.now();
        const targets = Array.from(charsList).map(c => c.getAttribute('data-orig') || c.textContent.trim());

        const spinInterval = setInterval(() => {
          const elapsed = performance.now() - startTime;
          const progress = Math.min(1, elapsed / duration);

          for (let i = 0; i < charsList.length; i++) {
            const charEl = charsList[i];
            const targetChar = targets[i];
            const charSettlePoint = (i + 1) / (charsList.length + 1);

            if (progress >= charSettlePoint) {
              charEl.textContent = targetChar;
              charEl.classList.remove('is-rolling');
            } else {
              charEl.classList.add('is-rolling');
              const randIdx = Math.floor(Math.random() * GLYPH_CHARSET.length);
              charEl.textContent = GLYPH_CHARSET[randIdx];
            }
          }

          if (progress >= 1) {
            clearInterval(spinInterval);
            for (let i = 0; i < charsList.length; i++) {
              charsList[i].textContent = targets[i];
              charsList[i].classList.remove('is-rolling');
            }
          }
        }, 30);
      }
      window.runGlyphLotteryOnChars = runGlyphLotteryOnChars;
      // Initial roll after header settles
      setTimeout(() => {
        runGlyphLotteryOnChars(dfChars, 480);
      }, 900);

      // Restrained periodic repeat every 14 seconds (clean, subtle branding detail)
      setInterval(() => {
        runGlyphLotteryOnChars(dfChars, 500);
      }, 14000);

      // ============================================================
      // 5. HIGH-PRECISION TIME-BASED EXR ENGINE & IDLE WAKE ARCHITECTURE
      //    - Target FPS: 28 FPS (~35.7ms/frame) based on elapsed time
      //    - Time accumulator prevents timer drift or stutter
      //    - Initial entry: 001 -> 042 smooth normal speed, zero slowdown/holds
      //    - Idle loop: Strictly 42 <-> 40 (42 -> 41 -> 40 -> 41 -> 42)
      //    - Mouse wake: Resumes forward immediately from active frame
      //    - Continuous seamless forward loop through frame 291 -> 001
      // ============================================================
      const canvas = document.getElementById('canvas');
      const ctx = canvas ? canvas.getContext('2d') : null;
      const TOTAL_FRAMES = 291;
      const frameCache = new Map();
      let currentFrameNumber = 1;
      let lastRenderedImg = null;

      // Playback States: 'startup_hold_01' | 'initial_entry' | 'hold_39' | 'forward_continuous'
      let exrPlaybackState = 'startup_hold_01';

      const TARGET_FPS = 28;
      const FRAME_DURATION = 1000 / TARGET_FPS; // ~35.71ms
      let lastTimestamp = performance.now();
      let timeAccumulator = 0;

      function getFramePath(frameNum) {
        return `frames/frame_${String(frameNum).padStart(5, '0')}.jpg`;
      }

      function loadSingleFrame(frameNum) {
        if (frameCache.has(frameNum)) {
          return Promise.resolve(frameCache.get(frameNum));
        }
        return new Promise((resolve) => {
          const img = new Image();
          img.src = getFramePath(frameNum);
          img.onload = () => {
            frameCache.set(frameNum, img);
            if (img.decode) {
              img.decode().then(() => resolve(img)).catch(() => resolve(img));
            } else {
              resolve(img);
            }
          };
          img.onerror = () => resolve(null);
        });
      }

      function resizeHeroCanvas() {
        if (!canvas) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(window.innerWidth * dpr);
        canvas.height = Math.round(window.innerHeight * dpr);
        if (ctx) {
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
        }
        drawFrameByNumber(currentFrameNumber);
      }
      resizeHeroCanvas();
      window.addEventListener('resize', resizeHeroCanvas, { passive: true });

      function drawFrameByNumber(frameNum) {
        if (!ctx || !canvas) return;
        const img = frameCache.get(frameNum) || lastRenderedImg;
        if (!img) {
          loadSingleFrame(frameNum).then((loaded) => {
            if (loaded && currentFrameNumber === frameNum) {
              lastRenderedImg = loaded;
              drawFrameByNumber(frameNum);
            }
          });
          return;
        }

        lastRenderedImg = img;
        const w = window.innerWidth;
        const h = window.innerHeight;
        ctx.clearRect(0, 0, w, h);

        const imgRatio = img.naturalWidth / img.naturalHeight;
        const screenRatio = w / h;
        let dw, dh, dx, dy;

        if (screenRatio > imgRatio) {
          dw = w;
          dh = w / imgRatio;
          dx = 0;
          dy = (h - dh) * 0.5;
        } else {
          dh = h;
          dw = h * imgRatio;
          dx = (w - dw) * 0.5;
          dy = 0;
        }

        ctx.drawImage(img, dx, dy, dw, dh);
      }

      let exrAudioCtx = null;
      let hasCrossedSnapThresholdThisLoop = false;

      function playExrLoopSnapSound() {
        try {
          if (!exrAudioCtx) {
            const AC = window.AudioContext || window.webkitAudioContext;
            if (AC) exrAudioCtx = new AC();
          }
          if (!exrAudioCtx) return;
          if (exrAudioCtx.state === 'suspended') {
            exrAudioCtx.resume().catch(() => {});
          }
          const t = exrAudioCtx.currentTime;
          const osc = exrAudioCtx.createOscillator();
          const gain = exrAudioCtx.createGain();
          const filter = exrAudioCtx.createBiquadFilter();

          // Dry, tactile mechanical snap click (short, subtle, cinematic)
          filter.type = 'highpass';
          filter.frequency.setValueAtTime(1400, t);

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(320, t);
          osc.frequency.exponentialRampToValueAtTime(70, t + 0.022);

          gain.gain.setValueAtTime(0.18, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.020);

          osc.connect(filter);
          filter.connect(gain);
          gain.connect(exrAudioCtx.destination);

          osc.start(t);
          osc.stop(t + 0.025);
        } catch(e) {}
      }

      function advanceExrStep() {
        const prevFrame = currentFrameNumber;
        if (exrPlaybackState === 'startup_hold_01') {
          // EXR strictly held at IMG_00001 during 0.3s CBK title + 0.2s full-screen glitch
          currentFrameNumber = 1;
          return;
        } else if (exrPlaybackState === 'initial_entry') {
          // Once 0.5s startup glitch finishes: release EXR, play 01 -> 02 -> ... -> 39 smoothly
          currentFrameNumber++;
          if (currentFrameNumber >= 39) {
            currentFrameNumber = 39;
            exrPlaybackState = 'hold_39'; // FREEZE EXACTLY AT FRAME 39
          }
        } else if (exrPlaybackState === 'hold_39') {
          // Visually held and frozen at frame 39 until user action occurs (no loop, no oscillation, no bounce)
          return;
        } else if (exrPlaybackState === 'forward_continuous') {
          // Resumed forward from frame 39 on user movement: 39 -> 40 -> 41 -> 42 ... 291 -> 1 ...
          currentFrameNumber++;
          if (currentFrameNumber > TOTAL_FRAMES) {
            currentFrameNumber = 1;
            hasCrossedSnapThresholdThisLoop = false;
          }

          // Stateful threshold crossing 102 -> 103: ONE SNAP per loop crossing
          if (prevFrame <= 102 && currentFrameNumber >= 103 && !hasCrossedSnapThresholdThisLoop) {
            hasCrossedSnapThresholdThisLoop = true;
            playExrLoopSnapSound();
          }
          if (currentFrameNumber < 90) {
            hasCrossedSnapThresholdThisLoop = false;
          }
        }
      }

      function runHeroPlayback(now) {
        const delta = Math.min(now - lastTimestamp, 120);
        lastTimestamp = now;
        timeAccumulator += delta;

        let advanced = false;
        while (timeAccumulator >= FRAME_DURATION) {
          advanceExrStep();
          timeAccumulator -= FRAME_DURATION;
          advanced = true;
        }

        if (advanced) {
          drawFrameByNumber(currentFrameNumber);

          // Rolling frame preloader buffer ahead
          for (let offset = 1; offset <= 12; offset++) {
            let nextNum = currentFrameNumber + offset;
            if (nextNum > TOTAL_FRAMES) nextNum -= TOTAL_FRAMES;
            if (!frameCache.has(nextNum)) loadSingleFrame(nextNum);
          }
          for (let offset = 1; offset <= 4; offset++) {
            let prevNum = currentFrameNumber - offset;
            if (prevNum < 1) prevNum += TOTAL_FRAMES;
            if (!frameCache.has(prevNum)) loadSingleFrame(prevNum);
          }
        }

        requestAnimationFrame(runHeroPlayback);
      }

      function handleHeroExrWakeOnMouse() {
        if (exrPlaybackState === 'hold_39') {
          // Resumes forward from frame 39 on intentional user interaction
          exrPlaybackState = 'forward_continuous';
        }
      }

      window.releaseHeroExrPlayback = function() {
        if (exrPlaybackState === 'startup_hold_01') {
          exrPlaybackState = 'initial_entry';
        }
      };

      window.addEventListener('mousemove', handleHeroExrWakeOnMouse, { passive: true });
      window.addEventListener('touchstart', handleHeroExrWakeOnMouse, { passive: true });
      window.addEventListener('scroll', handleHeroExrWakeOnMouse, { passive: true });

      async function initializeHeroFrames() {
        await loadSingleFrame(1);
        drawFrameByNumber(1);

        for (let i = 1; i <= 45; i++) {
          loadSingleFrame(i);
        }
        for (let i = 280; i <= 291; i++) {
          loadSingleFrame(i);
        }

        lastTimestamp = performance.now();
        timeAccumulator = 0;
        requestAnimationFrame(runHeroPlayback);

        let streamIdx = 46;
        function streamNextBatch() {
          if (streamIdx >= 280) return;
          loadSingleFrame(streamIdx).then(() => {
            streamIdx++;
            setTimeout(streamNextBatch, 12);
          });
        }
        streamNextBatch();
      }
      initializeHeroFrames();

      // ============================================================
      // 6. HERO NAME: DENSE FERROFLUID PARTICLES WITH GLITCH FORMATION
      //    (ZERO SOLID IMPACT, 20,000+ PARTICLES, NO RED DOTS)
      // ============================================================
      const nameWrap = document.getElementById('hero-name-wrap');
      const pCanvas = document.getElementById('name-particle-canvas');
      const pCtx = pCanvas ? pCanvas.getContext('2d') : null;

      let nameParticles = [];
      let isMouseOverName = false;
      let nameMouseX = -10000;
      let nameMouseY = -10000;
      let nameCanvasWidth = 0;
      let nameCanvasHeight = 0;
      let particleEngineInitialized = false;
      let nameFormationProgress = 0; // 0 to 1
      let quoteRevealed = false;
      let prevNameMouseX = -10000;
      let prevNameMouseY = -10000;
      let nameMouseVx = 0;
      let nameMouseVy = 0;

      const LINE1_TEXT = "CHITHAMBARAM";
      const LINE2_TEXT = "BALA KRISHNAN";

      
      let themeWaveActive = false;
      let themeWaveStartTime = 0;
      let themeWaveOriginX = 0;
      let themeWaveOriginY = 0;

      window.triggerHeroNameWave = function(originX, originY) {
        themeWaveActive = true;
        themeWaveStartTime = performance.now();
        themeWaveOriginX = originX || (window.innerWidth - 48);
        themeWaveOriginY = originY || 36;
      };
function initDenseParticleTypography() {
        if (!pCanvas || !pCtx || !nameWrap) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = nameWrap.getBoundingClientRect();
        nameCanvasWidth = Math.round(Math.max(rect.width || 780, 720));

        // 1. Measure and calculate glyph dimensions first using temporary probe canvas
        const probe = document.createElement('canvas');
        const probeCtx = probe.getContext('2d');

        // Generous bounds ensuring first 'C' and final 'N' never clip, scaled up slightly for maximum presence
        let availableW = Math.min(nameCanvasWidth - 16, 700);
        let fs1 = Math.round(Math.min(availableW * 0.154, 88));
        let fs2 = Math.round(Math.min(availableW * 0.208, 118));

        const fontSpec1 = `900 ${fs1}px 'Barlow Condensed', 'Gondens', 'Bebas Neue', Impact, sans-serif`;
        const fontSpec2 = `900 ${fs2}px 'Barlow Condensed', 'Gondens', 'Bebas Neue', Impact, sans-serif`;

        probeCtx.font = fontSpec1;
        let w1 = probeCtx.measureText(LINE1_TEXT).width;
        if (w1 > availableW) {
          fs1 = Math.floor(fs1 * (availableW / w1) * 0.98);
        }

        probeCtx.font = fontSpec2;
        let w2 = probeCtx.measureText(LINE2_TEXT).width;
        if (w2 > availableW) {
          fs2 = Math.floor(fs2 * (availableW / w2) * 0.98);
        }

        probeCtx.font = `900 ${fs1}px 'Barlow Condensed', 'Gondens', 'Bebas Neue', Impact, sans-serif`;
        w1 = probeCtx.measureText(LINE1_TEXT).width;
        probeCtx.font = `900 ${fs2}px 'Barlow Condensed', 'Gondens', 'Bebas Neue', Impact, sans-serif`;
        w2 = probeCtx.measureText(LINE2_TEXT).width;

        // Strict left alignment: start at 2px so stroke doesn't touch canvas boundary
        // Unifies vertical left alignment axis with Quote and Sticky Note
        const paddingX = 2;
        const totalHeight = Math.round(fs1 + fs2 + 26);
        nameCanvasHeight = totalHeight;
        nameWrap.style.minHeight = `${nameCanvasHeight}px`;

        pCanvas.width = Math.round(nameCanvasWidth * dpr);
        pCanvas.height = Math.round(nameCanvasHeight * dpr);
        pCanvas.style.width = `${nameCanvasWidth}px`;
        pCanvas.style.height = `${nameCanvasHeight}px`;
        pCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // 2. Offscreen canvas initialized ONCE with exact final height (prevents context reset bug)
        const off = document.createElement('canvas');
        off.width = Math.round(nameCanvasWidth * dpr);
        off.height = Math.round(nameCanvasHeight * dpr);
        const offCtx = off.getContext('2d');
        offCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        offCtx.clearRect(0, 0, nameCanvasWidth, nameCanvasHeight);

        offCtx.fillStyle = '#ffffff';
        offCtx.textBaseline = 'top';

        // Draw bold condensed display glyphs with pristine open counters and clear letter boundaries
        offCtx.font = `900 ${fs1}px 'Barlow Condensed', 'Gondens', 'Bebas Neue', Impact, sans-serif`;
        const l1Y = 2;
        offCtx.fillText(LINE1_TEXT, paddingX, l1Y);

        offCtx.font = `900 ${fs2}px 'Barlow Condensed', 'Gondens', 'Bebas Neue', Impact, sans-serif`;
        const l2Y = fs1 + 6;
        offCtx.fillText(LINE2_TEXT, paddingX, l2Y);

        const imgData = offCtx.getImageData(0, 0, off.width, off.height).data;
        nameParticles = [];

        // Return to tightly packed particle field: visually solid, bold Impact-like silhouette
        const isMobile = window.innerWidth <= 768;
        const isTablet = window.innerWidth > 768 && window.innerWidth <= 1024;
        const sampleStep = isMobile ? 1.30 : (isTablet ? 1.20 : 1.15);
        const pSize = isMobile ? 1.40 : (isTablet ? 1.30 : 1.25);

        for (let y = 0; y < nameCanvasHeight; y += sampleStep) {
          for (let x = 0; x < nameCanvasWidth; x += sampleStep) {
            const pxX = Math.round(x * dpr);
            const pxY = Math.round(y * dpr);
            const idx = (pxY * off.width + pxX) * 4;

            // Sample only pixels INSIDE the glyph mask (low threshold preserves every terminal and edge)
            if (idx < imgData.length && imgData[idx + 3] > 20) {
              nameParticles.push({
                originX: x,
                originY: y,
                homeX: x,
                homeY: y,
                x: x,
                y: y,
                vx: 0,
                vy: 0,
                size: pSize,
                dispersion: 0.65 + Math.random() * 0.70,
                color: '#FFFFFF' // PURE WHITE ONLY (Section 4.2)
              });
            }
          }
        }

        particleEngineInitialized = true;
        window.nameParticles = nameParticles;
      }

      function animateFormationStep() {
        if (nameFormationProgress < 1) {
          nameFormationProgress += 0.024;
          if (nameFormationProgress >= 1) {
            nameFormationProgress = 1;
          }
        }
      }

      function renderDenseFerrofluid() {
        if (!particleEngineInitialized || !pCtx) {
          requestAnimationFrame(renderDenseFerrofluid);
          return;
        }

        animateFormationStep();
        pCtx.clearRect(0, 0, nameCanvasWidth, nameCanvasHeight);

        // Smooth name mouse velocity with damping
        nameMouseVx *= 0.86;
        nameMouseVy *= 0.86;
        const mouseSpeed = Math.hypot(nameMouseVx, nameMouseVy);

        // Broad, smooth circular repulsion field (~215 CSS px desktop, per Requirement 1)
        const REPULSION_RADIUS = Math.min(225.0, Math.max(185.0, nameCanvasWidth * 0.30));
        // Mouse velocity influences local flow strength, clamped for stability
        const speedBoost = 1.0 + Math.min(mouseSpeed * 0.038, 0.45);
        const SPRING_K = nameFormationProgress < 1 ? 0.086 : 0.078;
        // Allows particles to clear circular black-hole void while forming dense compressed halo rim
        const MAX_DISPLACEMENT = 96.0;

        
        if (themeWaveActive) {
          const elapsed = performance.now() - themeWaveStartTime;
          const WAVE_DURATION = 1350;
          const progress = elapsed / WAVE_DURATION;

          if (progress >= 1.0) {
            themeWaveActive = false;
          } else {
            const rect = nameWrap.getBoundingClientRect();
            const localOx = themeWaveOriginX - rect.left;
            const localOy = themeWaveOriginY - rect.top;
            const maxDist = Math.hypot(nameCanvasWidth, nameCanvasHeight) * 1.6;
            const waveRadius = progress * maxDist;
            const waveWidth = 140.0;
            const waveAmp = (1.0 - progress) * 32.0;

            for (let i = 0; i < nameParticles.length; i++) {
              const p = nameParticles[i];
              const dx = p.homeX - localOx;
              const dy = p.homeY - localOy;
              const dist = Math.hypot(dx, dy);
              const diff = Math.abs(dist - waveRadius);

              if (diff < waveWidth) {
                const factor = Math.sin((1.0 - diff / waveWidth) * Math.PI);
                const force = factor * waveAmp;
                const angle = Math.atan2(dy, dx);
                p.vx += Math.cos(angle) * force * 0.45;
                p.vy += Math.sin(angle) * force * 0.45 + Math.sin(p.homeX * 0.04 + progress * 14.0) * force * 0.55;
              }
            }
          }
        }
for (let i = 0; i < nameParticles.length; i++) {
          const p = nameParticles[i];

          // Broad circular ferrofluid halo: particles flow smoothly away from pointer
          if (isMouseOverName && nameFormationProgress >= 0.85) {
            const dx = p.x - nameMouseX;
            const dy = p.y - nameMouseY;
            const dist = Math.hypot(dx, dy);

            if (dist < REPULSION_RADIUS && dist > 0.01) {
              const norm = dist / REPULSION_RADIUS; // 0 at pointer to 1 at outer boundary
              // Smooth soft radial falloff creating the clear void and halo
              const falloff = Math.pow(Math.max(0, 1.0 - norm), 1.32);
              const force = falloff * 4.2 * speedBoost;

              // 1. Broad smooth radial outward push
              p.vx += (dx / dist) * force;
              p.vy += (dy / dist) * force;

              // 2. Halo vortex flow: particles flow around the moving circular center
              const swirl = Math.sin(norm * Math.PI) * 0.75 * speedBoost;
              p.vx += (-dy / dist) * swirl;
              p.vy += (dx / dist) * swirl;

              // 3. Fluid momentum from pointer velocity
              p.vx += nameMouseVx * falloff * 0.12;
              p.vy += nameMouseVy * falloff * 0.12;
            }
          }

          // Hooke's Law Spring attraction back to exact home coordinates
          const homeDx = p.homeX - p.x;
          const homeDy = p.homeY - p.y;
          const distToHome = Math.hypot(homeDx, homeDy);

          p.vx += homeDx * SPRING_K;
          p.vy += homeDy * SPRING_K;

          // Natural return with velocity damping and zero jitter
          let damping = isMouseOverName ? 0.85 : (distToHome < 4.0 ? 0.70 : 0.82);

          if (distToHome < 0.35 && !isMouseOverName && Math.hypot(p.vx, p.vy) < 0.12) {
            // Exact glyph reconstruction
            p.x = p.homeX;
            p.y = p.homeY;
            p.vx = 0;
            p.vy = 0;
          } else {
            p.vx *= damping;
            p.vy *= damping;
            p.x += p.vx;
            p.y += p.vy;

            // Enforce maximum displacement ceiling to preserve outer letter silhouette
            const curDist = Math.hypot(p.x - p.homeX, p.y - p.homeY);
            if (curDist > MAX_DISPLACEMENT) {
              const ratio = MAX_DISPLACEMENT / curDist;
              p.x = p.homeX + (p.x - p.homeX) * ratio;
              p.y = p.homeY + (p.y - p.homeY) * ratio;
              p.vx *= 0.55;
              p.vy *= 0.55;
            }
          }

          pCtx.fillStyle = '#FFFFFF';
          pCtx.fillRect(p.x, p.y, p.size, p.size);
        }

        requestAnimationFrame(renderDenseFerrofluid);
      }

      if (nameWrap) {
        nameWrap.addEventListener('mouseenter', (e) => {
          isMouseOverName = true;
          const rect = nameWrap.getBoundingClientRect();
          nameMouseX = e.clientX - rect.left;
          nameMouseY = e.clientY - rect.top;
          prevNameMouseX = nameMouseX;
          prevNameMouseY = nameMouseY;
        });

        nameWrap.addEventListener('mousemove', (e) => {
          isMouseOverName = true;
          const rect = nameWrap.getBoundingClientRect();
          const currentX = e.clientX - rect.left;
          const currentY = e.clientY - rect.top;
          nameMouseVx = currentX - prevNameMouseX;
          nameMouseVy = currentY - prevNameMouseY;
          prevNameMouseX = currentX;
          prevNameMouseY = currentY;
          nameMouseX = currentX;
          nameMouseY = currentY;
        });

        nameWrap.addEventListener('mouseleave', () => {
          isMouseOverName = false;
          nameMouseX = -10000;
          nameMouseY = -10000;
          prevNameMouseX = -10000;
          prevNameMouseY = -10000;
          nameMouseVx = 0;
          nameMouseVy = 0;
        });
      }

      document.fonts.ready.then(() => {
        initDenseParticleTypography();
        requestAnimationFrame(renderDenseFerrofluid);
      });

      window.addEventListener('resize', () => {
        if (document.fonts.status === 'loaded') {
          initDenseParticleTypography();
        }
      }, { passive: true });

      // ============================================================
      // 7. PINNED YELLOW STICKY NOTE & TACTILE TYPEWRITER
      // ============================================================
      let audioCtx = null;
      function playTypewriterTick() {
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(760 + Math.random() * 200, audioCtx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(110, audioCtx.currentTime + 0.012);
          gain.gain.setValueAtTime(0.014, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.012);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.014);
        } catch(e) {}
      }

      // Line-by-line reveal of the 5 authored display lines (~130ms cadence)
      function revealStickyLines() {
        const lineEls = document.querySelectorAll('#sticky-body-lines .sticky-display-line');
        lineEls.forEach((lineEl, idx) => {
          setTimeout(() => {
            lineEl.classList.add('is-revealed');
            playTypewriterTick();
          }, idx * 130);
        });
      }

      // ============================================================
      // 8. SITE ENTRY SEQUENCE: EXACT 0.7S CYBERPUNK EDITORIAL GLITCH
      //    "CBK DESIGNFOLIO" signals, glitches, and decisively exits into Hero (~700ms)
      //    Followed by second dimensional glitch transition (~0.9s later)
      // ============================================================
      const centerSplash = document.getElementById('center-splash');
      const multiverseGlitch = document.getElementById('multiverse-glitch-layer');
      const contactLinks = document.getElementById('contact-links');
      const scrollWidget = document.getElementById('scroll-widget');
      const tickerWrap = document.getElementById('hero-ticker');
      const heroStickyNote = document.getElementById('hero-sticky-note');

      let stickyNoteRevealed = false;

      // Physical hover tilt: subtle 2-3 degree perspective response with gentle return
      if (heroStickyNote) {
        heroStickyNote.addEventListener('mousemove', (e) => {
          if (!stickyNoteRevealed) return;
          const rect = heroStickyNote.getBoundingClientRect();
          const cx = rect.left + rect.width * 0.5;
          const cy = rect.top + rect.height * 0.5;
          const normX = Math.max(-1, Math.min(1, (e.clientX - cx) / (rect.width * 0.5)));
          const normY = Math.max(-1, Math.min(1, (e.clientY - cy) / (rect.height * 0.5)));
          const rotX = (-normY * 2.2).toFixed(2);
          const rotY = (normX * 2.2).toFixed(2);
          heroStickyNote.style.transform = `perspective(700px) rotateX(${rotX}deg) rotateY(${rotY}deg) scale(1.008)`;
        });
        heroStickyNote.addEventListener('mouseleave', () => {
          if (!stickyNoteRevealed) return;
          heroStickyNote.style.transform = 'perspective(700px) rotateX(0deg) rotateY(0deg) scale(1)';
        });
      }

      function triggerStickyNoteOnAction() {
        if (stickyNoteRevealed) return;
        if (!heroStickyNote) return;
        stickyNoteRevealed = true;

        // Physical curled paper emergence: unfold/slide, pin settles, opacity -> 1
        heroStickyNote.classList.add('is-revealed');

        // Line-by-line reveal of the 5 authored lines after paper & pin settle (~320ms)
        setTimeout(revealStickyLines, 320);
      }

      // One-time user action listener in Hero triggers sticky note reveal & wakes EXR
      function onHeroUserAction(e) {
        const heroEl = document.getElementById('hero-section');
        const scrollY = window.scrollY || window.pageYOffset;
        const heroH = heroEl ? heroEl.offsetHeight : window.innerHeight;

        if (scrollY < heroH) {
          handleHeroExrWakeOnMouse();
          if (!stickyNoteRevealed) {
            triggerStickyNoteOnAction();
          }
        }
      }

      window.addEventListener('mousemove', onHeroUserAction, { passive: true });
      window.addEventListener('touchstart', onHeroUserAction, { passive: true });
      window.addEventListener('click', onHeroUserAction, { passive: true });
      window.addEventListener('scroll', onHeroUserAction, { passive: true });

      // Quote Reveal controller
      function triggerQuoteReveal() {
        if (quoteRevealed) return;
        quoteRevealed = true;
        const qBracket = document.getElementById('q-bracket');
        const qText = document.getElementById('quote-text');
        const qBar = document.getElementById('q-bar');
        if (qBracket) qBracket.classList.add('is-revealed');
        if (qText) {
          const phrase = "Turning Ideas into Visuals";
          qText.innerHTML = phrase.split('').map((ch, i) => 
            `<span class="q-char" style="--q-idx: ${i}">${ch === ' ' ? '&nbsp;' : ch}</span>`
          ).join('');
          qText.classList.add('is-revealed');
        }
        if (qBar) qBar.classList.add('is-expanded');
      }

      // ============================================================
      // EXACT STARTUP SEQUENCE:
      // Frame 01 of EXR held visually
      // Phase A: CBK DESIGNFOLIO Glyph Lottery introduction (0.3s)
      // Phase B: Immediate full-screen glitch (0.2s)
      // Exact timing: Quote reveals AT START of glitch (300ms)
      // Total startup = 0.5s -> Hero release & EXR playback (01 -> 39)
      // ============================================================
      const splashDf = document.getElementById('splash-df');
      if (splashDf && typeof runGlyphLotteryOnChars === 'function') {
        const text = "DESIGNFOLIO";
        splashDf.innerHTML = text.split('').map(ch => `<span class="gl-char" data-orig="${ch}">${ch}</span>`).join('');
        runGlyphLotteryOnChars(splashDf.querySelectorAll('.gl-char'), 280);
      }

      setTimeout(() => {
        // At 0.3s (300ms): CBK DESIGNFOLIO title finishes, immediate full-screen glitch triggers (0.2s)
        if (centerSplash) {
          centerSplash.style.display = 'none';
        }
        if (multiverseGlitch) {
          multiverseGlitch.classList.add('is-active');
        }

        // EXACT REQUIREMENT: Quote begins revealing at exact start of glitch (300ms)
        triggerQuoteReveal();

        // At 0.3s + 0.2s = 0.5s: full-screen glitch finishes, HERO REVEAL begins, EXR released
        setTimeout(() => {
          if (multiverseGlitch) {
            multiverseGlitch.classList.remove('is-active');
            multiverseGlitch.style.display = 'none';
          }

          // Release EXR playback to advance smoothly 01 -> 39, then freeze at frame 39
          if (window.releaseHeroExrPlayback) {
            window.releaseHeroExrPlayback();
          }

          // Dense Gondens ferrofluid name forms
          nameFormationProgress = 0;

          // Remaining Hero UI elements reveal subtly
          setTimeout(() => {
            if (contactLinks) contactLinks.classList.add('is-revealed');
            if (scrollWidget) scrollWidget.classList.add('is-visible');
            if (tickerWrap) tickerWrap.classList.add('is-visible');
          }, 180);

        }, 200); // Exact 0.2s full-screen glitch duration

      }, 300); // Exact 0.3s startup title duration

      if (scrollWidget) {
        scrollWidget.addEventListener('click', () => {
          const mainContent = document.getElementById('main-content');
          if (mainContent) mainContent.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // ============================================================
      // ============================================================
// 11. SECTION 02 — BY THE NUMBERS & CINEMATIC SHOWCASE ENGINE
// ============================================================
(function initByTheNumbers() {
  // Metric Tile Tap / Click / Keyboard Accordion Expansion
  const tiles = document.querySelectorAll('.number-tile');
  tiles.forEach(tile => {
    tile.addEventListener('click', () => {
      const isExpanded = tile.classList.contains('is-expanded');
      // Collapse others on mobile/clean reading
      tiles.forEach(t => t.classList.remove('is-expanded'));
      if (!isExpanded) {
        tile.classList.add('is-expanded');
      }
    });

    tile.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        tile.classList.toggle('is-expanded');
      }
    });
  });

  // Ramayana & Veerabhadra 10-Second Auto-Rotation Showcase
  const rotTabs = document.querySelectorAll('.rot-tab-btn');
  const slides = document.querySelectorAll('.cinematic-slide');
  const badge = document.getElementById('rot-num-badge');
  let currentIdx = 0;
  let showcaseTimer = null;

  function setSlide(idx) {
    currentIdx = idx;
    slides.forEach((s, i) => {
      s.classList.toggle('is-active', i === idx);
    });
    rotTabs.forEach((b, i) => {
      b.classList.toggle('is-active', i === idx);
    });
    if (badge) {
      badge.textContent = `0${idx + 1} / 02`;
    }
    // Restart 10s progress bar
    const pLines = document.querySelectorAll('.tab-progress-line');
    pLines.forEach(pl => {
      pl.style.transition = 'none';
      pl.style.width = '0%';
    });
    const activeLine = document.getElementById(`prog-line-${idx}`);
    if (activeLine) {
      setTimeout(() => {
        activeLine.style.transition = 'width 10s linear';
        activeLine.style.width = '100%';
      }, 50);
    }
  }

  function nextSlide() {
    setSlide((currentIdx + 1) % 2);
  }

  function startShowcaseTimer() {
    clearInterval(showcaseTimer);
    showcaseTimer = setInterval(nextSlide, 10000);
  }

  rotTabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const idx = parseInt(btn.getAttribute('data-idx') || '0', 10);
      setSlide(idx);
      startShowcaseTimer();
    });
  });

  // Start initial rotation
  setSlide(0);
  startShowcaseTimer();
})();

// ============================================================
// 12. SECTION 02.5 — DISCIPLINES: NINE-PIECE INTERACTIVE PUZZLE
// ============================================================
(function initDisciplinesPuzzle() {
  const puzzleGroup = document.getElementById('puzzle-pieces-group');
  const pieces = document.querySelectorAll('.puzzle-piece');
  const statusText = document.getElementById('puzzle-status-text');
  const timerBar = document.getElementById('puzzle-timer-bar');
  const detailCard = document.getElementById('puzzle-detail-card');
  const detailTag = document.getElementById('puzzle-detail-tag');
  const detailTitle = document.getElementById('puzzle-detail-title');
  const detailDesc = document.getElementById('puzzle-detail-desc');
  const detailClose = document.getElementById('puzzle-detail-close');

  if (!puzzleGroup || pieces.length === 0) return;

  const DISCIPLINE_DATA = [
    { name: "Creative Direction", desc: "Shaping holistic visual aesthetics, high-velocity concept design, stylistic cohesion, and reference-driven storytelling from initial brief to executive delivery." },
    { name: "Generative AI", desc: "Mastery of cutting-edge neural models, diffusion architectures, transformer models, and continuous integration of state-of-the-art generative tech." },
    { name: "Visual Development", desc: "Look-dev, color keys, atmospheric studies, cinematic lighting, and production-ready visual asset libraries for film and IP worlds." },
    { name: "Cinematic Storytelling", desc: "Crafting multi-shot visual sequences, narrative continuity, dramatic framing, and emotional pacing across cinematic shorts and trailers." },
    { name: "AI Image + Video", desc: "High-volume generation and animation workflows across Midjourney, SDXL, Runway Gen-3, Kling, and custom video pipelines." },
    { name: "Character Development", desc: "Digital human creation, identity preservation across diverse camera angles and lighting, hero design, and full expression turnarounds." },
    { name: "Environment Design", desc: "Monumental worldbuilding, alien and historical architecture, volumetric atmospheric landscapes, and complex sci-fi/mythic environments." },
    { name: "AI Creative Workflows", desc: "Custom ComfyUI node architectures, LoRA model training, IP-Adapter conditioning, ControlNet pipelines, and automated studio pipelines." },
    { name: "Prompt Architecture", desc: "Structured, repeatable semantic prompt engineering, negative-prompt optimization, token weight balancing, and consistent style encoding." }
  ];

  // Separated offsets for each of the 9 pieces (col 0..2, row 0..2)
  const SEPARATED_OFFSETS = [
    { dx: -42, dy: -36 }, // 0: Top-Left
    { dx: 0,   dy: -46 }, // 1: Top-Center
    { dx: 42,  dy: -36 }, // 2: Top-Right
    { dx: -48, dy: 0   }, // 3: Middle-Left
    { dx: 0,   dy: 0, scale: 0.92 }, // 4: Center
    { dx: 48,  dy: 0   }, // 5: Middle-Right
    { dx: -42, dy: 36  }, // 6: Bottom-Left
    { dx: 0,   dy: 46  }, // 7: Bottom-Center
    { dx: 42,  dy: 36  }  // 8: Bottom-Right
  ];

  let isAssembled = false;
  let isPausedByUser = false;
  let loopTimeout = null;
  let holdInterval = null;
  let holdStartTime = 0;
  const HOLD_DURATION_MS = 10000; // Exact 10 seconds hold
  const SEPARATE_HOLD_MS = 2500;  // 2.5s separated pause

  function applySeparatedState() {
    isAssembled = false;
    puzzleGroup.classList.remove('is-assembled');
    puzzleGroup.classList.add('is-separated');
    if (statusText) statusText.textContent = "CYCLE: SEPARATED ARCHITECTURE";
    if (timerBar) {
      timerBar.style.transition = 'none';
      timerBar.style.width = '0%';
    }

    pieces.forEach((piece, idx) => {
      const off = SEPARATED_OFFSETS[idx] || { dx: 0, dy: 0 };
      const s = off.scale !== undefined ? ` scale(${off.scale})` : '';
      piece.style.transform = `translate(${off.dx}px, ${off.dy}px)${s}`;
    });
  }

  function applyAssembledState() {
    isAssembled = true;
    puzzleGroup.classList.remove('is-separated');
    puzzleGroup.classList.add('is-assembled');
    if (statusText) statusText.textContent = "CYCLE: ASSEMBLED LOOK-DEV (HOLD 10s)";

    pieces.forEach(piece => {
      piece.style.transform = `translate(0px, 0px) scale(1)`;
    });

    // Start 10-second hold countdown
    holdStartTime = Date.now();
    if (timerBar) {
      timerBar.style.transition = 'none';
      timerBar.style.width = '0%';
      setTimeout(() => {
        timerBar.style.transition = 'width 10s linear';
        timerBar.style.width = '100%';
      }, 50);
    }
  }

  function scheduleNextCycle() {
    if (isPausedByUser) return;
    clearTimeout(loopTimeout);

    if (isAssembled) {
      // Hold for 10 seconds, then separate
      loopTimeout = setTimeout(() => {
        if (isPausedByUser) return;
        applySeparatedState();
        scheduleNextCycle();
      }, HOLD_DURATION_MS);
    } else {
      // Hold separated state for 2.5s, then assemble
      loopTimeout = setTimeout(() => {
        if (isPausedByUser) return;
        applyAssembledState();
        scheduleNextCycle();
      }, SEPARATE_HOLD_MS);
    }
  }

  // Interactive Piece Selection
  function selectPiece(idx) {
    const data = DISCIPLINE_DATA[idx];
    if (!data) return;

    // Pause loop during user examination
    isPausedByUser = true;
    clearTimeout(loopTimeout);
    if (statusText) statusText.textContent = `INSPECTING // DISCIPLINE 0${idx + 1} (LOOP PAUSED)`;

    pieces.forEach((p, i) => {
      p.classList.toggle('is-selected', i === idx);
    });

    if (detailCard) {
      detailCard.classList.add('is-open');
      detailCard.setAttribute('aria-hidden', 'false');
      if (detailTag) detailTag.textContent = `DISCIPLINE // 0${idx + 1}`;
      if (detailTitle) detailTitle.textContent = data.name.toUpperCase();
      if (detailDesc) detailDesc.textContent = data.desc;
    }
  }

  function closeDetailCard() {
    if (detailCard) {
      detailCard.classList.remove('is-open');
      detailCard.setAttribute('aria-hidden', 'true');
    }
    pieces.forEach(p => p.classList.remove('is-selected'));

    // Resume loop smoothly
    if (isPausedByUser) {
      isPausedByUser = false;
      if (statusText) statusText.textContent = isAssembled ? "CYCLE: ASSEMBLED LOOK-DEV (HOLD 10s)" : "CYCLE: SEPARATED ARCHITECTURE";
      scheduleNextCycle();
    }
  }

  pieces.forEach((piece, idx) => {
    piece.addEventListener('click', (e) => {
      e.stopPropagation();
      selectPiece(idx);
    });

    piece.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectPiece(idx);
      }
    });
  });

  if (detailClose) {
    detailClose.addEventListener('click', (e) => {
      e.stopPropagation();
      closeDetailCard();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isPausedByUser) {
      closeDetailCard();
    }
  });

  // Start with separated arrangement, then assemble after initial 1s
  applySeparatedState();
  loopTimeout = setTimeout(() => {
    applyAssembledState();
    scheduleNextCycle();
  }, 1000);
})();


      // ============================================================
      // 13. SECTION 05 — THE PIPELINE: 50-ITEM 3D IMAGE SPHERE
      //     - Exactly 50 items (25 landscape, 25 portrait)
      //     - Replaceable structured data archive
      //     - Preserves true landscape vs portrait proportions
      //     - 3D Fibonacci sphere distribution with inertia rotation
      //     - Landscape / Portrait filter controls
      //     - Focal card inspection & contextual note
      // ============================================================
      const sphereCanvas = document.getElementById('pipeline-3d-sphere-canvas');
