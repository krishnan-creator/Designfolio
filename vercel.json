{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "backstage.html",
          "style.css",
          "script.js",
          "backstage-app.js",
          "storage-adapter.js",
          "data/**",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.webp",
          "*.svg",
          "*.mp4",
          "*.mpeg",
          "*.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
