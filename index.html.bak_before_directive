    }

    .sd-label-wrap {
      display: flex;
      flex-direction: column;
    }

    .sd-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: #ffffff;
      text-transform: uppercase;
    }

    .sd-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8px;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.45);
      text-transform: uppercase;
    }

    /* HERO LEFT IDENTITY STAGE (LOWERED COHERENT VERTICAL STACK WITH STRICT LEFT ALIGNMENT) */
    .hero-left-stage {
      position: absolute;
      left: clamp(28px, 4.5vw, 64px);
      top: 53.5%;
      transform: translateY(-44%);
      z-index: 20;
      max-width: clamp(440px, 46vw, 640px);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      pointer-events: auto;
    }

    /* DENSE FERROFLUID PARTICLE TYPOGRAPHY (TIGHTLY PACKED, SOLID BOLD SILHOUETTE) */
    .hero-name-wrap {
      position: relative;
      width: 100%;
      min-height: 195px;
      user-select: none;
      margin-left: 0;
      padding-left: 0;
      align-self: flex-start;
    }

    #name-particle-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* EDITORIAL QUOTE STATEMENT (STRICT LEFT ALIGNMENT WITH NAME & STICKY NOTE) */
    .hero-quote-wrap {
      margin-top: 14px;
      margin-left: 0;
      padding-left: 0;
      display: flex;
      align-items: center;
      align-self: flex-start;
      gap: 10px;
    }

    .quote-mask-track {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .quote-bracket {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      color: var(--dbl-crimson);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .quote-bracket.is-revealed {
      opacity: 1;
      transform: translateX(0);
    }

    .quote-text-reveal {
      font-family: var(--font-quote);
      font-size: clamp(22px, 2.0vw, 28px);
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: none;
      color: #FFFFFF;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      font-style: italic;
    }

    .quote-text-reveal .q-char {
      display: inline-block;
      opacity: 0;
      transform: translateY(6px);
      filter: blur(3px);
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--q-idx, 0) * 16ms);
    }

    .quote-text-reveal.is-revealed .q-char {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    .quote-guide-bar {
      height: 1px;
      width: 0;
      background: linear-gradient(90deg, var(--dbl-crimson) 0%, transparent 100%);
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
    }

    .quote-guide-bar.is-expanded {
      width: 54px;
    }

    /* REALISTIC WARM PAPER STICKY NOTE (BOTTOM-LEFT CURLED CORNER & TOP ADHESIVE STRIP FROM REFERENCE) */
    .sticky-note {
      position: relative;
      margin-top: 16px;
      margin-left: 0;
      align-self: flex-start;
      width: clamp(292px, 23.5vw, 328px);
      max-width: 335px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      /* Top adhesive strip + warm pale-yellow paper gradient matching reference */
      background: 
        linear-gradient(to bottom, rgba(246, 222, 92, 0.42) 0%, rgba(246, 222, 92, 0.42) 14%, transparent 14.5%),
        linear-gradient(165deg, #FFFDE0 0%, #FFF8A8 40%, #FDF07B 100%);
      color: #1a170e;
      border: 1px solid rgba(220, 198, 95, 0.45);
      border-radius: 4px 6px 4px 0; /* clean corners, bottom-left curl */
      padding: 16px 18px 14px 18px; /* natural proportions sized closely to text */
      box-shadow: 
        0 14px 28px -6px rgba(0, 0, 0, 0.48),
        0 4px 10px -2px rgba(0, 0, 0, 0.24),
        0 1px 3px rgba(0, 0, 0, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.90),
        inset 0 -1px 2px rgba(170, 135, 20, 0.10);
      transform: translateY(14px) scale(0.96);
      transform-origin: 0% 0%;
      transform-style: preserve-3d;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.16s ease-out,
                  box-shadow 0.35s ease;
      user-select: text;
    }

    /* Reference: Curled bottom-left corner with contact shadow and golden underside fold */
    .sticky-note::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: -1px;
      width: 22px;
      height: 22px;
      background: radial-gradient(circle at 100% 0%, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.10) 60%, transparent 75%);
      clip-path: polygon(0 0, 100% 100%, 0 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* Paper fold underside triangle (turned back flap) */
    .sticky-note::before {
      content: '';
      position: absolute;
      bottom: -1px;
      left: -1px;
      width: 24px;
      height: 24px;
      background: linear-gradient(135deg, #DEBA39 0%, #E8C94B 45%, #F7E172 100%);
      clip-path: polygon(0 100%, 100% 100%, 100% 0);
      border-radius: 0 0 0 2px;
      box-shadow: 2px -2px 4px rgba(0, 0, 0, 0.20);
      pointer-events: none;
      z-index: 2;
    }

    .sticky-note.is-revealed {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .sticky-note.is-revealed:hover {
      box-shadow: 
        0 18px 34px -6px rgba(0, 0, 0, 0.54),
        0 6px 14px -2px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);
    }

    /* CONVENTIONAL OFFICE NOTICEBOARD RED PUSH PIN */
    .isometric-push-pin {
      position: absolute;
      top: -13px;
      right: 18px;
      left: auto;
      width: 34px;
      height: 42px;
      z-index: 15;
      pointer-events: none;
      filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.40));
      transform-origin: 10px 36px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sticky-note.is-revealed .isometric-push-pin {
      animation: pinImpaleSettle 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
    }

    @keyframes pinImpaleSettle {
      0% {
        transform: translate(6px, -14px) scale(1.20) rotate(8deg);
        opacity: 0;
      }
      60% {
        transform: translate(-1px, 2px) scale(0.97) rotate(-2deg);
        opacity: 1;
      }
      100% {
        transform: translate(0, 0) scale(1) rotate(0deg);
        opacity: 1;
      }
    }

    .sticky-header {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #9E1919;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 9px;
    }

    .sticky-body {
      font-family: var(--font-sticky-body);
      font-size: clamp(11.8px, 0.98vw, 12.6px);
      line-height: 1.50;
      color: #1e1b15;
      font-weight: 500;
      letter-spacing: -0.01em;
      text-transform: none;
      margin: 0;
      padding-bottom: 2px;
    }

    .sticky-display-line {
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .sticky-display-line.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .sticky-body strong {
      color: #050505;
      font-weight: 700;
      border-bottom: 1.5px solid #d32028;
      padding-bottom: 1px;
    }

    /* CONTACT LINKS ROW */
    .contact-links-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 18px;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s;
    }

    .contact-links-row.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .contact-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #ffffff;
      text-decoration: none;
      transition: all 0.22s ease;
    }

    .contact-btn:hover {
      background: var(--dbl-crimson-subtle);
      border-color: var(--dbl-crimson-border);
      color: var(--dbl-crimson);
      transform: translateY(-2px);
      box-shadow: 0 0 14px var(--dbl-crimson-glow);
    }

    /* HERO TICKER WITH STRUCTURED HORIZONTAL RAIL */
    .hero-ticker-wrap {
      position: absolute;
      bottom: clamp(14px, 2.5vh, 26px);
      left: 0;
      width: 100vw;
      z-index: 30;
      background: rgba(11, 11, 14, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-ticker-wrap.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Ticker stays permanently dark in both themes */
    .hero-ticker-wrap {
      background: rgba(11, 11, 14, 0.94) !important;
      border-top: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6) !important;
    }

    .ticker-sequence {
      color: rgba(255, 255, 255, 0.92) !important;
    }

    .ticker-viewport {
      width: 100%;
      overflow: hidden;
      padding: 10px 0;
      mask-image: linear-gradient(90deg, transparent 0%, black 60px, black calc(100% - 60px), transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 60px, black calc(100% - 60px), transparent 100%);
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      width: max-content;
      animation: tickerLeftToRight 36s linear infinite;
      will-change: transform;
    }

    @keyframes tickerLeftToRight {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0%); }
    }

    .ticker-sequence {
      display: inline-flex;
      align-items: center;
      gap: clamp(32px, 3.8vw, 56px);
      padding-right: clamp(32px, 3.8vw, 56px);
      font-family: 'Space Grotesk', 'JetBrains Mono', monospace;
      font-size: clamp(12.5px, 1.25vw, 14.5px);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.88);
    }

    .ticker-dot {
      color: var(--dbl-crimson);
      font-size: 14px;
      line-height: 1;
    }

    /* ============================================================
       06. DBL MAIN WRAPPER (SECTIONS 02 TO 07)
       ============================================================ */
    .dbl-section-wrap {
      position: relative;
      background: transparent;
      color: var(--dbl-text-primary);
      z-index: 20;
      box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.7);
      overflow: hidden;
      transition: var(--dbl-theme-transition);
    }

    /* Pipeline Archive Filters (All / Landscape / Portrait) */
    .pipeline-filter-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 24px;
      position: relative;
      z-index: 10;
