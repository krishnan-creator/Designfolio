      // ============================================================
      // 2. LIVE TIME DISPLAY (DEVICE TIMEZONE)
      // ============================================================
      function updateLiveTime() {
        try {
          const now = new Date();
          const userTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
          const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: userTimeZone,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
          });
          const parts = formatter.formatToParts(now);
          let h = '00', m = '00', s = '00', dayPeriod = 'AM';
          for (const p of parts) {
            if (p.type === 'hour') h = p.value;
            if (p.type === 'minute') m = p.value;
            if (p.type === 'second') s = p.value;
            if (p.type === 'dayPeriod') dayPeriod = p.value.toUpperCase();
          }
          const digitsEl = document.getElementById('time-digits');
          const periodEl = document.getElementById('time-period');
          if (digitsEl) digitsEl.textContent = `${h}:${m}:${s}`;
          if (periodEl) periodEl.textContent = dayPeriod;
        } catch(e) {}
      }
      setInterval(updateLiveTime, 1000);
      updateLiveTime();

      // ============================================================
      // 3. EMOTION-INSPIRED LIVING FLUID ENVIRONMENTAL FIELD (STRICTLY POST-HERO)
      //     - Real continuous fluid displacement field (ZERO PARTICLES)
      //     - Multi-layer: Low-frequency broad flow + secondary organic flow + atmospheric drift
      //     - Localized mouse-force wake & physical deformation strictly behind post-hero sections
      //     - Smooth relaxation on mouse stop; dissipation on mouse leave
      //     - Continuous organic motion even when mouse is completely still
      //     - Absolutely clean/hidden inside Hero (opacity = 0 while viewing Hero)
      // ============================================================
      // ============================================================
      // 3. REACT BITS DUAL-MODE POST-HERO BACKGROUND:
      //    - Dark Theme: GLITTER WARP (radial starfield warp tunnel, lavender-violet streaks #B19EEF)
      //    - Light Theme: LANDSCAPE (raymarched terrain: bright sky, hazy ridges, dark foreground, magenta ribbon #E93CF8)
      //    - Strictly behind post-hero sections (clean/hidden in Hero)
      //    - Smooth theme transitions, continuous motion, zero mouse-driven deformation
      // ============================================================
      (function initPostHeroBackground() {
        const canvas = document.getElementById('post-hero-fluid-background');
        if (!canvas) return;

        let gl = canvas.getContext('webgl', { alpha: false, antialias: false, powerPreference: 'high-performance' }) ||
                 canvas.getContext('experimental-webgl', { alpha: false });

        let width = 0;
        let height = 0;

        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          const scale = Math.min(window.devicePixelRatio || 1, 1.5);
          canvas.width = Math.round(width * scale);
          canvas.height = Math.round(height * scale);
          if (gl) gl.viewport(0, 0, canvas.width, canvas.height);
        }
        resize();
        window.addEventListener('resize', resize, { passive: true });

        // Scroll-linked visibility: Hero is permanently clean (opacity = 0), post-hero displays background
        function updatePostHeroBgVisibility() {
          const scrollY = window.scrollY || window.pageYOffset;
          const heroEl = document.getElementById('hero-section');
          const heroH = heroEl ? heroEl.offsetHeight : window.innerHeight;
          if (scrollY > heroH * 0.25) {
            const progress = Math.min(1, (scrollY - heroH * 0.25) / (heroH * 0.35));
            canvas.style.opacity = (progress * 0.98).toFixed(3);
          } else {
            canvas.style.opacity = '0';
          }
        }
        window.addEventListener('scroll', updatePostHeroBgVisibility, { passive: true });
        updatePostHeroBgVisibility();

        if (!gl) {
          // Performant 2D Canvas Fallback
          const ctx = canvas.getContext('2d');
          let t = 0;
          function render2dFallback() {
            t += 0.015;
            ctx.clearRect(0, 0, width, height);
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            ctx.fillStyle = isLight ? '#F7F6F3' : '#0E0E12';
            ctx.fillRect(0, 0, width, height);
            requestAnimationFrame(render2dFallback);
          }
          requestAnimationFrame(render2dFallback);
          return;
        }

        const vsSource = `
          attribute vec2 a_pos;
          void main() {
            gl_Position = vec4(a_pos, 0.0, 1.0);
          }
        `;

        const fsSource = `
          precision highp float;
          uniform vec2 u_resolution;
          uniform float u_time;
          uniform float u_theme;

          // HASH & NOISE UTILITIES
          float hash21(vec2 p) {
            return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
          }

          // DBL DARK THEME — Layered Charcoal, Graphite & Soft Near-Black Ambient Motion
          // Rich layered tones (#0D0D11, #15151A, #1D1D24); zero starburst/wormhole radial streaks
          vec3 renderDarkAtmosphere(vec2 uv) {
            vec3 cBase = vec3(0.052, 0.052, 0.065); // Charcoal #0D0D11
            vec3 cMid  = vec3(0.082, 0.082, 0.102); // Graphite #15151A
            vec3 cHigh = vec3(0.115, 0.115, 0.142); // Soft near-black highlight #1D1D24

            float t = u_time * 0.15; // Slow ambient tempo

            // Gentle undulating ambient light waves
            float wave1 = sin(uv.x * 1.8 + t * 0.8 + uv.y * 1.2) * 0.5 + 0.5;
            float wave2 = cos(uv.y * 2.2 - t * 0.6 + uv.x * 0.9) * 0.5 + 0.5;
            float wave3 = sin((uv.x + uv.y) * 1.4 + t * 0.4) * 0.5 + 0.5;

            float blend = wave1 * 0.45 + wave2 * 0.35 + wave3 * 0.20;

            vec3 col = mix(cBase, cMid, blend * 0.7);
            col = mix(col, cHigh, pow(blend, 2.5) * 0.35);

            // Subtle tactile micro-film grain
            float grain = (hash21(gl_FragCoord.xy + fract(u_time * 0.2) * 100.0) - 0.5) * 0.008;
            return clamp(col + grain, 0.0, 1.0);
          }

          // CINE CASERO LIGHT THEME — Refined Warm-White, Ivory & Pale-Grey Neutral Surfaces
          // (https://www.cinecasero.uy/ visual reference)
          // Clean editorial surfaces; ZERO purple wash, ZERO pink/violet streaks, ZERO marbled mud.
          vec3 renderCineCaseroLight(vec2 uv) {
            vec3 cIvory   = vec3(0.984, 0.980, 0.973); // Warm ivory #FBFAF8
            vec3 cPale    = vec3(0.952, 0.948, 0.938); // Pale neutral #F3F2EF
            vec3 cWarmGray= vec3(0.918, 0.914, 0.902); // Pale-grey tone #EAE9E6

            float t = u_time * 0.08;

            // Very subtle, imperceptible warm ambient illumination gradient
            float grad = (uv.x * 0.4 - uv.y * 0.6) * 0.5 + 0.5;
            float drift = sin(uv.x * 1.2 + uv.y * 0.8 + t) * 0.06;
            float blend = clamp(grad + drift, 0.0, 1.0);

            vec3 col = mix(cPale, cIvory, blend);
            col = mix(col, cWarmGray, (1.0 - blend) * 0.25);

            // Fine editorial paper grain (restrained, tactile)
            float grain = (hash21(gl_FragCoord.xy + fract(u_time * 0.1) * 50.0) - 0.5) * 0.005;
            return clamp(col + grain, 0.0, 1.0);
          }

          void main() {
            vec2 uv = (gl_FragCoord.xy - 0.5 * u_resolution) / min(u_resolution.x, u_resolution.y);
            vec3 colDark = renderDarkAtmosphere(uv);
            vec3 colLight = renderCineCaseroLight(uv);
            vec3 finalCol = mix(colDark, colLight, u_theme);
            gl_FragColor = vec4(finalCol, 1.0);
          }
        `;

        function createShader(type, src) {
          const s = gl.createShader(type);
          gl.shaderSource(s, src);
          gl.compileShader(s);
          if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {
