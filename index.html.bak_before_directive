    .dbl-section-header {
      margin-bottom: clamp(40px, 5.5vh, 60px);
    }

    .dbl-meta-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dbl-text-tertiary);
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
    }

    .dbl-meta-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
