}

.puzzle-pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--dbl-crimson);
  box-shadow: 0 0 8px var(--dbl-crimson);
  animation: signalPulse 2s ease-in-out infinite;
}

.puzzle-timer-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9.5px;
  font-weight: 700;
  color: var(--dbl-text-tertiary);
  letter-spacing: 0.14em;
}

.puzzle-timer-bar-track {
  width: 100px;
  height: 4px;
  background: var(--dbl-border-subtle);
  border-radius: 2px;
  overflow: hidden;
}

.puzzle-timer-bar {
  height: 100%;
  width: 0%;
  background: var(--dbl-crimson);
  border-radius: 2px;
  transition: width 0.1s linear;
}

.puzzle-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 900 / 600;
  max-height: 580px;
  background: #08080B;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--dbl-border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
}

[data-theme="light"] .puzzle-stage {
  background: #F0EEE9;
}

.puzzle-svg {
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}

.puzzle-piece {
  cursor: pointer;
  outline: none;
  transition: transform 1.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.3s ease;
  transform-origin: center center;
}

.puzzle-piece .piece-tint {
  fill: rgba(12, 12, 16, 0.65);
  transition: fill 0.6s ease;
}

[data-theme="light"] .puzzle-piece .piece-tint {
  fill: rgba(255, 255, 255, 0.50);
}

.puzzle-piece .piece-stroke {
  fill: none;
  stroke: rgba(255, 255, 255, 0.24);
  stroke-width: 1.5;
  transition: stroke 0.3s ease, stroke-width 0.3s ease;
}

[data-theme="light"] .puzzle-piece .piece-stroke {
  stroke: rgba(0, 0, 0, 0.22);
}

.piece-num-text {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 700;
