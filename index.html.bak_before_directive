        // Broad, smooth circular repulsion field (~215 CSS px desktop, per Requirement 1)
        const REPULSION_RADIUS = Math.min(225.0, Math.max(185.0, nameCanvasWidth * 0.30));
        // Mouse velocity influences local flow strength, clamped for stability
