    }

    [data-theme="light"] .pipeline-filter-btn {
      background: rgba(255, 255, 255, 0.85);
      border-color: var(--dbl-border-base);
    }

    .dbl-content-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: clamp(72px, 9vh, 120px) clamp(24px, 4.5vw, 64px);
      position: relative;
      z-index: 2;
