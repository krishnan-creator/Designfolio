      window.PIPELINE_ARCHIVE_DATA = PIPELINE_ARCHIVE_DATA;

      // Preload images
      const loadedSphereImages = new Map();
      PIPELINE_ARCHIVE_DATA.forEach(item => {
        const img = new Image();
        img.src = item.imageSrc;
        loadedSphereImages.set(item.imageSrc, img);
      });

      // Distribute exactly 20 nodes on 3D Fibonacci Sphere
      const SPHERE_NODE_COUNT = 20;
      const sphereNodes = [];
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));

      for (let i = 0; i < SPHERE_NODE_COUNT; i++) {
        const y = 1 - (i / (SPHERE_NODE_COUNT - 1)) * 2;
        const radiusAtY = Math.sqrt(1 - y * y);
        const theta = goldenAngle * i;
        const x = Math.cos(theta) * radiusAtY;
        const z = Math.sin(theta) * radiusAtY;

        const dataItem = PIPELINE_ARCHIVE_DATA[i];
        const isLandscape = dataItem.orientation === 'landscape';

        sphereNodes.push({
          nx: x,
          ny: y,
          nz: z,
          data: dataItem,
          cardW: isLandscape ? 134 : 84,
          cardH: isLandscape ? 84 : 126,
          hoverScale: 1
        });
      }
      window.sphereNodes = sphereNodes;

      let sphereRotX = 0.2;
      let sphereRotY = 0;
      let sphereVelX = 0;
      let sphereVelY = 0.0022;
      let isDraggingSphere = false;
      let dragLastX = 0;
      let dragLastY = 0;
      let hoveredSphereNode = null;
      let selectedSphereNode = null;
      let activePipelineFilter = 'all';

      // Filter Buttons wiring
      const filterBtns = document.querySelectorAll('.pipeline-filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          activePipelineFilter = btn.getAttribute('data-filter') || 'all';
        });
      });

      function resizeSphereCanvas() {
        if (!sphereCanvas || !sphereContainer) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = sphereContainer.getBoundingClientRect();
        sphereCanvas.width = Math.round(rect.width * dpr);
        sphereCanvas.height = Math.round(rect.height * dpr);
        if (sCtx) sCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resizeSphereCanvas();
      window.addEventListener('resize', resizeSphereCanvas, { passive: true });

      function renderPipelineSphere() {
        if (!sCtx || !sphereCanvas || !sphereContainer) return;
        const rect = sphereContainer.getBoundingClientRect();
        const w = rect.width;
        const h = rect.height;
        const cx = w * 0.5;
        const cy = h * 0.5;
        const sphereRadius = Math.min(w * 0.38, h * 0.40, 310);
        const fov = 500;

        sCtx.clearRect(0, 0, w, h);

        if (!isDraggingSphere) {
          sphereRotY += sphereVelY;
          sphereRotX += sphereVelX;
          sphereVelY = sphereVelY * 0.94 + 0.00012;
          sphereVelX *= 0.92;
        }

        sphereRotX = Math.max(-0.85, Math.min(0.85, sphereRotX));

        const cosX = Math.cos(sphereRotX);
        const sinX = Math.sin(sphereRotX);
        const cosY = Math.cos(sphereRotY);
        const sinY = Math.sin(sphereRotY);

        const projectedNodes = [];

        for (let i = 0; i < sphereNodes.length; i++) {
          const node = sphereNodes[i];
          const matchesFilter = activePipelineFilter === 'all' || node.data.orientation === activePipelineFilter;

          const x1 = node.nx * cosY - node.nz * sinY;
          const z1 = node.nx * sinY + node.nz * cosY;
          const y2 = node.ny * cosX - z1 * sinX;
          const z2 = node.ny * sinX + z1 * cosX;

          const px = x1 * sphereRadius;
          const py = y2 * sphereRadius;
          const pz = z2 * sphereRadius;

          const depth = pz + fov;
          const scale = depth > 30 ? (fov / depth) : 0;
          const sx = cx + px * scale;
          const sy = cy + py * scale;

          let alpha = Math.max(0.20, Math.min(1, (pz + sphereRadius) / (sphereRadius * 2) * 0.85 + 0.15));
          if (!matchesFilter) alpha *= 0.10;

          projectedNodes.push({
            node,
            sx,
            sy,
            scale,
            z: pz,
            alpha,
            matchesFilter
          });
        }

        // Painter's algorithm
        projectedNodes.sort((a, b) => a.z - b.z);

        // Subtle structural wireframe boundary ring
        sCtx.save();
        sCtx.strokeStyle = 'rgba(255, 48, 56, 0.08)';
        sCtx.lineWidth = 1;
        sCtx.beginPath();
        sCtx.arc(cx, cy, sphereRadius * 0.95, 0, Math.PI * 2);
        sCtx.stroke();
        sCtx.restore();

        for (let i = 0; i < projectedNodes.length; i++) {
          const p = projectedNodes[i];
          const node = p.node;
          const isHovered = hoveredSphereNode === node;
          const isSelected = selectedSphereNode === node;

          const cardW = Math.round((node.cardW * p.scale) * (isHovered ? 1.15 : 1));
          const cardH = Math.round((node.cardH * p.scale) * (isHovered ? 1.15 : 1));
          const x = p.sx - cardW * 0.5;
          const y = p.sy - cardH * 0.5;

          sCtx.save();
          sCtx.globalAlpha = p.alpha;

          sCtx.fillStyle = isHovered ? '#1c1c24' : '#0c0c10';
          sCtx.strokeStyle = isSelected 
            ? '#FF3038' 
            : (isHovered ? 'rgba(255, 255, 255, 0.95)' : 'rgba(255, 255, 255, 0.20)');
          sCtx.lineWidth = isSelected ? 2.5 : (isHovered ? 1.8 : 1);

          sCtx.beginPath();
          sCtx.roundRect(x, y, cardW, cardH, 4);
          sCtx.fill();
          sCtx.stroke();

          const img = loadedSphereImages.get(node.data.imageSrc);
          if (img && img.complete && img.naturalWidth > 0) {
            sCtx.save();
            sCtx.beginPath();
            sCtx.roundRect(x + 1.5, y + 1.5, cardW - 3, cardH - 3, 3);
            sCtx.clip();
            sCtx.drawImage(img, x + 1.5, y + 1.5, cardW - 3, cardH - 3);
            sCtx.restore();
          } else {
            sCtx.save();
            sCtx.fillStyle = node.data.orientation === 'landscape' ? '#181424' : '#141c24';
            sCtx.beginPath();
            sCtx.roundRect(x + 1.5, y + 1.5, cardW - 3, cardH - 3, 3);
            sCtx.fill();
            sCtx.restore();
          }

          if (isSelected) {
            sCtx.fillStyle = '#FF3038';
            sCtx.fillRect(x + cardW - 8, y + 4, 4, 4);
          } else if (isHovered) {
            sCtx.fillStyle = '#ffffff';
            sCtx.fillRect(x + cardW - 8, y + 4, 4, 4);
          }

          sCtx.restore();

          if (p.matchesFilter) {
            node._bounds = { x, y, w: cardW, h: cardH, z: p.z };
          } else {
            node._bounds = null;
          }
        }

        requestAnimationFrame(renderPipelineSphere);
      }
      requestAnimationFrame(renderPipelineSphere);

      function selectPipelineNode(node) {
        if (!node) return;
        selectedSphereNode = node;
        const d = node.data;
        if (inspectPhase) inspectPhase.textContent = d.phase;
        if (inspectTitle) inspectTitle.textContent = d.title;
        if (inspectDesc) inspectDesc.textContent = d.desc;
        const inspectImg = document.getElementById('inspect-image');
        if (inspectImg) {
          inspectImg.src = d.imageSrc;
          inspectImg.alt = d.title;
        }
        if (inspectTags) {
          inspectTags.innerHTML = d.tags.map(t => `<span class="inspect-tag">${t}</span>`).join('');
        }
        if (inspectPanel) {
          inspectPanel.classList.add('is-active');
          inspectPanel.classList.add('is-open');
        }
      }

      // Pre-select first node on load so inspector is populated and ready
      selectPipelineNode(sphereNodes[0]);

      // Drag to rotate sphere with inertia
      if (sphereContainer) {
        sphereContainer.addEventListener('mousedown', (e) => {
          isDraggingSphere = true;
          dragLastX = e.clientX;
          dragLastY = e.clientY;
          sphereVelX = 0;
          sphereVelY = 0;
        });

        window.addEventListener('mousemove', (e) => {
          if (isDraggingSphere) {
            const dx = e.clientX - dragLastX;
            const dy = e.clientY - dragLastY;
            sphereRotY += dx * 0.005;
            sphereRotX += dy * 0.005;
            sphereVelY = dx * 0.005;
            sphereVelX = dy * 0.005;
            dragLastX = e.clientX;
            dragLastY = e.clientY;
          } else if (sphereContainer) {
            const rect = sphereContainer.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;

            let hitNode = null;
            let maxZ = -9999;
            for (let i = 0; i < sphereNodes.length; i++) {
              const b = sphereNodes[i]._bounds;
              if (b && mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h) {
                if (b.z > maxZ) {
                  maxZ = b.z;
                  hitNode = sphereNodes[i];
                }
              }
            }
            hoveredSphereNode = hitNode;
            sphereContainer.style.cursor = hitNode ? 'pointer' : 'grab';
          }
        });

        window.addEventListener('mouseup', () => {
          if (isDraggingSphere) {
            isDraggingSphere = false;
          }
        });

        sphereContainer.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) {
            isDraggingSphere = true;
            dragLastX = e.touches[0].clientX;
            dragLastY = e.touches[0].clientY;
            sphereVelX = 0;
            sphereVelY = 0;
          }
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
          if (isDraggingSphere && e.touches.length === 1) {
            const dx = e.touches[0].clientX - dragLastX;
            const dy = e.touches[0].clientY - dragLastY;
            sphereRotY += dx * 0.006;
            sphereRotX += dy * 0.006;
            sphereVelY = dx * 0.006;
            sphereVelX = dy * 0.006;
            dragLastX = e.touches[0].clientX;
            dragLastY = e.touches[0].clientY;
          }
        }, { passive: true });

        window.addEventListener('touchend', () => {
          isDraggingSphere = false;
        });

        // Click to inspect focal card with authentic thumbnail
        sphereContainer.addEventListener('click', () => {
          if (hoveredSphereNode) {
            selectPipelineNode(hoveredSphereNode);
          }
        });
      }

      if (inspectClose && inspectPanel) {
        inspectClose.addEventListener('click', () => {
          inspectPanel.classList.remove('is-active');
          inspectPanel.classList.remove('is-open');
          selectedSphereNode = null;
        });
      }

      // ============================================================
      // 14. REUSABLE VIDEO & MEDIA COMPONENT ARCHITECTURE
      //     (Sections 53 & 54: Muted autoplay, loop, responsive,
      //      graceful image fallback, no empty broken players)
      // ============================================================
      window.CBK_MEDIA_REGISTRY = window.CBK_MEDIA_REGISTRY || {};

      window.registerMediaSlotVideo = function(slotName, videoUrl, posterUrl) {
        if (!slotName || !videoUrl) return;
        window.CBK_MEDIA_REGISTRY[slotName] = { url: videoUrl, poster: posterUrl || null };
        const el = document.querySelector(`[data-media-slot="${slotName}"]`);
        if (!el) return;

        const mediaContainer = el.querySelector('.film-media-wrap') || el.querySelector('.cinematic-stage') || el;
        const existingImg = mediaContainer.querySelector('img');
        const poster = posterUrl || (existingImg ? existingImg.src : '');

        let videoEl = mediaContainer.querySelector('.cbk-slot-video');
        if (!videoEl) {
          videoEl = document.createElement('video');
          videoEl.className = 'cbk-slot-video';
          videoEl.autoplay = true;
          videoEl.muted = true;
          videoEl.loop = true;
          videoEl.playsInline = true;
          videoEl.setAttribute('playsinline', '');
          videoEl.setAttribute('muted', '');
          videoEl.setAttribute('loop', '');
          videoEl.style.width = '100%';
          videoEl.style.height = '100%';
          videoEl.style.objectFit = 'cover';
          videoEl.style.display = 'block';

          if (existingImg) {
            existingImg.style.display = 'none';
            existingImg.insertAdjacentElement('beforebegin', videoEl);
          } else {
            mediaContainer.prepend(videoEl);
          }
        }
        videoEl.src = videoUrl;
        if (poster) videoEl.poster = poster;
      };

      Object.keys(window.CBK_MEDIA_REGISTRY).forEach((slot) => {
        const item = window.CBK_MEDIA_REGISTRY[slot];
        if (item && item.url) {
          window.registerMediaSlotVideo(slot, item.url, item.poster);
        }
      });

