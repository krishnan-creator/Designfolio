  <script>
    (() => {
      "use strict";

      // ============================================================
      // 1. THEME CONTROLLER — CIRCULAR REVEAL FROM THEME ICON ORIGIN
      // ============================================================
      const themeToggleBtn = document.getElementById('theme-toggle');
      const circleCurtain = document.getElementById('theme-circle-curtain');
      let currentTheme = localStorage.getItem('dbl-theme') || 'dark';

      function applyTheme(theme) {
        currentTheme = theme;
        document.documentElement.setAttribute('data-theme', theme);
        if (theme === 'light') {
          document.body.classList.add('light-theme');
          document.body.classList.remove('dark-theme');
        } else {
          document.body.classList.remove('light-theme');
          document.body.classList.add('dark-theme');
        }
        localStorage.setItem('dbl-theme', theme);
      }
      applyTheme(currentTheme);

      let isThemeTransitioning = false;

      const themeGlossRing = document.getElementById('hero-theme-gloss-ring');

      function triggerCircularThemeSwitch() {
        if (isThemeTransitioning) return;
        isThemeTransitioning = true;

        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

        // Calculate origin from the theme toggle button's actual center position in the viewport
        let cx = window.innerWidth - 48;
        let cy = 36;
        if (themeToggleBtn) {
          const rect = themeToggleBtn.getBoundingClientRect();
          cx = rect.left + rect.width * 0.5;
          cy = rect.top + rect.height * 0.5;
        }

        const maxDistX = Math.max(cx, window.innerWidth - cx);
        const maxDistY = Math.max(cy, window.innerHeight - cy);
        const targetRadius = Math.ceil(Math.hypot(maxDistX, maxDistY));

        // Check if user is currently inside Hero section
        const heroEl = document.getElementById('hero-section');
        const scrollY = window.scrollY || window.pageYOffset;
        const heroH = heroEl ? heroEl.offsetHeight : window.innerHeight;
        const isUserInHero = scrollY < heroH * 0.85;

        if (isUserInHero) {
          // HERO: Thin glossy transparent glass-like expanding circular ring
          applyTheme(nextTheme);

          if (themeGlossRing) {
            themeGlossRing.className = nextTheme === 'light' ? 'theme-ring-light' : 'theme-ring-dark';
            themeGlossRing.style.left = `${cx}px`;
            themeGlossRing.style.top = `${cy}px`;
            themeGlossRing.style.width = '0px';
            themeGlossRing.style.height = '0px';
            themeGlossRing.style.display = 'block';
            themeGlossRing.style.opacity = '1';

            const anim = themeGlossRing.animate([
              { width: '0px', height: '0px', opacity: 1, borderWidth: '2.5px' },
              { width: `${targetRadius * 2.2}px`, height: `${targetRadius * 2.2}px`, opacity: 0, borderWidth: '1px' }
            ], {
              duration: 650,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
              fill: 'forwards'
            });

            anim.onfinish = () => {
              themeGlossRing.style.display = 'none';
              themeGlossRing.style.opacity = '0';
              isThemeTransitioning = false;
            };
          } else {
            isThemeTransitioning = false;
          }
        } else {
          // POST-HERO: Normal Visuvate-inspired circular reveal curtain
          if (document.startViewTransition) {
            const transition = document.startViewTransition(() => {
              applyTheme(nextTheme);
            });
            transition.ready.then(() => {
              const anim = document.documentElement.animate(
                {
                  clipPath: [
                    `circle(0px at ${cx}px ${cy}px)`,
                    `circle(${targetRadius}px at ${cx}px ${cy}px)`
                  ]
                },
                {
                  duration: 680,
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                  pseudoElement: '::view-transition-new(root)'
                }
              );
              anim.onfinish = () => { isThemeTransitioning = false; };
            }).catch(() => {
              applyTheme(nextTheme);
              isThemeTransitioning = false;
            });
          } else if (circleCurtain) {
            circleCurtain.style.backgroundColor = nextTheme === 'light' ? '#F4F2EE' : '#0B0B0D';
            circleCurtain.style.display = 'block';
            circleCurtain.style.clipPath = `circle(0px at ${cx}px ${cy}px)`;
            circleCurtain.style.opacity = '1';

            const anim = circleCurtain.animate([
              { clipPath: `circle(0px at ${cx}px ${cy}px)` },
              { clipPath: `circle(${targetRadius}px at ${cx}px ${cy}px)` }
            ], {
              duration: 680,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards'
            });

            anim.onfinish = () => {
              applyTheme(nextTheme);
              circleCurtain.style.opacity = '0';
              setTimeout(() => {
                circleCurtain.style.display = 'none';
                isThemeTransitioning = false;
              }, 50);
            };
          } else {
            applyTheme(nextTheme);
            isThemeTransitioning = false;
          }
        }
      }

      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', triggerCircularThemeSwitch);
