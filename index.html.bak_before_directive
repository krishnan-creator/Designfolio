              const norm = dist / REPULSION_RADIUS; // 0 at pointer to 1 at outer boundary
              // Smooth soft radial falloff creating the clear void and halo
              const falloff = Math.pow(Math.max(0, 1.0 - norm), 1.32);
              const force = falloff * 4.2 * speedBoost;

              // 1. Broad smooth radial outward push
              p.vx += (dx / dist) * force;
              p.vy += (dy / dist) * force;

              // 2. Halo vortex flow: particles flow around the moving circular center
              const swirl = Math.sin(norm * Math.PI) * 0.75 * speedBoost;
              p.vx += (-dy / dist) * swirl;
              p.vy += (dx / dist) * swirl;

              // 3. Fluid momentum from pointer velocity
              p.vx += nameMouseVx * falloff * 0.12;
              p.vy += nameMouseVy * falloff * 0.12;
            }
          }

          // Hooke's Law Spring attraction back to exact home coordinates
          const homeDx = p.homeX - p.x;
          const homeDy = p.homeY - p.y;
          const distToHome = Math.hypot(homeDx, homeDy);

          p.vx += homeDx * SPRING_K;
          p.vy += homeDy * SPRING_K;

          // Natural return with velocity damping and zero jitter
          let damping = isMouseOverName ? 0.85 : (distToHome < 4.0 ? 0.70 : 0.82);

          if (distToHome < 0.35 && !isMouseOverName && Math.hypot(p.vx, p.vy) < 0.12) {
            // Exact glyph reconstruction
            p.x = p.homeX;
            p.y = p.homeY;
            p.vx = 0;
            p.vy = 0;
          } else {
            p.vx *= damping;
            p.vy *= damping;
            p.x += p.vx;
            p.y += p.vy;

            // Enforce maximum displacement ceiling to preserve outer letter silhouette
            const curDist = Math.hypot(p.x - p.homeX, p.y - p.homeY);
            if (curDist > MAX_DISPLACEMENT) {
              const ratio = MAX_DISPLACEMENT / curDist;
              p.x = p.homeX + (p.x - p.homeX) * ratio;
              p.y = p.homeY + (p.y - p.homeY) * ratio;
              p.vx *= 0.55;
              p.vy *= 0.55;
            }
          }

