  pointer-events: none;
  transition: opacity 0.4s ease;
}

.piece-name-text {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  font-weight: 800;
  fill: #FFFFFF;
  letter-spacing: 0.12em;
  pointer-events: none;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  transition: opacity 0.4s ease;
}

[data-theme="light"] .piece-name-text {
  fill: #111115;
  text-shadow: 0 1px 4px rgba(255, 255, 255, 0.8);
}

/* Hover and selection states */
.puzzle-piece:hover .piece-stroke,
.puzzle-piece:focus-visible .piece-stroke {
  stroke: #FFFFFF;
  stroke-width: 2.5;
}

[data-theme="light"] .puzzle-piece:hover .piece-stroke,
[data-theme="light"] .puzzle-piece:focus-visible .piece-stroke {
  stroke: #000000;
}

.puzzle-piece:hover .piece-tint {
  fill: rgba(12, 12, 16, 0.20);
}

[data-theme="light"] .puzzle-piece:hover .piece-tint {
  fill: rgba(255, 255, 255, 0.15);
}

.puzzle-piece.is-selected .piece-stroke {
  stroke: var(--dbl-crimson);
  stroke-width: 3;
}

/* Assembled state: landscape revealed fully with crystal clarity */
