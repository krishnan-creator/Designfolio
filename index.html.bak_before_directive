      const GLYPH_CHARSET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/_-';

      function runGlyphLotteryOnChars(charsList, duration = 480) {
        if (!charsList || !charsList.length) return;
        const startTime = performance.now();
        const targets = Array.from(charsList).map(c => c.getAttribute('data-orig') || c.textContent.trim());

