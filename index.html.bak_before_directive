    .left-stage-backdrop {
      display: none !important;
    }

    /* SCROLL DOWN TUTORIAL (UPPER RIGHT OF HERO) */
    .scroll-down-widget {
      position: absolute;
      right: clamp(24px, 4.2vw, 56px);
      top: clamp(82px, 12vh, 108px);
      z-index: 25;
      display: flex;
      align-items: center;
      gap: 12px;
      opacity: 0;
      transform: translateY(-8px);
