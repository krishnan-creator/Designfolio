  <script>
    (() => {
      "use strict";

      // =========================================
      // 1. LIVE TIME (BROWSER / DEVICE TIMEZONE)
      // =========================================
      function updateLiveTime() {
        try {
          const now = new Date();
          const userTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

          const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: userTimeZone,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true
          });

          const parts = formatter.formatToParts(now);
          let hour = '12', minute = '00', second = '00', dayPeriod = 'AM';

          for (const part of parts) {
            if (part.type === 'hour') hour = part.value;
            else if (part.type === 'minute') minute = part.value;
            else if (part.type === 'second') second = part.value;
            else if (part.type === 'dayPeriod') dayPeriod = part.value.toUpperCase();
          }

          const timeDigitsEl = document.getElementById('time-digits');
          const timePeriodEl = document.getElementById('time-period');

          if (timeDigitsEl) timeDigitsEl.textContent = `${hour}:${minute}:${second}`;
          if (timePeriodEl) timePeriodEl.textContent = dayPeriod;
        } catch (e) {
          console.error("Live time error:", e);
        }
      }

      updateLiveTime();
      setInterval(updateLiveTime, 1000);

      // =========================================
      // 2. DESIGNFOLIO TELEPORT LOOP (5.6s SEAMLESS)
      //    (ONE WORD ALWAYS, LETTERS TELEPORT, MECHANICAL SLOTS)
      // =========================================
      const brandDf = document.getElementById('brand-df');
      const dfAllChars = document.querySelectorAll('.df-char');
      const dfSlot = document.getElementById('df-slot');

      function runDesignfolioTeleportLoop() {
        const loopDuration = 5600;

        // 0.0s – 2.0s: Clean Default DESIGNFOLIO
        dfAllChars.forEach((ch) => {
          ch.style.opacity = '1';
          ch.style.transform = 'translate(0, 0)';
          ch.style.color = 'inherit';
          ch.style.filter = 'none';
        });
        if (dfSlot) {
          dfSlot.style.opacity = '0';
          dfSlot.style.transform = 'translate(0, 0)';
        }

        // 2.0s – 2.5s: Letters 'E' and 'N' briefly disappear
        setTimeout(() => {
          const charE = dfAllChars[1];
          const charN = dfAllChars[5];

          if (charE) {
            charE.style.opacity = '0';
            charE.style.transform = 'translateY(-2px)';
          }
          if (charN) {
            charN.style.opacity = '0';
            charN.style.transform = 'translateY(2px)';
          }

          if (dfSlot && charE) {
            const rect = charE.getBoundingClientRect();
            const parentRect = brandDf.getBoundingClientRect();
            dfSlot.style.left = `${rect.left - parentRect.left - 1}px`;
            dfSlot.style.top = `${rect.top - parentRect.top - 1}px`;
            dfSlot.style.opacity = '1';
          }
        }, 2000);

        // 2.5s – 3.2s: Mechanical slot shifts
        setTimeout(() => {
          if (dfSlot) {
            dfSlot.style.transform = 'translate(3px, -1px)';
            dfSlot.style.borderColor = '#ff3b30';
          }
        }, 2500);

        // 3.2s – 3.8s: Letters teleport back from nearby position
        setTimeout(() => {
          const charE = dfAllChars[1];
          const charN = dfAllChars[5];

          if (charE) {
            charE.style.transform = 'translate(0, 0)';
            charE.style.opacity = '1';
            charE.style.color = '#ff5b50';
          }
          if (charN) {
            charN.style.transform = 'translate(0, 0)';
            charN.style.opacity = '1';
            charN.style.color = '#ff5b50';
          }
          if (dfSlot) {
            dfSlot.style.opacity = '0';
          }
        }, 3200);

        // 3.8s – 4.5s: Subtle micro-alignment restoration
        setTimeout(() => {
          brandDf.style.transform = 'translateX(-1px)';
          setTimeout(() => {
            brandDf.style.transform = 'none';
          }, 80);

          dfAllChars.forEach((ch) => {
            ch.style.color = 'inherit';
          });
        }, 3800);

        // 4.5s – 5.6s: Stable clean hold
        setTimeout(runDesignfolioTeleportLoop, loopDuration);
      }

      runDesignfolioTeleportLoop();

      // =========================================
      // 3. 240-FRAME SEQUENTIAL PLAYER
      //    (CONTINUOUS 130 -> 240 ALIVE LOOP)
      // =========================================
      const TOTAL_FRAMES = 240;
      const FRAME_PATH = "./";
      const FRAME_PREFIX = "ezgif-frame-";
      const FRAME_EXTENSION = ".jpg";

      const canvas = document.getElementById("canvas");
      const ctx = canvas.getContext("2d", {
        alpha: false,
        desynchronized: true
      });

      const images = new Array(TOTAL_FRAMES);
      let canvasWidth = 0;
      let canvasHeight = 0;
      let currentFrameIndex = -1;

      let heroState = 'initial';
      let playbackStartTime = 0;
      const FORWARD_PLAYBACK_DURATION = 3800;

      const LOOP_START_FRAME = 129; // Frame 130
      const LOOP_END_FRAME = 239;   // Frame 240
      let loopCurrentFrame = 239;
      let loopDirection = -1;       // Ping-pong for seamless alive portrait
      let lastLoopTickTime = 0;
      const LOOP_FRAME_INTERVAL = 36;

      let upScrollCount = 0;
      let lastUpScrollTime = 0;

      function pad(num) {
        return String(num).padStart(3, "0");
      }

      function frameURL(index) {
        return FRAME_PATH + FRAME_PREFIX + pad(index + 1) + FRAME_EXTENSION;
      }

      function resizeCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvasWidth = window.innerWidth;
        canvasHeight = window.innerHeight;

        canvas.width = Math.round(canvasWidth * dpr);
        canvas.height = Math.round(canvasHeight * dpr);
        canvas.style.width = canvasWidth + "px";
        canvas.style.height = canvasHeight + "px";

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (currentFrameIndex >= 0) {
          drawFrame(currentFrameIndex);
        }
      }

      window.addEventListener("resize", resizeCanvas, { passive: true });
      resizeCanvas();

      function getNearestLoadedFrame(index) {
        if (images[index] && images[index].complete && images[index].naturalWidth > 0) {
          return index;
        }
        for (let i = index - 1; i >= 0; i--) {
          if (images[i] && images[i].complete && images[i].naturalWidth > 0) return i;
        }
        for (let i = index + 1; i < TOTAL_FRAMES; i++) {
          if (images[i] && images[i].complete && images[i].naturalWidth > 0) return i;
        }
        return -1;
      }

      function drawFrame(index) {
        const actualIndex = getNearestLoadedFrame(index);
        if (actualIndex === -1) {
          ctx.fillStyle = "#000";
          ctx.fillRect(0, 0, canvasWidth, canvasHeight);
          return;
        }

        const img = images[actualIndex];
        const sourceWidth = img.naturalWidth;
        const sourceHeight = img.naturalHeight;
        if (!sourceWidth || !sourceHeight) return;

        const scale = Math.max(
          canvasWidth / sourceWidth,
          canvasHeight / sourceHeight
        );

        const drawWidth = sourceWidth * scale;
        const drawHeight = sourceHeight * scale;

        const isDesktop = canvasWidth > 900;
        const alignRatioX = isDesktop ? 0.40 : 0.5;

        const x = (canvasWidth - drawWidth) * alignRatioX;
        const y = (canvasHeight - drawHeight) * 0.5;

        ctx.fillStyle = "#000";
        ctx.fillRect(0, 0, canvasWidth, canvasHeight);
        ctx.drawImage(img, x, y, drawWidth, drawHeight);

        currentFrameIndex = actualIndex;
      }

      function loadFrame(index) {
        return new Promise((resolve) => {
          const img = new Image();
          img.decoding = "async";
          img.onload = () => { images[index] = img; resolve(true); };
          img.onerror = () => { resolve(false); };
          img.src = frameURL(index);
        });
      }

      async function preloadAllFrames() {
        const batchSize = 16;
        for (let start = 0; start < TOTAL_FRAMES; start += batchSize) {
          const batch = [];
          for (let i = start; i < Math.min(start + batchSize, TOTAL_FRAMES); i++) {
            if (i === 0 && images[0]) continue;
            batch.push(loadFrame(i));
          }
          await Promise.all(batch);
        }
      }

      // =========================================
      // 4. MULTI-TRIGGER CINEMATIC PROGRESSION
      //    (HERO LOCKED DURING PROGRESSION)
      // =========================================
      const scrollWidget = document.getElementById('scroll-widget');
      const tickerWrap = document.getElementById('hero-ticker');
      let tickerTriggered = false;

      function triggerHeroTicker() {
        if (tickerTriggered) return;
        tickerTriggered = true;
        if (tickerWrap) {
          tickerWrap.classList.add('is-visible');
        }
      }

      function activateHeroSequence(triggerSource) {
        triggerHeroTicker();

        if (heroState !== 'ready') return;
        heroState = 'transitioning_forward';

        if (scrollWidget) {
          scrollWidget.classList.remove('is-visible');
          scrollWidget.classList.add('is-hidden');
        }

        playbackStartTime = performance.now();
        playForwardFrameLoop();
      }

      function playForwardFrameLoop() {
        if (heroState !== 'transitioning_forward') return;

        const elapsed = performance.now() - playbackStartTime;
        let progress = Math.min(1, elapsed / FORWARD_PLAYBACK_DURATION);

        const frameIndex = Math.min(
          TOTAL_FRAMES - 1,
          Math.floor(progress * (TOTAL_FRAMES - 1))
        );

        drawFrame(frameIndex);

        if (progress < 1) {
          requestAnimationFrame(playForwardFrameLoop);
        } else {
          heroState = 'looping_end';
          loopCurrentFrame = 239;
          loopDirection = -1;
          lastLoopTickTime = performance.now();
          upScrollCount = 0;
          requestAnimationFrame(runEndStateLoop);
        }
      }

      function runEndStateLoop(now) {
        if (heroState !== 'looping_end') return;

        if (now - lastLoopTickTime >= LOOP_FRAME_INTERVAL) {
          lastLoopTickTime = now;
          loopCurrentFrame += loopDirection;

          if (loopCurrentFrame <= LOOP_START_FRAME) {
            loopCurrentFrame = LOOP_START_FRAME;
            loopDirection = 1;
          } else if (loopCurrentFrame >= LOOP_END_FRAME) {
            loopCurrentFrame = LOOP_END_FRAME;
            loopDirection = -1;
          }

          drawFrame(loopCurrentFrame);
        }

        requestAnimationFrame(runEndStateLoop);
      }

      // =========================================
      // 5. TWO-UP-SCROLL RESET & SCROLL TRANSITION
      // =========================================
      let reverseStartTime = 0;
      let reverseStartFrame = 0;
      let reverseDuration = 2600;

      function triggerReverseSequence() {
        if (heroState !== 'looping_end') return;
        heroState = 'transitioning_reverse';

        reverseStartFrame = currentFrameIndex;
        reverseStartTime = performance.now();
        reverseDuration = Math.max(1600, (reverseStartFrame / 239) * 2800);

        playReverseFrameLoop();
      }

      function playReverseFrameLoop() {
        if (heroState !== 'transitioning_reverse') return;

        const elapsed = performance.now() - reverseStartTime;
        let p = Math.min(1, elapsed / reverseDuration);

        const frameIndex = Math.max(0, Math.round(reverseStartFrame * (1 - p)));
        drawFrame(frameIndex);

        if (p < 1) {
          requestAnimationFrame(playReverseFrameLoop);
        } else {
          drawFrame(0);
          heroState = 'ready';
          upScrollCount = 0;

          if (scrollWidget) {
            scrollWidget.classList.remove('is-hidden');
            scrollWidget.classList.add('is-visible');
          }
        }
      }

      // WHEEL EVENT HANDLING:
      // While in Hero view at the top of document, scroll acts as interaction trigger.
      // Once portrait reaches Frame 240, subsequent scroll down smoothly scrolls page into Impact Metrics.
      window.addEventListener('wheel', (e) => {
        triggerHeroTicker();

        const isAtHeroTop = window.scrollY <= 10;

        if (isAtHeroTop) {
          if (e.deltaY > 0) {
            if (heroState === 'ready') {
              e.preventDefault();
              activateHeroSequence('scroll');
            } else if (heroState === 'transitioning_forward') {
              e.preventDefault();
            }
            // If heroState === 'looping_end', let the page naturally scroll down to Impact Metrics!
          } else if (e.deltaY < -15) {
            if (heroState === 'looping_end') {
              const now = performance.now();
              if (now - lastUpScrollTime > 1600) {
                upScrollCount = 0;
              }
              lastUpScrollTime = now;
              upScrollCount++;

              if (upScrollCount >= 2) {
                upScrollCount = 0;
                e.preventDefault();
                triggerReverseSequence();
              }
            }
          }
        }
      }, { passive: false });

      // CLICK ON SCROLL DOWN WIDGET
      if (scrollWidget) {
        scrollWidget.addEventListener('click', () => {
          triggerHeroTicker();
          if (heroState === 'ready') activateHeroSequence('click');
        });
      }

      // KEYBOARD TRIGGERS
      window.addEventListener('keydown', (e) => {
        triggerHeroTicker();

        if (window.scrollY <= 10) {
          if (e.key === 'ArrowDown' || e.key === ' ' || e.key === 'PageDown' || e.key === 'Enter') {
            if (heroState === 'ready') {
              e.preventDefault();
              activateHeroSequence('key');
            }
          } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
            if (heroState === 'looping_end') {
              upScrollCount++;
              if (upScrollCount >= 2) {
                upScrollCount = 0;
                e.preventDefault();
                triggerReverseSequence();
              }
            }
          }
        }
      });

      // MEANINGFUL MOUSE MOVEMENT TRIGGER
      let accumulatedDistance = 0;
      let prevMouseX = null, prevMouseY = null;
      const MOUSE_ACTIVATION_THRESHOLD = 320;

      window.addEventListener('mousemove', (e) => {
        if (prevMouseX !== null && prevMouseY !== null) {
          const dx = Math.abs(e.clientX - prevMouseX);
          const dy = Math.abs(e.clientY - prevMouseY);
          accumulatedDistance += Math.sqrt(dx * dx + dy * dy);
          if (accumulatedDistance > MOUSE_ACTIVATION_THRESHOLD) {
            triggerHeroTicker();
            if (heroState === 'ready') {
              activateHeroSequence('mouse_movement');
            }
          }
        }
        prevMouseX = e.clientX;
        prevMouseY = e.clientY;
      }, { passive: true });

      // HEADER ADAPTIVE THEME ON SCROLL
      const heroHeader = document.getElementById('hero-header');
      window.addEventListener('scroll', () => {
        if (!heroHeader) return;
        const triggerThreshold = window.innerHeight * 0.65;
        if (window.scrollY > triggerThreshold) {
          heroHeader.classList.add('is-light-mode');
        } else {
          heroHeader.classList.remove('is-light-mode');
        }
      }, { passive: true });

      // =========================================
      // 6. FERROFLUID PARTICLE TYPOGRAPHY
      //    (PREVIOUS LARGER SCALE, EXACT ANTON FONT, MAGNETIC REPULSION)
      // =========================================
      const nameWrap = document.getElementById('hero-name-wrap');
      const pCanvas = document.getElementById('name-particle-canvas');
      const pCtx = pCanvas ? pCanvas.getContext('2d') : null;

      let nameParticles = [];
      let isMouseOverName = false;
      let nameMouseX = -10000;
      let nameMouseY = -10000;
      let nameCanvasWidth = 0;
      let nameCanvasHeight = 0;
      let particleEngineInitialized = false;

      const LINE1_TEXT = "CHITHAMBARAM";
      const LINE2_TEXT = "BALA KRISHNAN";

      function initParticleTypography() {
        if (!pCanvas || !pCtx) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = nameWrap.getBoundingClientRect();
        nameCanvasWidth = rect.width || 480;
        
        // Exact previous larger Anton scale
        const fs1 = Math.round(Math.min(nameCanvasWidth * 0.098, 48));
        const fs2 = Math.round(Math.min(nameCanvasWidth * 0.138, 66));
        const totalHeight = Math.round(fs1 + fs2 + 20);

        nameCanvasHeight = totalHeight;
        nameWrap.style.height = `${nameCanvasHeight}px`;

        pCanvas.width = Math.round(nameCanvasWidth * dpr);
        pCanvas.height = Math.round(nameCanvasHeight * dpr);
        pCanvas.style.width = `${nameCanvasWidth}px`;
        pCanvas.style.height = `${nameCanvasHeight}px`;

        pCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Offscreen canvas for typography pixel sampling
        const off = document.createElement('canvas');
        off.width = Math.round(nameCanvasWidth * dpr);
        off.height = Math.round(nameCanvasHeight * dpr);
        const offCtx = off.getContext('2d');
        offCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        offCtx.fillStyle = '#ffffff';
        offCtx.textBaseline = 'top';

        // 1. Draw Line 1 (CHITHAMBARAM)
        offCtx.font = `400 ${fs1}px 'Anton', -apple-system, sans-serif`;
        const l1Y = 0;
        offCtx.fillText(LINE1_TEXT, 0, l1Y);

        const l1CharBounds = [];
        let currX1 = 0;
        for (let i = 0; i < LINE1_TEXT.length; i++) {
          const ch = LINE1_TEXT[i];
          const w = offCtx.measureText(ch).width;
          l1CharBounds.push({ ch, minX: currX1, maxX: currX1 + w, line: 1, idx: i });
          currX1 += w;
        }

        // 2. Draw Line 2 (BALA KRISHNAN)
        offCtx.font = `400 ${fs2}px 'Anton', -apple-system, sans-serif`;
        const l2Y = fs1 + 6;
        offCtx.fillText(LINE2_TEXT, 0, l2Y);

        const l2CharBounds = [];
        let currX2 = 0;
        for (let i = 0; i < LINE2_TEXT.length; i++) {
          const ch = LINE2_TEXT[i];
          const w = offCtx.measureText(ch).width;
          l2CharBounds.push({ ch, minX: currX2, maxX: currX2 + w, line: 2, idx: i });
          currX2 += w;
        }

        // 3. Scan pixels at fine step to generate dense particle coordinates
        const imgData = offCtx.getImageData(0, 0, off.width, off.height).data;
        nameParticles = [];

        const sampleStep = 2.4;
        const pSize = 1.95;

        for (let y = 0; y < nameCanvasHeight; y += sampleStep) {
          for (let x = 0; x < nameCanvasWidth; x += sampleStep) {
            const pxX = Math.round(x * dpr);
            const pxY = Math.round(y * dpr);
            const idx = (pxY * off.width + pxX) * 4;

            if (idx < imgData.length && imgData[idx + 3] > 110) {
              let charInfo = null;
              if (y < l2Y) {
                for (const b of l1CharBounds) {
                  if (x >= b.minX - 0.5 && x <= b.maxX + 0.5) {
                    charInfo = b;
                    break;
                  }
                }
              } else {
                for (const b of l2CharBounds) {
                  if (x >= b.minX - 0.5 && x <= b.maxX + 0.5) {
                    charInfo = b;
                    break;
                  }
                }
              }

              nameParticles.push({
                originX: x,
                originY: y,
                x: x,
                y: y + 24,
                vx: 0,
                vy: 0,
                size: pSize,
                line: charInfo ? charInfo.line : (y < l2Y ? 1 : 2),
                charIdx: charInfo ? charInfo.idx : 0,
                assembled: false
              });
            }
          }
        }

        particleEngineInitialized = true;
      }

      function triggerParticleNameEntrance() {
        if (!nameParticles.length) return;

        for (let i = 0; i < LINE1_TEXT.length; i++) {
          setTimeout(() => {
            for (let j = 0; j < nameParticles.length; j++) {
              const p = nameParticles[j];
              if (p.line === 1 && p.charIdx === i) {
                p.assembled = true;
              }
            }
          }, 80 + i * 32);
        }

        for (let i = 0; i < LINE2_TEXT.length; i++) {
          setTimeout(() => {
            for (let j = 0; j < nameParticles.length; j++) {
              const p = nameParticles[j];
              if (p.line === 2 && p.charIdx === i) {
                p.assembled = true;
              }
            }
          }, 460 + i * 28);
        }
      }

      if (nameWrap) {
        nameWrap.addEventListener('mouseenter', (e) => {
          isMouseOverName = true;
          const rect = nameWrap.getBoundingClientRect();
          nameMouseX = e.clientX - rect.left;
          nameMouseY = e.clientY - rect.top;
        });

        nameWrap.addEventListener('mousemove', (e) => {
          isMouseOverName = true;
          const rect = nameWrap.getBoundingClientRect();
          nameMouseX = e.clientX - rect.left;
          nameMouseY = e.clientY - rect.top;
        });

        nameWrap.addEventListener('mouseleave', () => {
          isMouseOverName = false;
          nameMouseX = -10000;
          nameMouseY = -10000;
        });
      }

      function renderParticleTypography() {
        if (!particleEngineInitialized || !pCtx) {
          requestAnimationFrame(renderParticleTypography);
          return;
        }

        pCtx.clearRect(0, 0, nameCanvasWidth, nameCanvasHeight);

        const REPULSION_RADIUS = 68;
        const SPRING_K = 0.082;
        const DAMPING = 0.81;

        for (let i = 0; i < nameParticles.length; i++) {
          const p = nameParticles[i];
          if (!p.assembled) continue;

          // Ferrofluid magnetic repulsion on individual local region
          if (isMouseOverName) {
            const dx = p.x - nameMouseX;
            const dy = p.y - nameMouseY;
            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < REPULSION_RADIUS && dist > 0.01) {
              const norm = (REPULSION_RADIUS - dist) / REPULSION_RADIUS;
              const force = Math.pow(norm, 1.7) * 7.4;
              const angle = Math.atan2(dy, dx);

              p.vx += Math.cos(angle) * force;
              p.vy += Math.sin(angle) * force;
            }
          }

          // Spring return toward home position
          const homeDx = p.originX - p.x;
          const homeDy = p.originY - p.y;

          p.vx += homeDx * SPRING_K;
          p.vy += homeDy * SPRING_K;

          p.vx *= DAMPING;
          p.vy *= DAMPING;

          p.x += p.vx;
          p.y += p.vy;

          pCtx.fillStyle = '#ffffff';
          pCtx.fillRect(p.x, p.y, p.size, p.size);
        }

        requestAnimationFrame(renderParticleTypography);
      }

      document.fonts.ready.then(() => {
        initParticleTypography();
        requestAnimationFrame(renderParticleTypography);
      });

      window.addEventListener('resize', () => {
        if (document.fonts.status === 'loaded') {
          initParticleTypography();
          for (let i = 0; i < nameParticles.length; i++) {
            nameParticles[i].assembled = true;
            nameParticles[i].y = nameParticles[i].originY;
          }
        }
      }, { passive: true });

      // =========================================
      // 7. TYPEWRITER CONTENT REVEAL & AUDIO
      // =========================================
      let audioCtx = null;
      function playTypewriterTick() {
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(750 + Math.random() * 250, audioCtx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(100, audioCtx.currentTime + 0.012);
          gain.gain.setValueAtTime(0.018, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.012);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 0.014);
        } catch(e) {}
      }

      const stickyTypewriterEl = document.getElementById('sticky-body-typewriter');
      const FULL_STICKY_TEXT_PART1 = "It started with a simple curiosity to make, break, experiment, and create. Years later, that same instinct has evolved into a fascination with ";
      const FULL_STICKY_TEXT_BOLD = "art, technology, and the endless possibilities of Generative AI.";

      function startStickyTypewriter() {
        if (!stickyTypewriterEl) return;
        stickyTypewriterEl.innerHTML = "";

        let idx = 0;
        let boldIdx = 0;

        function typeNextChar() {
          if (idx < FULL_STICKY_TEXT_PART1.length) {
            stickyTypewriterEl.textContent += FULL_STICKY_TEXT_PART1[idx];
            if (idx % 2 === 0) playTypewriterTick();
            idx++;
            const delay = 18 + Math.random() * 22;
            setTimeout(typeNextChar, delay);
          } else if (boldIdx < FULL_STICKY_TEXT_BOLD.length) {
            if (boldIdx === 0) {
              const strongEl = document.createElement('strong');
              strongEl.id = 'sticky-type-bold';
              stickyTypewriterEl.appendChild(strongEl);
            }
            const strongEl = document.getElementById('sticky-type-bold');
            if (strongEl) {
              strongEl.textContent += FULL_STICKY_TEXT_BOLD[boldIdx];
            }
            if (boldIdx % 2 === 0) playTypewriterTick();
            boldIdx++;
            const delay = 18 + Math.random() * 24;
            setTimeout(typeNextChar, delay);
          }
        }

        setTimeout(typeNextChar, 180);
      }

      // =========================================
      // 8. OPENING SPLASH & REFINED HERO ENTRANCE
      // =========================================
      const centerSplash = document.getElementById('center-splash');
      const splashCanvas = document.getElementById('splash-particle-canvas');
      const qBracket = document.getElementById('q-bracket');
      const qText = document.getElementById('quote-text');
      const qBar = document.getElementById('q-bar');
      const stickyNote = document.getElementById('hero-sticky-note');
      const contactLinks = document.getElementById('contact-links');

      function initSplashParticles() {
        if (!splashCanvas) return;
        const sCtx = splashCanvas.getContext('2d');
        splashCanvas.width = window.innerWidth;
        splashCanvas.height = window.innerHeight;

        const particles = [];
        const numParticles = 65;

        for (let i = 0; i < numParticles; i++) {
          particles.push({
            x: window.innerWidth * 0.5 + (Math.random() - 0.5) * 260,
            y: window.innerHeight * 0.5 + (Math.random() - 0.5) * 80,
            vx: (Math.random() - 0.75) * 8,
            vy: (Math.random() - 0.5) * 5,
            size: Math.random() * 3 + 1.5,
            color: Math.random() > 0.7 ? '#ff3b30' : '#ffffff',
            alpha: Math.random() * 0.8 + 0.2
          });
        }

        let pStart = performance.now();
        function renderSplash(now) {
          const elapsed = now - pStart;
          sCtx.clearRect(0, 0, splashCanvas.width, splashCanvas.height);

          particles.forEach((p) => {
            if (elapsed > 450) {
              p.x += p.vx;
              p.y += p.vy;
              p.alpha *= 0.96;
            }
            sCtx.fillStyle = p.color;
            sCtx.globalAlpha = Math.max(0, p.alpha);
            sCtx.fillRect(p.x, p.y, p.size, p.size);
          });

          if (elapsed < 900) {
            requestAnimationFrame(renderSplash);
          } else {
            sCtx.clearRect(0, 0, splashCanvas.width, splashCanvas.height);
          }
        }
        requestAnimationFrame(renderSplash);
      }

      async function runMasterSequence() {
        await loadFrame(0);
        drawFrame(0);
        initSplashParticles();

        setTimeout(() => {
          centerSplash.style.opacity = '0';
          centerSplash.style.transform = 'scale(1.08)';

          setTimeout(() => {
            centerSplash.style.display = 'none';
          }, 350);

          triggerParticleNameEntrance();

          setTimeout(() => {
            if (qBracket) qBracket.classList.add('is-revealed');
            if (qText) qText.classList.add('is-revealed');
            if (qBar) qBar.classList.add('is-expanded');
          }, 750);

          setTimeout(() => {
            if (stickyNote) {
              stickyNote.classList.add('is-revealed');
              startStickyTypewriter();
            }
            if (contactLinks) contactLinks.classList.add('is-revealed');
          }, 1000);

          setTimeout(() => {
            if (scrollWidget) scrollWidget.classList.add('is-visible');
            heroState = 'ready';
          }, 1250);

          preloadAllFrames();

        }, 500);
      }

      runMasterSequence();

      // =========================================
      // 9. MY JOURNEY INTERACTIVE ARCHIVE DATA & WORKSPACE
      // =========================================
      const JOURNEY_COMPANIES = {
        dneg: {
          index: "04",
          name: "DNEG",
          role: "GENERATIVE AI ARTIST",
          dates: "JAN 2026 — APR 2026",
          location: "REMOTE · HOLLYWOOD VFX",
          isDneg: true,
          liveBadge: "MAJOR CREDENTIAL // CINEMA",
          projects: ["RAMAYANA", "DUNE 3", "THE ODYSSEY"],
          image: "dune-dneg.jpg",
          imageCaption: "DUNE 3 · LOOK-DEV & LARGE-SCALE VFX PIPELINE INTEGRATION",
          modules: [
            "PRODUCTION-GRADE GENAI",
            "CINEMATIC DIGITAL HUMANS",
            "IDENTITY + PERFORMANCE TRANSFER",
            "COMFYUI SYSTEMS",
            "FACE INGEST / FACE SWAP / LIP SYNC",
            "NUKE INTEGRATION",
            "VFX PIPELINE INTEGRATION"
          ],
          technologies: ["Metaphysic", "Brahma AI ecosystem", "MetaFace", "DGX", "ComfyUI", "Nuke"]
        },
        impromp2: {
          index: "03",
          name: "IMPROMP2LABS",
          role: "GEN AI CREATIVE LEAD",
          dates: "NOV 2025 — PRESENT",
          location: "HYDERABAD · HYBRID",
          isDneg: false,
          liveBadge: "ACTIVE PRODUCTION // SYSTEMS",
          projects: ["AI-DRIVEN CINEMATIC IP", "VISUAL WORLDS", "CHARACTER SYSTEMS", "MULTI-SHOT SEQUENCES"],
          image: null,
          imageCaption: "",
          modules: [
            "15+ PRODUCTION/R&D WORKFLOWS",
            "5 BUILT FROM SCRATCH",
            "7+ MODIFIED SYSTEMS",
            "60% FASTER CONCEPT GENERATION",
            "40% REDUCTION IN PROMPT ITERATION",
            "10+ ARTISTS MENTORED"
          ],
          technologies: ["ComfyUI", "SDXL", "LoRA Architecture", "Runway Gen-3", "Flux.1", "Python Scripting"]
        },
        cyberedge: {
          index: "02",
          name: "CYBEREDGE",
          role: "AI DESIGN ENGINEER",
          dates: "NOV 2024 — NOV 2025",
          location: "HYDERABAD · HYBRID",
          isDneg: false,
          liveBadge: "PRODUCTION SCALE // 450+ CREATIVES",
          projects: ["450+ AI CREATIVES", "250+ CAMPAIGNS", "80+ CLIENTS"],
          image: null,
          imageCaption: "",
          modules: [
            "AI CREATIVE WORKFLOWS",
            "CAMERA / COMPOSITION VARIATIONS",
            "LIGHTING / ENVIRONMENT VARIATIONS",
            "POST-PRODUCTION COMPOSITING",
            "35% PRODUCTION EFFICIENCY"
          ],
          technologies: ["Midjourney v6", "Adobe Firefly", "Photoshop Generative Fill", "After Effects", "Magnific AI"]
        },
        premasai: {
          index: "01",
          name: "PREMA SAI DESIGNERS",
          role: "GRAPHIC DESIGNER",
          dates: "AUG 2018 — OCT 2024",
          location: "HYDERABAD · ONSITE",
          isDneg: false,
          liveBadge: "FOUNDATION CHAPTER // 6 YEARS",
          projects: ["AI-ASSISTED CREATIVE WORKFLOWS", "CANVA + AI PIPELINES", "ENTERPRISE BRAND SYSTEMS"],
          image: null,
          imageCaption: "",
          modules: [
            "BRAND IDENTITY ARCHITECTURE",
            "PACKAGING & MARKETING COLLATERAL",
            "25% TURNAROUND IMPROVEMENT",
            "35% CLIENT DIGITAL-REACH BOOST"
          ],
          technologies: ["Adobe Illustrator", "Photoshop", "InDesign", "CorelDraw", "Early GenAI Adoption"]
        }
      };

      const workspacePanelEl = document.getElementById('journey-workspace');
      const companyTabs = document.querySelectorAll('.company-row-item');

      function renderWorkspace(companyKey) {
        const data = JOURNEY_COMPANIES[companyKey] || JOURNEY_COMPANIES.dneg;
        if (!workspacePanelEl) return;

        let projectsHtml = "";
        data.projects.forEach((p, idx) => {
          projectsHtml += `<span class="dneg-proj-pill ${idx === 0 ? 'featured' : ''}">${p}</span>`;
        });

        let imageHtml = "";
        if (data.image) {
          imageHtml = `
            <div class="dneg-visual-box">
              <img src="${data.image}" alt="${data.name} Project Visual">
              <div class="dneg-visual-caption">${data.imageCaption}</div>
            </div>
          `;
        }

        let modulesHtml = "";
        data.modules.forEach(m => {
          modulesHtml += `<div class="ws-mod-tag">${m}</div>`;
        });

        let techHtml = "";
        data.technologies.forEach(t => {
          techHtml += `<span class="ws-tech-pill">${t}</span>`;
        });

        workspacePanelEl.style.opacity = '0';
        workspacePanelEl.style.transform = 'translateY(6px)';

        setTimeout(() => {
          workspacePanelEl.innerHTML = `
            <div class="ws-header">
              <div class="ws-meta-row">
                <span>CHAPTER // ${data.index} [${data.location}]</span>
                <span class="ws-badge-live">${data.liveBadge}</span>
              </div>
              <h3 class="ws-company-name">${data.name}</h3>
              <div class="ws-role-title">${data.role}</div>
            </div>

            ${imageHtml}

            <div class="evidence-label">
              <span>[◈] CORE PRODUCTION DOMAINS & DIRECT IMPACT</span>
            </div>

            <div class="dneg-projects-strip">
              ${projectsHtml}
            </div>

            <div class="ws-modular-grid">
              ${modulesHtml}
            </div>

            <div class="ws-tech-stack-row">
              <span class="ws-tech-label">STACK //</span>
              ${techHtml}
            </div>
          `;

          workspacePanelEl.style.opacity = '1';
          workspacePanelEl.style.transform = 'translateY(0)';
        }, 120);
      }

      // Initial render with DNEG
      renderWorkspace('dneg');

      // Company selection listeners (Hover previews, Click locks)
      companyTabs.forEach(tab => {
        const target = tab.getAttribute('data-target');

        tab.addEventListener('mouseenter', () => {
          companyTabs.forEach(t => {
            t.classList.remove('is-selected');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-selected');
          tab.setAttribute('aria-selected', 'true');
          renderWorkspace(target);
        });

        tab.addEventListener('click', () => {
          companyTabs.forEach(t => {
            t.classList.remove('is-selected');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-selected');
          tab.setAttribute('aria-selected', 'true');
          renderWorkspace(target);
        });

        tab.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            companyTabs.forEach(t => {
              t.classList.remove('is-selected');
              t.setAttribute('aria-selected', 'false');
            });
            tab.classList.add('is-selected');
            tab.setAttribute('aria-selected', 'true');
            renderWorkspace(target);
          }
        });
      });

    })();
  </script>

</body>
</html>
