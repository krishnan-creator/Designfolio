          location: "HYDERABAD · ONSITE",
          liveBadge: "FOUNDATION PRACTICE // 6 YEARS",
          statement: "Mastered the core disciplines of visual communication, typography, and identity architecture across six years of commercial design practice.",
          keyPoints: [
            "Built end-to-end brand identity systems, typography, packaging, and commercial marketing collateral",
            "Pioneered early AI-assisted workflows, improving studio production turnaround by 25%",
            "Architected scalable Canva + AI design pipelines, boosting client digital reach by 35%"
          ],
          image: null,
          imageCaption: "",
          stack: ["Adobe Illustrator", "Photoshop", "InDesign", "CorelDraw", "Early GenAI"],
          output: ["Brand Identity Systems", "Marketing Collateral", "Packaging", "Pre-Press Masters"],
          process: ["Client Ingest → Typography & Grid → Scalable Asset System → Pre-Press & Digital Rollout"]
        }
      };

      const workspacePanelEl = document.getElementById('journey-workspace');
      const companyTabs = document.querySelectorAll('.company-row-item');

      function renderJourneyWorkspace(companyKey) {
        const data = JOURNEY_COMPANIES[companyKey] || JOURNEY_COMPANIES.dneg;
        if (!workspacePanelEl) return;

        let pointsHtml = "";
        data.keyPoints.forEach(pt => {
          pointsHtml += `
            <div class="ws-point-item">
              <span class="ws-point-bullet">[◈]</span>
              <span>${pt}</span>
            </div>
          `;
        });

        let imageHtml = "";
        if (data.image) {
          imageHtml = `
            <div class="dneg-visual-box">
              <img src="${data.image}" alt="${data.name} Project Visual">
              <div class="dneg-visual-caption">${data.imageCaption}</div>
            </div>
          `;
        }

        let stackHtml = data.stack.map(s => `<span class="ws-chip-pill">${s}</span>`).join('');
        let outputHtml = data.output.map(o => `<span class="ws-chip-pill">${o}</span>`).join('');
        let processHtml = data.process.map(p => `<span class="ws-chip-pill" style="color: var(--dbl-text-primary);">${p}</span>`).join('');

        workspacePanelEl.style.opacity = '0';
        workspacePanelEl.style.transform = 'translateY(6px)';

        setTimeout(() => {
          workspacePanelEl.innerHTML = `
            <div class="ws-header">
              <div class="ws-meta-row">
                <span>CHAPTER // ${data.index} · ${data.chapterLabel} [${data.location}]</span>
                <span class="ws-badge-live">${data.liveBadge}</span>
              </div>
              <h3 class="ws-company-name">${data.name}</h3>
              <div class="ws-role-title">${data.role} · <span style="color: var(--dbl-text-tertiary); font-weight: 500;">${data.dates}</span></div>
            </div>

            <div class="ws-statement-lead">
              ${data.statement}
