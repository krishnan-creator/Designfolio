        {
          id: "portrait-04",
          imageSrc: "portrait-04.jpg",
          orientation: "portrait",
          title: "DIVINE ARCHER BOW PROFILE",
          category: "CHARACTER DESIGNS // ARCHER",
          phase: "PIPELINE // PORTRAIT-04",
          desc: "Full-profile divine warrior drawn bow with golden light rays and ornate crown ornamentation.",
          tags: ["PORTRAIT", "DIVINE ARCHER", "CHARACTER DESIGN"]
        },
        {
          id: "portrait-05",
          imageSrc: "portrait-05.jpg",
          orientation: "portrait",
          title: "DUNE WANDERER UNDER TWIN MOONS",
          category: "ATMOSPHERIC SCENES // NOMAD",
          phase: "PIPELINE // PORTRAIT-05",
          desc: "Solitary cloaked explorer standing atop desert ridges under twin celestial moons with volumetric haze.",
          tags: ["PORTRAIT", "DUNE WANDERER", "ATMOSPHERIC"]
        },
        {
          id: "portrait-06",
          imageSrc: "portrait-06.jpg",
          orientation: "portrait",
          title: "DESERT SCOUTS EXPEDITION",
          category: "WORLDBUILDING ARTWORK // EXPEDITION",
          phase: "PIPELINE // PORTRAIT-06",
          desc: "Pair of cloaked desert navigators surveying vast wind-carved dune horizons under alien sky.",
          tags: ["PORTRAIT", "WORLDBUILDING", "EXPEDITION"]
        },
        {
          id: "portrait-07",
          imageSrc: "portrait-07.jpg",
          orientation: "portrait",
          title: "OBSIDIAN PYRAMID PORTAL",
          category: "ARCHITECTURE // PORTAL",
          phase: "PIPELINE // PORTRAIT-07",
          desc: "Brutalist obsidian monolith standing tall with glowing red central gate against swirling sky.",
          tags: ["PORTRAIT", "MONOLITH", "ARCHITECTURE"]
        },
        {
          id: "portrait-08",
          imageSrc: "portrait-08.jpg",
          orientation: "portrait",
          title: "STRATOSPHERIC TETHER COLUMN",
          category: "ATMOSPHERIC SCENES // MEGA-STRUCTURE",
          phase: "PIPELINE // PORTRAIT-08",
          desc: "Vertical engineering tower rising through multi-tiered cloud layers into upper orbit.",
          tags: ["PORTRAIT", "MEGA-STRUCTURE", "SCI-FI"]
        },
        {
          id: "portrait-09",
          imageSrc: "portrait-09.jpg",
          orientation: "portrait",
          title: "BIOMECHANICAL NEURAL CORE",
          category: "MATERIAL & LIGHTING STUDIES // BIOMECH",
          phase: "PIPELINE // PORTRAIT-09",
          desc: "Organic computing architecture with pulsing cyan conduits, fibrous cables, and dark metal alloy.",
          tags: ["PORTRAIT", "NEURAL CORE", "MATERIAL STUDY"]
        },
        {
          id: "portrait-10",
          imageSrc: "portrait-10.jpg",
          orientation: "portrait",
          title: "CELESTIAL CITADEL SPIRES",
          category: "WORLDBUILDING ARTWORK // SACRED CITADEL",
          phase: "PIPELINE // PORTRAIT-10",
          desc: "Tiered sacred temple towers silhouetted against glowing sunburst and misty waterfalls.",
          tags: ["PORTRAIT", "WORLDBUILDING", "CITADEL"]
        }
      ];
      window.PIPELINE_ARCHIVE_DATA = PIPELINE_ARCHIVE_DATA;

      // Preload images
      const loadedSphereImages = new Map();
      PIPELINE_ARCHIVE_DATA.forEach(item => {
        const img = new Image();
        img.src = item.imageSrc;
        loadedSphereImages.set(item.imageSrc, img);
      });

      // Distribute exactly 20 nodes on 3D Fibonacci Sphere
      const SPHERE_NODE_COUNT = 20;
      const sphereNodes = [];
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));

      for (let i = 0; i < SPHERE_NODE_COUNT; i++) {
        const y = 1 - (i / (SPHERE_NODE_COUNT - 1)) * 2;
        const radiusAtY = Math.sqrt(1 - y * y);
        const theta = goldenAngle * i;
        const x = Math.cos(theta) * radiusAtY;
        const z = Math.sin(theta) * radiusAtY;

        const dataItem = PIPELINE_ARCHIVE_DATA[i];
        const isLandscape = dataItem.orientation === 'landscape';

        sphereNodes.push({
          nx: x,
          ny: y,
          nz: z,
          data: dataItem,
          cardW: isLandscape ? 134 : 84,
          cardH: isLandscape ? 84 : 126,
          hoverScale: 1
        });
      }
      window.sphereNodes = sphereNodes;

      let sphereRotX = 0.2;
      let sphereRotY = 0;
      let sphereVelX = 0;
      let sphereVelY = 0.0022;
      let isDraggingSphere = false;
      let dragLastX = 0;
      let dragLastY = 0;
      let hoveredSphereNode = null;
      let selectedSphereNode = null;
      let activePipelineFilter = 'all';

      // Filter Buttons wiring
      const filterBtns = document.querySelectorAll('.pipeline-filter-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          activePipelineFilter = btn.getAttribute('data-filter') || 'all';
        });
      });

      function resizeSphereCanvas() {
        if (!sphereCanvas || !sphereContainer) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = sphereContainer.getBoundingClientRect();
        sphereCanvas.width = Math.round(rect.width * dpr);
        sphereCanvas.height = Math.round(rect.height * dpr);
        if (sCtx) sCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resizeSphereCanvas();
      window.addEventListener('resize', resizeSphereCanvas, { passive: true });

      function renderPipelineSphere() {
        if (!sCtx || !sphereCanvas || !sphereContainer) return;
        const rect = sphereContainer.getBoundingClientRect();
        const w = rect.width;
        const h = rect.height;
        const cx = w * 0.5;
        const cy = h * 0.5;
        const sphereRadius = Math.min(w * 0.38, h * 0.40, 310);
        const fov = 500;

        sCtx.clearRect(0, 0, w, h);

        if (!isDraggingSphere) {
          sphereRotY += sphereVelY;
          sphereRotX += sphereVelX;
          sphereVelY = sphereVelY * 0.94 + 0.00012;
          sphereVelX *= 0.92;
        }

        sphereRotX = Math.max(-0.85, Math.min(0.85, sphereRotX));

        const cosX = Math.cos(sphereRotX);
        const sinX = Math.sin(sphereRotX);
        const cosY = Math.cos(sphereRotY);
        const sinY = Math.sin(sphereRotY);

        const projectedNodes = [];

        for (let i = 0; i < sphereNodes.length; i++) {
          const node = sphereNodes[i];
          const matchesFilter = activePipelineFilter === 'all' || node.data.orientation === activePipelineFilter;

          const x1 = node.nx * cosY - node.nz * sinY;
          const z1 = node.nx * sinY + node.nz * cosY;
          const y2 = node.ny * cosX - z1 * sinX;
          const z2 = node.ny * sinX + z1 * cosX;

          const px = x1 * sphereRadius;
          const py = y2 * sphereRadius;
          const pz = z2 * sphereRadius;

          const depth = pz + fov;
          const scale = depth > 30 ? (fov / depth) : 0;
          const sx = cx + px * scale;
          const sy = cy + py * scale;

          let alpha = Math.max(0.20, Math.min(1, (pz + sphereRadius) / (sphereRadius * 2) * 0.85 + 0.15));
          if (!matchesFilter) alpha *= 0.10;

          projectedNodes.push({
            node,
            sx,
            sy,
            scale,
            z: pz,
            alpha,
            matchesFilter
          });
        }

        // Painter's algorithm
        projectedNodes.sort((a, b) => a.z - b.z);

        // Subtle structural wireframe boundary ring
        sCtx.save();
        sCtx.strokeStyle = 'rgba(255, 48, 56, 0.08)';
        sCtx.lineWidth = 1;
        sCtx.beginPath();
        sCtx.arc(cx, cy, sphereRadius * 0.95, 0, Math.PI * 2);
        sCtx.stroke();
        sCtx.restore();

        for (let i = 0; i < projectedNodes.length; i++) {
          const p = projectedNodes[i];
          const node = p.node;
          const isHovered = hoveredSphereNode === node;
          const isSelected = selectedSphereNode === node;

          const cardW = Math.round((node.cardW * p.scale) * (isHovered ? 1.15 : 1));
          const cardH = Math.round((node.cardH * p.scale) * (isHovered ? 1.15 : 1));
          const x = p.sx - cardW * 0.5;
          const y = p.sy - cardH * 0.5;

          sCtx.save();
          sCtx.globalAlpha = p.alpha;

          sCtx.fillStyle = isHovered ? '#1c1c24' : '#0c0c10';
          sCtx.strokeStyle = isSelected 
            ? '#FF3038' 
            : (isHovered ? 'rgba(255, 255, 255, 0.95)' : 'rgba(255, 255, 255, 0.20)');
          sCtx.lineWidth = isSelected ? 2.5 : (isHovered ? 1.8 : 1);

          sCtx.beginPath();
          sCtx.roundRect(x, y, cardW, cardH, 4);
          sCtx.fill();
          sCtx.stroke();

          const img = loadedSphereImages.get(node.data.imageSrc);
          if (img && img.complete && img.naturalWidth > 0) {
            sCtx.save();
            sCtx.beginPath();
            sCtx.roundRect(x + 1.5, y + 1.5, cardW - 3, cardH - 3, 3);
            sCtx.clip();
            sCtx.drawImage(img, x + 1.5, y + 1.5, cardW - 3, cardH - 3);
            sCtx.restore();
          } else {
            sCtx.save();
            sCtx.fillStyle = node.data.orientation === 'landscape' ? '#181424' : '#141c24';
            sCtx.beginPath();
            sCtx.roundRect(x + 1.5, y + 1.5, cardW - 3, cardH - 3, 3);
            sCtx.fill();
            sCtx.restore();
          }

          if (isSelected) {
            sCtx.fillStyle = '#FF3038';
            sCtx.fillRect(x + cardW - 8, y + 4, 4, 4);
          } else if (isHovered) {
            sCtx.fillStyle = '#ffffff';
            sCtx.fillRect(x + cardW - 8, y + 4, 4, 4);
          }

          sCtx.restore();

          if (p.matchesFilter) {
            node._bounds = { x, y, w: cardW, h: cardH, z: p.z };
          } else {
            node._bounds = null;
          }
        }

        requestAnimationFrame(renderPipelineSphere);
      }
      requestAnimationFrame(renderPipelineSphere);

      function selectPipelineNode(node) {
        if (!node) return;
        selectedSphereNode = node;
        const d = node.data;
        if (inspectPhase) inspectPhase.textContent = d.phase;
        if (inspectTitle) inspectTitle.textContent = d.title;
        if (inspectDesc) inspectDesc.textContent = d.desc;
        const inspectImg = document.getElementById('inspect-image');
        if (inspectImg) {
          inspectImg.src = d.imageSrc;
          inspectImg.alt = d.title;
        }
        if (inspectTags) {
          inspectTags.innerHTML = d.tags.map(t => `<span class="inspect-tag">${t}</span>`).join('');
        }
        if (inspectPanel) {
          inspectPanel.classList.add('is-active');
          inspectPanel.classList.add('is-open');
        }
      }

      // Pre-select first node on load so inspector is populated and ready
      selectPipelineNode(sphereNodes[0]);

      // Drag to rotate sphere with inertia
      if (sphereContainer) {
        sphereContainer.addEventListener('mousedown', (e) => {
          isDraggingSphere = true;
          dragLastX = e.clientX;
          dragLastY = e.clientY;
          sphereVelX = 0;
          sphereVelY = 0;
        });

        window.addEventListener('mousemove', (e) => {
          if (isDraggingSphere) {
            const dx = e.clientX - dragLastX;
            const dy = e.clientY - dragLastY;
            sphereRotY += dx * 0.005;
            sphereRotX += dy * 0.005;
            sphereVelY = dx * 0.005;
            sphereVelX = dy * 0.005;
            dragLastX = e.clientX;
            dragLastY = e.clientY;
          } else if (sphereContainer) {
            const rect = sphereContainer.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;

            let hitNode = null;
            let maxZ = -9999;
            for (let i = 0; i < sphereNodes.length; i++) {
              const b = sphereNodes[i]._bounds;
              if (b && mx >= b.x && mx <= b.x + b.w && my >= b.y && my <= b.y + b.h) {
                if (b.z > maxZ) {
                  maxZ = b.z;
                  hitNode = sphereNodes[i];
                }
              }
            }
            hoveredSphereNode = hitNode;
            sphereContainer.style.cursor = hitNode ? 'pointer' : 'grab';
          }
        });

        window.addEventListener('mouseup', () => {
          if (isDraggingSphere) {
            isDraggingSphere = false;
          }
        });

        sphereContainer.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) {
            isDraggingSphere = true;
            dragLastX = e.touches[0].clientX;
            dragLastY = e.touches[0].clientY;
            sphereVelX = 0;
            sphereVelY = 0;
          }
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
          if (isDraggingSphere && e.touches.length === 1) {
            const dx = e.touches[0].clientX - dragLastX;
            const dy = e.touches[0].clientY - dragLastY;
            sphereRotY += dx * 0.006;
            sphereRotX += dy * 0.006;
            sphereVelY = dx * 0.006;
            sphereVelX = dy * 0.006;
            dragLastX = e.touches[0].clientX;
            dragLastY = e.touches[0].clientY;
          }
        }, { passive: true });

        window.addEventListener('touchend', () => {
          isDraggingSphere = false;
        });

        // Click to inspect focal card with authentic thumbnail
        sphereContainer.addEventListener('click', () => {
          if (hoveredSphereNode) {
            selectPipelineNode(hoveredSphereNode);
          }
        });
      }

      if (inspectClose && inspectPanel) {
        inspectClose.addEventListener('click', () => {
          inspectPanel.classList.remove('is-active');
          inspectPanel.classList.remove('is-open');
          selectedSphereNode = null;
        });
      }

      // ============================================================
      // 13B. SECTION 06 — DISCIPLINES: ASTRAL SHELL 3D CONNECTED GLOBE
      //      (Official React Bits Astral Shell Architecture:
      //       Preset: Violet, Network: #9C28FF, Highlight: #9C6B8C,
      //       ~1200 connected shell nodes, Tilt ~13°, Depth Fade 0.77,
      //       6 selectable discipline nodes, right-side contextual panel)
      // ============================================================
      const universeCanvas = document.getElementById('disciplines-universe-canvas');
      const universeContainer = document.getElementById('disciplines-universe-container');
      const dDetailPanel = document.getElementById('discipline-detail-panel');
      const dDetailCategory = document.getElementById('d-detail-category');
      const dDetailTitle = document.getElementById('d-detail-title');
      const dDetailDesc = document.getElementById('d-detail-desc');
      const dDetailImg = document.getElementById('d-detail-img');
      const dDetailChips = document.getElementById('d-detail-chips');
      const dDetailClose = document.getElementById('d-detail-close');
      const uCtx = universeCanvas ? universeCanvas.getContext('2d') : null;

      const DISCIPLINES_DATA = [
        {
          id: 0,
          name: "GENERATIVE AI",
          category: "DISCIPLINE // 01 · CORE ARCHITECTURE",
          title: "GENERATIVE AI CREATIVE DIRECTION",
          desc: "Architecting holistic AI aesthetic systems, scalable DGX model inference pipelines, and ComfyUI node networks from conceptual seed to studio deployment.",
          image: "Ramayana.png",
          chips: ["COMFYUI NETWORKS", "CUSTOM LORAS", "DGX CLUSTER", "PROMPT CACHING"],
          nx: 0.0, ny: 0.35, nz: 0.93
        },
        {
          id: 1,
          name: "CREATIVE DIRECTION",
          category: "DISCIPLINE // 02 · DIRECTION",
          title: "CREATIVE DIRECTION & BRAND ARCHITECTURE",
          desc: "Shaping holistic visual aesthetics, high-velocity concept decks, stylistic cohesion, and theatrical visual storytelling for global productions.",
          image: "dune-dneg.jpg",
          chips: ["CREATIVE DIRECTION", "STYLE COHESION", "EXECUTIVE DECKS", "THEATRICAL VISION"],
          nx: 0.85, ny: 0.22, nz: 0.46
        },
        {
          id: 2,
          name: "VISUAL DEVELOPMENT",
          category: "DISCIPLINE // 03 · VISDEV",
          title: "VISUAL DEVELOPMENT & WORLDBUILDING",
          desc: "Designing original mythic action IP, character sheets, costume micro-geometry, weapons, and multi-shot continuity look-dev decks.",
          image: "VeerBhadra.png",
          chips: ["IP WORLDBUILDING", "HERO CHARACTERS", "WEAPONS", "LOOK-DEV DECKS"],
          nx: -0.82, ny: 0.18, nz: 0.52
        },
        {
          id: 3,
          name: "AI FILMMAKING",
          category: "DISCIPLINE // 04 · CINEMA",
          title: "AI FILMMAKING & DIRECTING",
          desc: "Directing AI video synthesis across Runway Gen-3, Luma, and AnimateDiff pipelines with strict temporal stability and digital doubles identity preservation.",
          image: "ramayana-output.jpg",
          chips: ["RUNWAY GEN-3", "DIGITAL DOUBLES", "SHOT CONTINUITY", "THEATRICAL CINEMA"],
          nx: 0.55, ny: -0.72, nz: 0.41
        },
        {
          id: 4,
          name: "AI MOTION DESIGN",
          category: "DISCIPLINE // 05 · MOTION",
          title: "AI MOTION DESIGN & FLUID DYNAMICS",
          desc: "Simulating camera trajectory modeling, optical flow velocity interpolation, dynamic fluid physics, and temporal coherence experiments.",
          image: "test_frame_1.jpg",
          chips: ["TEMPORAL DYNAMICS", "OPTICAL FLOW", "CAMERA RIGGING", "FLUID PHYSICS"],
          nx: -0.58, ny: -0.68, nz: 0.45
        },
        {
          id: 5,
          name: "WORLD BUILDING",
          category: "DISCIPLINE // 06 · WORLDBUILDING",
          title: "ORIGINAL IP WORLDBUILDING",
          desc: "Crafting original mythic universe lore, architectural canons, sacred geometry, and comprehensive narrative world bibles.",
          image: "veerabhadra-output.jpg",
          chips: ["MYTHIC LORE", "WORLD BIBLES", "SACRED GEOMETRY", "IP CANON"],
          nx: 0.08, ny: 0.86, nz: -0.50
        }
      ];
      window.DISCIPLINES_DATA = DISCIPLINES_DATA;

      // Astral Shell Fibonacci Point Lattice (2,000 nodes, official React Bits Astral Shell specification)
      const ASTRAL_SHELL_COUNT = 2000;
      const astralShellNodes = [];
      const astralPhi = Math.PI * (3 - Math.sqrt(5));

      for (let i = 0; i < ASTRAL_SHELL_COUNT; i++) {
        const y = 1 - (i / (ASTRAL_SHELL_COUNT - 1)) * 2;
        const radiusAtY = Math.sqrt(1 - y * y);
        const theta = astralPhi * i;
        const x = Math.cos(theta) * radiusAtY;
        const z = Math.sin(theta) * radiusAtY;
        astralShellNodes.push({ nx: x, ny: y, nz: z });
      }
      window.astralShellNodes = astralShellNodes;

      // Astral Shell line connection pairs (reach = 0.22, connections = 3-4, violet filaments)
      const astralConnections = [];
      for (let i = 0; i < ASTRAL_SHELL_COUNT; i += 1) {
        let connCount = 0;
        for (let j = i + 1; j < ASTRAL_SHELL_COUNT && connCount < 3; j++) {
          const dx = astralShellNodes[i].nx - astralShellNodes[j].nx;
          const dy = astralShellNodes[i].ny - astralShellNodes[j].ny;
          const dz = astralShellNodes[i].nz - astralShellNodes[j].nz;
          const dist = Math.hypot(dx, dy, dz);
          if (dist < 0.22) {
            astralConnections.push([i, j]);
            connCount++;
          }
        }
      }
      window.astralConnections = astralConnections;

      let uRotX = 0.227; // Tilt ~13°
      let uRotY = 0;
      let uVelX = 0;
      let uVelY = 0.0024;
      let isDraggingUniverse = false;
      let uDragLastX = 0;
      let uDragLastY = 0;
      let uHoverNode = null;
      let uSelectedNode = null;

      function resizeUniverseCanvas() {
        if (!universeCanvas || !universeContainer) return;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = universeContainer.getBoundingClientRect();
        universeCanvas.width = Math.round(rect.width * dpr);
        universeCanvas.height = Math.round(rect.height * dpr);
        if (uCtx) uCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      resizeUniverseCanvas();
      window.addEventListener('resize', resizeUniverseCanvas, { passive: true });

      function renderAstralUniverse() {
        if (!uCtx || !universeCanvas || !universeContainer) return;

        if (!isDraggingUniverse) {
          uRotY += uVelY;
          uRotX += uVelX;
          uVelY = uVelY * 0.94 + 0.00012;
          uVelX *= 0.92;
        }

        uRotX = Math.max(-0.85, Math.min(0.85, uRotX));

        const rect = universeContainer.getBoundingClientRect();
        const w = rect.width;
        const h = rect.height;
        const cx = w * 0.44; // Placed left-of-center so detail card has room on right
        const cy = h * 0.50;
        const sphereRadius = Math.min(w * 0.38, h * 0.42, 280);
        const fov = 460;

        uCtx.clearRect(0, 0, w, h);

        const cosY = Math.cos(uRotY);
        const sinY = Math.sin(uRotY);
        const cosX = Math.cos(uRotX);
        const sinX = Math.sin(uRotX);

        // Project Astral Shell points
        const projShell = new Array(ASTRAL_SHELL_COUNT);
        for (let i = 0; i < ASTRAL_SHELL_COUNT; i++) {
          const n = astralShellNodes[i];
          const x1 = n.nx * cosY - n.nz * sinY;
          const z1 = n.nx * sinY + n.nz * cosY;
          const y2 = n.ny * cosX - z1 * sinX;
          const z2 = n.ny * sinX + z1 * cosX;

          const pz = z2 * sphereRadius;
          const depth = pz + fov;
          const scale = depth > 20 ? (fov / depth) : 0;
          const sx = cx + (x1 * sphereRadius) * scale;
          const sy = cy + (y2 * sphereRadius) * scale;

          // Depth fade (0.77 fade exponent)
          const normZ = (pz + sphereRadius) / (sphereRadius * 2);
          const alpha = Math.max(0.04, Math.pow(Math.max(0, normZ), 0.77) * 0.45);

          projShell[i] = { sx, sy, pz, alpha, scale };
        }

        // Draw Astral Shell violet network lines
        uCtx.lineWidth = 0.8;
        for (let k = 0; k < astralConnections.length; k++) {
          const [i, j] = astralConnections[k];
          const p1 = projShell[i];
          const p2 = projShell[j];
          if (p1.pz < -sphereRadius * 0.4 && p2.pz < -sphereRadius * 0.4) continue; // cull far back lines

          const lineAlpha = (p1.alpha + p2.alpha) * 0.5 * 0.40;
          uCtx.strokeStyle = `rgba(156, 40, 255, ${lineAlpha.toFixed(3)})`;
          uCtx.beginPath();
          uCtx.moveTo(p1.sx, p1.sy);
          uCtx.lineTo(p2.sx, p2.sy);
          uCtx.stroke();
        }

        // Draw subtle Astral Shell points with soft lavender highlight (#BFA2DB)
        for (let i = 0; i < ASTRAL_SHELL_COUNT; i += 2) {
          const p = projShell[i];
          if (p.alpha > 0.12) {
            uCtx.fillStyle = `rgba(191, 162, 219, ${p.alpha.toFixed(3)})`;
            uCtx.fillRect(p.sx - 0.6, p.sy - 0.6, 1.2, 1.2);
          }
        }

        // Project the 6 Selectable Discipline Nodes
        const projDisciplines = DISCIPLINES_DATA.map(node => {
          const x1 = node.nx * cosY - node.nz * sinY;
          const z1 = node.nx * sinY + node.nz * cosY;
          const y2 = node.ny * cosX - z1 * sinX;
          const z2 = node.ny * sinX + z1 * cosX;

          const pz = z2 * sphereRadius;
          const depth = pz + fov;
          const scale = depth > 20 ? (fov / depth) : 0;
          const sx = cx + (x1 * sphereRadius) * scale;
          const sy = cy + (y2 * sphereRadius) * scale;

          const normZ = (pz + sphereRadius) / (sphereRadius * 2);
          const alpha = Math.max(0.25, Math.pow(Math.max(0, normZ), 0.77));

          return { node, sx, sy, pz, scale, alpha };
        });

        projDisciplines.sort((a, b) => a.pz - b.pz);

        for (let i = 0; i < projDisciplines.length; i++) {
          const p = projDisciplines[i];
          const node = p.node;
          const isHovered = uHoverNode && uHoverNode.id === node.id;
          const isSelected = uSelectedNode && uSelectedNode.id === node.id;
          const isFrontFacing = p.pz > -sphereRadius * 0.35;

          const r = Math.round(18 * p.scale * (isHovered ? 1.35 : 1));

          uCtx.save();
          uCtx.globalAlpha = p.alpha;

          // Outer glowing orbital halo
          if (isHovered || isSelected) {
            uCtx.strokeStyle = isSelected ? '#FF3038' : '#9C28FF';
            uCtx.lineWidth = 2;
            uCtx.beginPath();
            uCtx.arc(p.sx, p.sy, r * 1.5, 0, Math.PI * 2);
            uCtx.stroke();
          }

          // Node core
          uCtx.fillStyle = isSelected ? '#FF3038' : (isHovered ? '#9C28FF' : '#14141c');
          uCtx.strokeStyle = isSelected ? '#ffffff' : (isHovered ? '#ffffff' : '#9C6B8C');
          uCtx.lineWidth = isHovered ? 2 : 1.2;
          uCtx.beginPath();
          uCtx.arc(p.sx, p.sy, r, 0, Math.PI * 2);
          uCtx.fill();
          uCtx.stroke();

          // Center glowing point
          uCtx.fillStyle = isSelected ? '#ffffff' : (isHovered ? '#ffffff' : '#9C28FF');
          uCtx.beginPath();
          uCtx.arc(p.sx, p.sy, 3.5 * p.scale, 0, Math.PI * 2);
          uCtx.fill();

          // Restrained readable typography label (when facing camera)
          if (isFrontFacing) {
            uCtx.font = `700 ${Math.max(9, Math.round(10.5 * p.scale))}px 'Space Grotesk', sans-serif`;
            uCtx.fillStyle = isSelected || isHovered ? '#ffffff' : '#C9C7C2';
            uCtx.textAlign = 'center';
            uCtx.textBaseline = 'top';
            uCtx.fillText(node.name, p.sx, p.sy + r + 6);
          }

          uCtx.restore();

          node._screen = { sx: p.sx, sy: p.sy, r: r + 16, z: p.pz };
        }

        requestAnimationFrame(renderAstralUniverse);
      }
      requestAnimationFrame(renderAstralUniverse);

      // Drag to rotate Astral Shell
      if (universeContainer) {
        universeContainer.addEventListener('mousedown', (e) => {
          isDraggingUniverse = true;
          uDragLastX = e.clientX;
          uDragLastY = e.clientY;
          uVelX = 0;
          uVelY = 0;
        });

        window.addEventListener('mousemove', (e) => {
          if (isDraggingUniverse) {
            const dx = e.clientX - uDragLastX;
            const dy = e.clientY - uDragLastY;
            uRotY += dx * 0.005;
            uRotX += dy * 0.005;
            uVelY = dx * 0.005;
            uVelX = dy * 0.005;
            uDragLastX = e.clientX;
            uDragLastY = e.clientY;
          } else if (universeContainer) {
            const rect = universeContainer.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;

            let hit = null;
            let maxZ = -9999;
            for (let i = 0; i < DISCIPLINES_DATA.length; i++) {
              const sc = DISCIPLINES_DATA[i]._screen;
              if (sc) {
                const d = Math.hypot(mx - sc.sx, my - sc.sy);
                if (d < sc.r && sc.z > maxZ) {
                  maxZ = sc.z;
                  hit = DISCIPLINES_DATA[i];
                }
              }
            }
            uHoverNode = hit;
            universeContainer.style.cursor = hit ? 'pointer' : 'grab';
          }
        });

        window.addEventListener('mouseup', () => {
          if (isDraggingUniverse) isDraggingUniverse = false;
        });

        universeContainer.addEventListener('touchstart', (e) => {
          if (e.touches.length === 1) {
            isDraggingUniverse = true;
            uDragLastX = e.touches[0].clientX;
            uDragLastY = e.touches[0].clientY;
            uVelX = 0;
            uVelY = 0;
          }
        }, { passive: true });

        window.addEventListener('touchmove', (e) => {
          if (isDraggingUniverse && e.touches.length === 1) {
            const dx = e.touches[0].clientX - uDragLastX;
            const dy = e.touches[0].clientY - uDragLastY;
            uRotY += dx * 0.006;
            uRotX += dy * 0.006;
            uVelY = dx * 0.006;
            uVelX = dy * 0.006;
            uDragLastX = e.touches[0].clientX;
            uDragLastY = e.touches[0].clientY;
          }
        }, { passive: true });

        window.addEventListener('touchend', () => {
          isDraggingUniverse = false;
        });

        function selectDisciplineNode(node) {
          if (!node) return;
          uSelectedNode = node;
          if (dDetailCategory) dDetailCategory.textContent = node.category;
          if (dDetailTitle) dDetailTitle.textContent = node.title;
          if (dDetailDesc) dDetailDesc.textContent = node.desc;
          if (dDetailImg) dDetailImg.src = node.image;
          if (dDetailChips) {
            dDetailChips.innerHTML = node.chips.map(c => `<span class="d-chip">${c}</span>`).join('');
          }
          if (dDetailPanel) {
            dDetailPanel.classList.add('is-active');
            dDetailPanel.classList.add('is-open');
          }
        }

        // Initialize with first discipline on load so right-side panel is always populated
        selectDisciplineNode(DISCIPLINES_DATA[0]);

        // Selecting a discipline opens contextual information panel on the RIGHT side
        universeContainer.addEventListener('click', () => {
          if (uHoverNode) {
            selectDisciplineNode(uHoverNode);
          }
        });
      }

      if (dDetailClose && dDetailPanel) {
        dDetailClose.addEventListener('click', () => {
          dDetailPanel.classList.remove('is-active');
          dDetailPanel.classList.remove('is-open');
          uSelectedNode = null;
        });
      }

      // ============================================================
      // 14. REUSABLE VIDEO & MEDIA COMPONENT ARCHITECTURE
      //     (Sections 53 & 54: Muted autoplay, loop, responsive,
      //      graceful image fallback, no empty broken players)
      // ============================================================
      window.CBK_MEDIA_REGISTRY = window.CBK_MEDIA_REGISTRY || {};

      window.registerMediaSlotVideo = function(slotName, videoUrl, posterUrl) {
        if (!slotName || !videoUrl) return;
        window.CBK_MEDIA_REGISTRY[slotName] = { url: videoUrl, poster: posterUrl || null };
        const el = document.querySelector(`[data-media-slot="${slotName}"]`);
        if (!el) return;

        const mediaContainer = el.querySelector('.film-media-wrap') || el.querySelector('.cinematic-stage') || el;
        const existingImg = mediaContainer.querySelector('img');
        const poster = posterUrl || (existingImg ? existingImg.src : '');

        let videoEl = mediaContainer.querySelector('.cbk-slot-video');
        if (!videoEl) {
          videoEl = document.createElement('video');
          videoEl.className = 'cbk-slot-video';
          videoEl.autoplay = true;
          videoEl.muted = true;
          videoEl.loop = true;
          videoEl.playsInline = true;
          videoEl.setAttribute('playsinline', '');
          videoEl.setAttribute('muted', '');
          videoEl.setAttribute('loop', '');
          videoEl.style.width = '100%';
          videoEl.style.height = '100%';
          videoEl.style.objectFit = 'cover';
          videoEl.style.display = 'block';

          if (existingImg) {
            existingImg.style.display = 'none';
            existingImg.insertAdjacentElement('beforebegin', videoEl);
          } else {
            mediaContainer.prepend(videoEl);
          }
        }
        videoEl.src = videoUrl;
        if (poster) videoEl.poster = poster;
      };

      Object.keys(window.CBK_MEDIA_REGISTRY).forEach((slot) => {
        const item = window.CBK_MEDIA_REGISTRY[slot];
        if (item && item.url) {
          window.registerMediaSlotVideo(slot, item.url, item.poster);
        }
      });

      // ============================================================
      // MONOCHROME GEOMETRIC IDENTITY — ISOMETRIC TRIANGLE LATTICE ENGINE
      // ============================================================
      function initMonochromeTriangleGrid() {
        const gridCanvas = document.getElementById('triangle-grid-canvas');
        const container = document.getElementById('triangle-grid-container');
        if (!gridCanvas || !container) return;

        const ctx = gridCanvas.getContext('2d');
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        let width = container.clientWidth;
        let height = container.clientHeight;

        let mouseGridX = -1000;
        let mouseGridY = -1000;
        let isHovered = false;

        let triangles = [];
        const side = 24; // Side length of equilateral triangle
        const h = side * Math.sin(Math.PI / 3); // ~20.78px height
        const halfSide = side / 2;

        function buildGrid() {
          width = container.clientWidth;
          height = container.clientHeight;
          if (width <= 0 || height <= 0) return;

          gridCanvas.width = Math.round(width * dpr);
          gridCanvas.height = Math.round(height * dpr);
          gridCanvas.style.width = `${width}px`;
          gridCanvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          triangles = [];
          const rows = Math.ceil(height / h) + 1;
          const cols = Math.ceil(width / halfSide) + 2;

          for (let r = 0; r < rows; r++) {
            const yTop = r * h;
            const yBottom = (r + 1) * h;
            for (let c = -1; c < cols; c++) {
              const xBase = c * halfSide;
              const isUp = (r + c) % 2 === 0;

              let x1, y1, x2, y2, x3, y3;
              if (isUp) {
                // Upward triangle: apex at top-center, base at bottom
                x1 = xBase + halfSide; y1 = yTop;
                x2 = xBase; y2 = yBottom;
                x3 = xBase + side; y3 = yBottom;
              } else {
                // Inverted triangle: base at top, apex at bottom-center
                x1 = xBase; y1 = yTop;
                x2 = xBase + side; y2 = yTop;
                x3 = xBase + halfSide; y3 = yBottom;
              }
              const cx = (x1 + x2 + x3) / 3;
              const cy = (y1 + y2 + y3) / 3;

              // Subtle intentional gaps for technical editorial character (Nothing / Dominik Fojcik style)
              const hasGap = (r * 11 + c * 7) % 23 === 0;

              triangles.push({
                x1, y1, x2, y2, x3, y3,
                cx, cy,
                isUp,
                hasGap,
                energy: 0,
                baseAlpha: hasGap ? 0.02 : 0.07
              });
            }
          }
        }

        buildGrid();
        window.addEventListener('resize', buildGrid, { passive: true });

        container.addEventListener('mousemove', (e) => {
          const rect = container.getBoundingClientRect();
          mouseGridX = e.clientX - rect.left;
          mouseGridY = e.clientY - rect.top;
          isHovered = true;
        });

        container.addEventListener('mouseleave', () => {
          isHovered = false;
          mouseGridX = -1000;
          mouseGridY = -1000;
        });

        const rippleRadius = 145;

        function renderGrid() {
          ctx.clearRect(0, 0, width, height);
          const isLight = document.documentElement.getAttribute('data-theme') === 'light';

          for (let i = 0; i < triangles.length; i++) {
            const tri = triangles[i];

            if (isHovered) {
              const dx = tri.cx - mouseGridX;
              const dy = tri.cy - mouseGridY;
              const dist = Math.hypot(dx, dy);

              if (dist < rippleRadius) {
                const norm = 1 - dist / rippleRadius;
                const targetEnergy = Math.pow(norm, 1.8) * 0.72;
                if (targetEnergy > tri.energy) {
                  tri.energy += (targetEnergy - tri.energy) * 0.35;
                }
              }
            }

            // Energy decay
            tri.energy *= 0.94;
            if (tri.energy < 0.005) tri.energy = 0;

            const currentAlpha = Math.min(0.85, tri.baseAlpha + tri.energy * (tri.hasGap ? 0.28 : 0.68));

            ctx.beginPath();
            ctx.moveTo(tri.x1, tri.y1);
            ctx.lineTo(tri.x2, tri.y2);
            ctx.lineTo(tri.x3, tri.y3);
            ctx.closePath();

            if (isLight) {
              // Light mode: matte black & graphite
              ctx.fillStyle = `rgba(17, 17, 21, ${currentAlpha.toFixed(3)})`;
              ctx.fill();
              if (tri.energy > 0.08) {
                ctx.strokeStyle = `rgba(17, 17, 21, ${(tri.energy * 0.40).toFixed(3)})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
              }
            } else {
              // Dark mode: muted white & soft gray
              ctx.fillStyle = `rgba(255, 255, 255, ${currentAlpha.toFixed(3)})`;
              ctx.fill();
              if (tri.energy > 0.08) {
                ctx.strokeStyle = `rgba(255, 255, 255, ${(tri.energy * 0.45).toFixed(3)})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
              }
            }
          }

          requestAnimationFrame(renderGrid);
        }
        requestAnimationFrame(renderGrid);
      }
      initMonochromeTriangleGrid();

    })();
  </script>

</body>
</html>
