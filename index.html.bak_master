                </div>
              </div>

              <div class="ws-pill-box">
                <div class="ws-pill-box-header">
                  <span class="box-dot">[◈]</span>
                  <span>PROCESS // PIPELINE FLOW</span>
                </div>
                <div class="ws-chips-row">
                  ${processHtml}
                </div>
              </div>
            </div>
          `;

          workspacePanelEl.style.opacity = '1';
          workspacePanelEl.style.transform = 'translateY(0)';
        }, 80);
      }

      renderJourneyWorkspace('dneg');

      companyTabs.forEach(tab => {
        const target = tab.getAttribute('data-target');

        tab.addEventListener('mouseenter', () => {
          companyTabs.forEach(t => {
            t.classList.remove('is-selected');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-selected');
          tab.setAttribute('aria-selected', 'true');
          renderJourneyWorkspace(target);
        });

        tab.addEventListener('click', () => {
          companyTabs.forEach(t => {
            t.classList.remove('is-selected');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('is-selected');
          tab.setAttribute('aria-selected', 'true');
          renderJourneyWorkspace(target);
        });
      });

      // ============================================================
      // ============================================================
      // ============================================================
      // 13. SECTION 05 — THE PIPELINE: 50-ITEM 3D IMAGE SPHERE
      //     - Exactly 50 items (25 landscape, 25 portrait)
      //     - Replaceable structured data archive
      //     - Preserves true landscape vs portrait proportions
      //     - 3D Fibonacci sphere distribution with inertia rotation
      //     - Landscape / Portrait filter controls
      //     - Focal card inspection & contextual note
      // ============================================================
      const sphereCanvas = document.getElementById('pipeline-3d-sphere-canvas');
      const sphereContainer = document.getElementById('pipeline-sphere-container');
      const inspectPanel = document.getElementById('pipeline-inspect-panel');
      const inspectPhase = document.getElementById('inspect-phase');
