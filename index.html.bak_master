<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>C. Bala Krishnan — CBK Designfolio | Creative Director & Visual Artist</title>

  <!-- Early Theme Restoration to Prevent Flash of Unstyled Theme -->
  <script>
    (function() {
      try {
        const t = localStorage.getItem('dbl-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      } catch(e) {}
    })();
  </script>

  <!-- Google Fonts: Space Grotesk, JetBrains Mono, Barlow Condensed (Gondens fallback), Bebas Neue, Caveat & Alex Brush (Quote script) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Barlow+Condensed:wght@800;900&family=Bebas+Neue&family=Caveat:wght@600;700&family=Great+Vibes&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'Gondens';
      src: local('Gondens'), local('Gondens DEMO'), local('Gondens-Bold'), local('Gondens Bold');
      font-weight: 800 900;
      font-style: normal;
    }

    @font-face {
      font-family: 'Great Day';
      src: local('Great Day'), local('Great Day Personal Use'), local('GreatDay');
      font-weight: normal;
      font-style: normal;
    }

    /* ============================================================
       01. DBL (DARK + BALANCED + LUXURY) DESIGN TOKENS — V3
       ============================================================ */
    :root {
      /* Typography Architecture */
      --font-gondens: 'Gondens', 'Barlow Condensed', 'Bebas Neue', sans-serif;
      --font-quote: 'Caveat', 'Great Day', 'Alex Brush', cursive;
      --font-sticky-body: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      /* Dark Theme (Default) */
      --dbl-bg-root: #0B0B0D;
      --dbl-bg-section: #101012;
      --dbl-surface-matte: #151519;
      --dbl-surface-charcoal: #1A1A1F;
      --dbl-surface-graphite: #212127;
      --dbl-surface-elevated: #292930;
      --dbl-surface-active: #32323B;

      /* Dividers and Hairline Structural Borders */
      --dbl-border-subtle: rgba(255, 255, 255, 0.05);
      --dbl-border-base: rgba(255, 255, 255, 0.09);
      --dbl-border-strong: rgba(255, 255, 255, 0.18);
      --dbl-border-hover: rgba(255, 255, 255, 0.32);

      /* Typography */
      --dbl-text-primary: #F3F3F1;
      --dbl-text-secondary: #8A8A90;
      --dbl-text-tertiary: #686875;
      --dbl-text-dim: rgba(255, 255, 255, 0.38);

      /* Controlled Crimson Accent (Active Signal Only) */
      --dbl-crimson: #FF3038;
      --dbl-crimson-subtle: rgba(255, 48, 56, 0.12);
      --dbl-crimson-border: rgba(255, 48, 56, 0.42);
      --dbl-crimson-glow: rgba(255, 48, 56, 0.28);

      --dbl-theme-transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                              color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                              border-color 0.4s ease,
                              box-shadow 0.4s ease;
    }

    /* Light Theme (Deliberate Editorial Light Mode) */
    [data-theme="light"] {
      --dbl-bg-root: #F4F2EE;
      --dbl-bg-section: #EBE9E5;
      --dbl-surface-matte: #FFFFFF;
      --dbl-surface-charcoal: #F8F7F4;
      --dbl-surface-graphite: #E4E2DE;
      --dbl-surface-elevated: #DDD9D3;
      --dbl-surface-active: #D4D0C8;

      --dbl-border-subtle: rgba(0, 0, 0, 0.06);
      --dbl-border-base: #C9C7C2;
      --dbl-border-strong: rgba(0, 0, 0, 0.22);
      --dbl-border-hover: rgba(0, 0, 0, 0.38);

      --dbl-text-primary: #111113;
      --dbl-text-secondary: #67676C;
      --dbl-text-tertiary: #848492;
      --dbl-text-dim: rgba(0, 0, 0, 0.42);

      --dbl-crimson: #D9242C;
      --dbl-crimson-subtle: rgba(217, 36, 44, 0.09);
      --dbl-crimson-border: rgba(217, 36, 44, 0.38);
      --dbl-crimson-glow: rgba(217, 36, 44, 0.2);
    }

    [data-theme="light"] .company-row-item,
    [data-theme="light"] .career-positioning-card,
    [data-theme="light"] .career-evolution-strip,
    [data-theme="light"] .journey-workspace-panel,
    [data-theme="light"] .metric-module,
    [data-theme="light"] .mywork-card {
      background: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      border-color: rgba(0, 0, 0, 0.12) !important;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      background: var(--dbl-bg-root);
      color: var(--dbl-text-primary);
      transition: var(--dbl-theme-transition);
    }

    body {
      width: 100%;
      min-height: 100%;
      background: var(--dbl-bg-root);
      color: var(--dbl-text-primary);
      font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow-x: hidden;
      user-select: none;
      -webkit-user-select: none;
      transition: var(--dbl-theme-transition);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* ============================================================
       02. CIRCULAR THEME REVEAL
       ============================================================ */

    /* CIRCULAR THEME TRANSITION CURTAIN */
    #theme-circle-curtain {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 99998;
      pointer-events: none;
      opacity: 0;
      clip-path: circle(0px at var(--theme-click-x, 90vw) var(--theme-click-y, 30px));
      transition: clip-path 0.72s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease;
      will-change: clip-path;
    }
    #theme-circle-curtain.is-revealing {
      opacity: 1;
    }
    #theme-circle-curtain[data-target-theme="light"] {
      background: #F4F2EE;
    }
    #theme-circle-curtain[data-target-theme="dark"] {
      background: #0B0B0D;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
      mix-blend-mode: normal;
    }
    ::view-transition-new(root) {
      animation: circularThemeReveal 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    }
    @keyframes circularThemeReveal {
      from {
        clip-path: circle(0px at var(--theme-click-x, 90vw) var(--theme-click-y, 30px));
      }
      to {
        clip-path: circle(var(--theme-max-r, 150vmax) at var(--theme-click-x, 90vw) var(--theme-click-y, 30px));
      }
    }

    /* HERO-ONLY THIN GLOSSY CIRCULAR RIPPLE RING (GLASS-LIKE EXPANDING RING) */
    #hero-theme-gloss-ring {
      position: fixed;
      top: 0;
      left: 0;
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      display: none;
      opacity: 0;
      transform: translate(-50%, -50%);
      box-sizing: border-box;
    }

    #hero-theme-gloss-ring.theme-ring-light {
      border: 1.8px solid rgba(255, 255, 255, 0.78);
      box-shadow: 
        0 0 12px rgba(255, 255, 255, 0.55),
        inset 0 0 6px rgba(255, 255, 255, 0.4);
      background: radial-gradient(circle, transparent 95%, rgba(255, 255, 255, 0.10) 100%);
      backdrop-filter: blur(1px);
    }

    #hero-theme-gloss-ring.theme-ring-dark {
      border: 1.8px solid rgba(55, 55, 65, 0.82);
      box-shadow: 
        0 0 12px rgba(0, 0, 0, 0.55),
        inset 0 0 6px rgba(0, 0, 0, 0.38);
      background: radial-gradient(circle, transparent 95%, rgba(15, 15, 20, 0.20) 100%);
      backdrop-filter: blur(1px);
    }

    /* REACT BITS POST-HERO BACKGROUND (GLITTER WARP IN DARK, LANDSCAPE IN LIGHT) */
    #post-hero-fluid-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
      display: block;
      mix-blend-mode: normal;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    [data-theme="light"] #post-hero-fluid-background {
      mix-blend-mode: normal;
    }

    /* ============================================================
       02B. UNIFIED VECTOR TRIANGULAR ARROWHEAD CURSOR & SMOOTH RIPPLE
       ============================================================ */
    #cursor-trail-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 999998;
      display: block;
    }

    .section-cursor {
      position: fixed;
      top: 0;
      left: 0;
      width: 22px;
      height: 22px;
      pointer-events: none;
      z-index: 999999;
      opacity: 0;
      visibility: hidden;
      will-change: transform;
      transform: translate3d(-100px, -100px, 0);
      transition: opacity 0.16s ease, visibility 0.16s ease;
    }

    .section-cursor.is-active {
      opacity: 1;
      visibility: visible;
    }

    .section-cursor-svg {
      display: block;
      width: 18px;
      height: 18px;
    }

    /* Dark surface pointer: crisp white arrowhead with clean dark shadow for contrast */
    .section-cursor.cursor-mode-dark .section-cursor-svg polygon,
    .section-cursor:not(.cursor-mode-light) .section-cursor-svg polygon {
      fill: #FFFFFF !important;
      stroke: rgba(0, 0, 0, 0.45);
      stroke-width: 0.8;
    }

    .section-cursor.cursor-mode-dark,
    .section-cursor:not(.cursor-mode-light) {
      filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.85));
    }

    /* Light surface pointer: crisp matte-black arrowhead with subtle light edge */
    .section-cursor.cursor-mode-light .section-cursor-svg polygon {
      fill: #111115 !important;
      stroke: rgba(255, 255, 255, 0.65);
      stroke-width: 0.6;
    }

    .section-cursor.cursor-mode-light {
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
    }

    /* Desktop universal cursor hiding — eliminates native pointer across all elements */
    @media (hover: hover) and (pointer: fine) {
      *, *::before, *::after {
        cursor: none !important;
      }
    }

    /* Restore native cursor behavior on touch / mobile devices where custom cursor is unavailable */
    @media (hover: none), (pointer: coarse) {
      .section-cursor,
      #cursor-trail-canvas {
        display: none !important;
      }
      *, *::before, *::after {
        cursor: auto !important;
      }
    }

    /* ============================================================
       03. OPENING SPLASH GLITCH (EXACT 0.7S EDITORIAL CYBERPUNK GLITCH)
       ============================================================ */
    .center-splash {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #070709;
      z-index: 9999;
      pointer-events: none;
      transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), 
                  transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 0.25s ease;
      overflow: hidden;
    }

    /* Scanlines and digital signal raster overlay */
    .center-splash::before {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.35) 0px,
        rgba(0, 0, 0, 0.35) 1px,
        transparent 1px,
        transparent 3px
      );
      pointer-events: none;
      z-index: 4;
      opacity: 0.9;
    }

    .splash-content {
      position: relative;
      z-index: 3;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
    }

    /* CYBERPUNK 2077 / CD PROJEKT RED INSPIRED COHESIVE WORDMARK */
    .splash-title {
      font-family: 'Barlow Condensed', 'Bebas Neue', sans-serif;
      font-weight: 900;
      font-size: clamp(2.8rem, 6.4vw, 5.2rem);
      letter-spacing: 0.16em;
      color: #ffffff;
      text-transform: uppercase;
      text-shadow: 0 0 28px rgba(255, 255, 255, 0.85), 0 0 60px rgba(255, 48, 56, 0.5);
      line-height: 1;
      white-space: nowrap;
      position: relative;
      display: inline-block;
      padding: 6px 14px;
      clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
      border-left: 2px solid var(--dbl-crimson);
      border-right: 2px solid rgba(73, 215, 232, 0.8);
    }

    /* CONTROLLED GLYPH LOTTERY STARTUP BRANDING (0.3s DURATION) */
    .splash-glitching {
      position: relative;
    }

    @keyframes continuousIntroGlitch {
      0% {
        transform: translate(0, 0);
        filter: drop-shadow(-3px 0 var(--dbl-crimson)) drop-shadow(3px 0 rgba(73, 215, 232, 0.55));
        clip-path: inset(0 0 0 0);
      }
      20% {
        transform: translate(-4px, 1px) skewX(-2.5deg);
        filter: drop-shadow(4px 0 var(--dbl-crimson)) drop-shadow(-3px 0 rgba(255, 255, 255, 0.8));
        clip-path: inset(14% 0 32% 0);
      }
      40% {
        transform: translate(4px, -1px) skewX(2.5deg);
        filter: drop-shadow(-3px 0 rgba(73, 215, 232, 0.8)) drop-shadow(3px 0 var(--dbl-crimson));
        clip-path: inset(48% 0 12% 0);
      }
      60% {
        transform: translate(-3px, -2px) skewX(-1.5deg);
        filter: drop-shadow(-4px 0 var(--dbl-crimson));
        clip-path: inset(0 0 58% 0);
      }
      80% {
        transform: translate(3px, 2px);
        filter: drop-shadow(3px 0 rgba(255, 255, 255, 0.9));
        clip-path: inset(28% 0 24% 0);
      }
      100% {
        transform: translate(0, 0);
        filter: drop-shadow(-2px 0 var(--dbl-crimson));
        clip-path: inset(0 0 0 0);
      }
    }

    @keyframes glitchSliceRed {
      0% { transform: translate(-3px, -1px); clip-path: inset(8% 0 65% 0); }
      30% { transform: translate(4px, 1px); clip-path: inset(42% 0 28% 0); }
      70% { transform: translate(-2px, 2px); clip-path: inset(70% 0 5% 0); }
      100% { transform: translate(3px, -1px); clip-path: inset(15% 0 50% 0); }
    }

    @keyframes glitchSliceCyan {
      0% { transform: translate(3px, 1px); clip-path: inset(25% 0 45% 0); }
      35% { transform: translate(-4px, -1px); clip-path: inset(62% 0 15% 0); }
      65% { transform: translate(2px, -2px); clip-path: inset(5% 0 78% 0); }
      100% { transform: translate(-3px, 1px); clip-path: inset(38% 0 30% 0); }
    }

    /* ============================================================
       MULTIVERSE / DIMENSIONAL GLITCH LAYER (SECOND GLITCH TRANSITION)
       Triggered ~0.8-1.0s after startup glitch vanishes (~280ms duration)
       Chromatic splitting, 2.5D registration shifts, dimensional slice displacement
       ============================================================ */
    .multiverse-glitch-layer {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 9990;
      opacity: 0;
      display: none;
      overflow: hidden;
    }

    .multiverse-glitch-layer.is-active {
      display: block;
      opacity: 1;
      animation: multiverseDimensionalGlitch 0.20s steps(2) forwards;
    }

    .multiverse-glitch-layer::before,
    .multiverse-glitch-layer::after {
      content: '';
      position: absolute;
      inset: -10px;
      pointer-events: none;
    }

    .multiverse-glitch-layer::before {
      background: linear-gradient(90deg, rgba(255, 48, 56, 0.28) 0%, transparent 40%, rgba(64, 224, 255, 0.22) 100%);
      mix-blend-mode: screen;
      transform: translate(-6px, 3px);
      animation: multiverseSplitRed 0.20s ease forwards;
    }

    .multiverse-glitch-layer::after {
      background: repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.08) 0px,
        rgba(255, 255, 255, 0.08) 2px,
        transparent 2px,
        transparent 6px
      );
      mix-blend-mode: overlay;
      animation: multiverseScanBreak 0.20s steps(3) forwards;
    }

    @keyframes multiverseDimensionalGlitch {
      0% {
        opacity: 0.9;
        filter: contrast(160%) brightness(130%);
        transform: scale(1.01) translate(-4px, 2px);
        clip-path: inset(12% 0 35% 0);
      }
      25% {
        opacity: 1;
        filter: contrast(180%) hue-rotate(90deg);
        transform: scale(0.99) translate(6px, -3px) skewX(-2deg);
        clip-path: inset(45% 0 10% 0);
      }
      55% {
        opacity: 0.95;
        filter: contrast(140%) brightness(120%);
        transform: scale(1.02) translate(-5px, -2px) skewX(2.5deg);
        clip-path: inset(5% 0 60% 0);
      }
      80% {
        opacity: 0.7;
        filter: contrast(120%);
        transform: scale(1.0) translate(2px, 1px);
        clip-path: inset(25% 0 15% 0);
      }
      100% {
        opacity: 0;
        transform: scale(1.0);
        clip-path: inset(0 0 0 0);
      }
    }

    @keyframes multiverseSplitRed {
      0% { transform: translate(-8px, 4px) skewX(3deg); opacity: 0.8; }
      50% { transform: translate(10px, -5px) skewX(-2deg); opacity: 0.9; }
      100% { transform: translate(0, 0); opacity: 0; }
    }

    @keyframes multiverseScanBreak {
      0% { transform: translateY(-10px); }
      50% { transform: translateY(8px); }
      100% { transform: translateY(0); }
    }

    /* ============================================================
       04. FIXED DBL HEADER (THEME TOGGLE + LOCAL TIME)
       (HEADER REMAINS PERMANENTLY DARK IN BOTH THEMES)
       ============================================================ */
    .hero-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 62px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 clamp(20px, 4.2vw, 52px);
      z-index: 100;
      background: rgba(11, 11, 13, 0.94) !important;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.09) !important;
      pointer-events: auto;
      color: #ffffff !important;
      transition: border-color 0.4s ease;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: clamp(16px, 2.5vw, 32px);
    }

    .brand-group {
      display: flex;
      align-items: baseline;
      gap: 12px;
      text-decoration: none;
    }

    .brand-cbk {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: 19px;
      letter-spacing: 0.08em;
      color: #ffffff !important;
      text-transform: uppercase;
    }

    .brand-designfolio {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      color: #9C9CA6 !important;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      position: relative;
    }

    .df-char, .gl-char {
      display: inline-block;
      width: 0.82em;
      text-align: center;
      font-variant-numeric: tabular-nums;
      transition: transform 0.16s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.16s ease, color 0.16s ease;
    }

    .df-char.is-rolling, .gl-char.is-rolling {
      color: var(--dbl-text-primary) !important;
      opacity: 0.90;
      filter: blur(0.35px);
      transform: translateY(-0.04em) scaleY(1.05);
    }

    .df-slot-indicator {
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 7px;
      height: 1.5px;
      background: var(--dbl-crimson);
      opacity: 0;
      transition: opacity 0.2s ease, transform 0.25s ease;
    }

    .header-tag-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      font-weight: 700;
      letter-spacing: 0.16em;
      padding: 3px 8px;
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid rgba(255, 255, 255, 0.09) !important;
      color: #9C9CA6 !important;
      text-transform: uppercase;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .time-block {
      display: flex;
      align-items: baseline;
      gap: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      color: #9C9CA6 !important;
    }

    .time-prefix {
      font-size: 9px;
      color: #686875 !important;
      letter-spacing: 0.18em;
    }

    .time-digits {
      color: #ffffff !important;
      font-weight: 600;
    }

    .time-period {
      font-size: 9px;
      color: var(--dbl-crimson);
      font-weight: 700;
    }

    /* THEME TOGGLE ICON (COMPACT, MINIMAL, NO TEXT) */
    .theme-toggle-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.06) !important;
      border: 1px solid rgba(255, 255, 255, 0.14) !important;
      color: #ffffff !important;
      cursor: pointer;
      transition: all 0.22s ease;
    }

    .theme-toggle-btn:hover {
      border-color: var(--dbl-crimson-border) !important;
      color: var(--dbl-crimson) !important;
      transform: translateY(-1px);
    }

    .theme-icon {
      display: inline-block;
      stroke: currentColor;
    }

    [data-theme="dark"] .moon-icon { display: none; }
    [data-theme="dark"] .sun-icon { display: inline-block; }

    [data-theme="light"] .sun-icon { display: none; }
    [data-theme="light"] .moon-icon { display: inline-block; }

    /* ============================================================
       05. SECTION 01 — HERO (ALWAYS PERMANENTLY DARK)
       ============================================================ */
    #hero-section {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #070709 !important;
      color: #ffffff !important;
    }

    #canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      display: block;
      z-index: 1;
      object-fit: cover;
    }

    .left-stage-backdrop {
      display: none !important;
    }

    /* SCROLL DOWN TUTORIAL (UPPER RIGHT OF HERO) */
    .scroll-down-widget {
      position: absolute;
      right: clamp(24px, 4.2vw, 56px);
      top: clamp(82px, 12vh, 108px);
      z-index: 25;
      display: flex;
      align-items: center;
      gap: 12px;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      cursor: pointer;
    }

    .scroll-down-widget.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .sd-visual {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .sd-mouse-icon {
      width: 15px;
      height: 22px;
      border: 1.5px solid rgba(255, 255, 255, 0.6);
      border-radius: 8px;
      display: flex;
      justify-content: center;
      padding-top: 3px;
    }

    .sd-wheel-dot {
      width: 3px;
      height: 4px;
      border-radius: 2px;
      background: var(--dbl-crimson);
      animation: sdWheelAnim 1.6s ease infinite;
    }

    @keyframes sdWheelAnim {
      0% { transform: translateY(0); opacity: 1; }
      70% { transform: translateY(5px); opacity: 0; }
      100% { transform: translateY(0); opacity: 0; }
    }

    .sd-arrow-icon {
      color: var(--dbl-crimson);
      animation: sdArrowBounce 1.6s ease infinite;
    }

    @keyframes sdArrowBounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(3px); }
    }

    .sd-label-wrap {
      display: flex;
      flex-direction: column;
    }

    .sd-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: #ffffff;
      text-transform: uppercase;
    }

    .sd-sub {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8px;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.45);
      text-transform: uppercase;
    }

    /* HERO LEFT IDENTITY STAGE (LOWERED COHERENT VERTICAL STACK WITH STRICT LEFT ALIGNMENT) */
    .hero-left-stage {
      position: absolute;
      left: clamp(28px, 4.5vw, 64px);
      top: 53.5%;
      transform: translateY(-44%);
      z-index: 20;
      max-width: clamp(440px, 46vw, 640px);
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      pointer-events: auto;
    }

    /* DENSE FERROFLUID PARTICLE TYPOGRAPHY (TIGHTLY PACKED, SOLID BOLD SILHOUETTE) */
    .hero-name-wrap {
      position: relative;
      width: 100%;
      min-height: 195px;
      user-select: none;
      margin-left: 0;
      padding-left: 0;
      align-self: flex-start;
    }

    #name-particle-canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* EDITORIAL QUOTE STATEMENT (STRICT LEFT ALIGNMENT WITH NAME & STICKY NOTE) */
    .hero-quote-wrap {
      margin-top: 14px;
      margin-left: 0;
      padding-left: 0;
      display: flex;
      align-items: center;
      align-self: flex-start;
      gap: 10px;
    }

    .quote-mask-track {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .quote-bracket {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      color: var(--dbl-crimson);
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    .quote-bracket.is-revealed {
      opacity: 1;
      transform: translateX(0);
    }

    .quote-text-reveal {
      font-family: var(--font-quote);
      font-size: clamp(22px, 2.0vw, 28px);
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: none;
      color: #FFFFFF;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      font-style: italic;
    }

    .quote-text-reveal .q-char {
      display: inline-block;
      opacity: 0;
      transform: translateY(6px);
      filter: blur(3px);
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(var(--q-idx, 0) * 16ms);
    }

    .quote-text-reveal.is-revealed .q-char {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    .quote-guide-bar {
      height: 1px;
      width: 0;
      background: linear-gradient(90deg, var(--dbl-crimson) 0%, transparent 100%);
      transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
    }

    .quote-guide-bar.is-expanded {
      width: 54px;
    }

    /* REALISTIC WARM PAPER STICKY NOTE (BOTTOM-LEFT CURLED CORNER & TOP ADHESIVE STRIP FROM REFERENCE) */
    .sticky-note {
      position: relative;
      margin-top: 16px;
      margin-left: 0;
      align-self: flex-start;
      width: clamp(292px, 23.5vw, 328px);
      max-width: 335px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      /* Top adhesive strip + warm pale-yellow paper gradient matching reference */
      background: 
        linear-gradient(to bottom, rgba(246, 222, 92, 0.42) 0%, rgba(246, 222, 92, 0.42) 14%, transparent 14.5%),
        linear-gradient(165deg, #FFFDE0 0%, #FFF8A8 40%, #FDF07B 100%);
      color: #1a170e;
      border: 1px solid rgba(220, 198, 95, 0.45);
      border-radius: 4px 6px 4px 0; /* clean corners, bottom-left curl */
      padding: 16px 18px 14px 18px; /* natural proportions sized closely to text */
      box-shadow: 
        0 14px 28px -6px rgba(0, 0, 0, 0.48),
        0 4px 10px -2px rgba(0, 0, 0, 0.24),
        0 1px 3px rgba(0, 0, 0, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.90),
        inset 0 -1px 2px rgba(170, 135, 20, 0.10);
      transform: translateY(14px) scale(0.96);
      transform-origin: 0% 0%;
      transform-style: preserve-3d;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.16s ease-out,
                  box-shadow 0.35s ease;
      user-select: text;
    }

    /* Reference: Curled bottom-left corner with contact shadow and golden underside fold */
    .sticky-note::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: -1px;
      width: 22px;
      height: 22px;
      background: radial-gradient(circle at 100% 0%, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.10) 60%, transparent 75%);
      clip-path: polygon(0 0, 100% 100%, 0 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* Paper fold underside triangle (turned back flap) */
    .sticky-note::before {
      content: '';
      position: absolute;
      bottom: -1px;
      left: -1px;
      width: 24px;
      height: 24px;
      background: linear-gradient(135deg, #DEBA39 0%, #E8C94B 45%, #F7E172 100%);
      clip-path: polygon(0 100%, 100% 100%, 100% 0);
      border-radius: 0 0 0 2px;
      box-shadow: 2px -2px 4px rgba(0, 0, 0, 0.20);
      pointer-events: none;
      z-index: 2;
    }

    .sticky-note.is-revealed {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .sticky-note.is-revealed:hover {
      box-shadow: 
        0 18px 34px -6px rgba(0, 0, 0, 0.54),
        0 6px 14px -2px rgba(0, 0, 0, 0.28),
        inset 0 1px 0 rgba(255, 255, 255, 0.95);
    }

    /* CONVENTIONAL OFFICE NOTICEBOARD RED PUSH PIN */
    .isometric-push-pin {
      position: absolute;
      top: -13px;
      right: 18px;
      left: auto;
      width: 34px;
      height: 42px;
      z-index: 15;
      pointer-events: none;
      filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.40));
      transform-origin: 10px 36px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sticky-note.is-revealed .isometric-push-pin {
      animation: pinImpaleSettle 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
    }

    @keyframes pinImpaleSettle {
      0% {
        transform: translate(6px, -14px) scale(1.20) rotate(8deg);
        opacity: 0;
      }
      60% {
        transform: translate(-1px, 2px) scale(0.97) rotate(-2deg);
        opacity: 1;
      }
      100% {
        transform: translate(0, 0) scale(1) rotate(0deg);
        opacity: 1;
      }
    }

    .sticky-header {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #9E1919;
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 9px;
    }

    .sticky-body {
      font-family: var(--font-sticky-body);
      font-size: clamp(11.8px, 0.98vw, 12.6px);
      line-height: 1.50;
      color: #1e1b15;
      font-weight: 500;
      letter-spacing: -0.01em;
      text-transform: none;
      margin: 0;
      padding-bottom: 2px;
    }

    .sticky-display-line {
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .sticky-display-line.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .sticky-body strong {
      color: #050505;
      font-weight: 700;
      border-bottom: 1.5px solid #d32028;
      padding-bottom: 1px;
    }

    /* CONTACT LINKS ROW */
    .contact-links-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 18px;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s ease 0.2s, transform 0.4s ease 0.2s;
    }

    .contact-links-row.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .contact-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #ffffff;
      text-decoration: none;
      transition: all 0.22s ease;
    }

    .contact-btn:hover {
      background: var(--dbl-crimson-subtle);
      border-color: var(--dbl-crimson-border);
      color: var(--dbl-crimson);
      transform: translateY(-2px);
      box-shadow: 0 0 14px var(--dbl-crimson-glow);
    }

    /* HERO TICKER WITH STRUCTURED HORIZONTAL RAIL */
    .hero-ticker-wrap {
      position: absolute;
      bottom: clamp(14px, 2.5vh, 26px);
      left: 0;
      width: 100vw;
      z-index: 30;
      background: rgba(11, 11, 14, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-ticker-wrap.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Ticker stays permanently dark in both themes */
    .hero-ticker-wrap {
      background: rgba(11, 11, 14, 0.94) !important;
      border-top: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.6) !important;
    }

    .ticker-sequence {
      color: rgba(255, 255, 255, 0.92) !important;
    }

    .ticker-viewport {
      width: 100%;
      overflow: hidden;
      padding: 10px 0;
      mask-image: linear-gradient(90deg, transparent 0%, black 60px, black calc(100% - 60px), transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 60px, black calc(100% - 60px), transparent 100%);
    }

    .ticker-track {
      display: flex;
      white-space: nowrap;
      width: max-content;
      animation: tickerLeftToRight 36s linear infinite;
      will-change: transform;
    }

    @keyframes tickerLeftToRight {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0%); }
    }

    .ticker-sequence {
      display: inline-flex;
      align-items: center;
      gap: clamp(32px, 3.8vw, 56px);
      padding-right: clamp(32px, 3.8vw, 56px);
      font-family: 'Space Grotesk', 'JetBrains Mono', monospace;
      font-size: clamp(12.5px, 1.25vw, 14.5px);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.88);
    }

    .ticker-dot {
      color: var(--dbl-crimson);
      font-size: 14px;
      line-height: 1;
    }

    /* ============================================================
       06. DBL MAIN WRAPPER (SECTIONS 02 TO 07)
       ============================================================ */
    .dbl-section-wrap {
      position: relative;
      background: transparent;
      color: var(--dbl-text-primary);
      z-index: 20;
      box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.7);
      overflow: hidden;
      transition: var(--dbl-theme-transition);
    }

    /* Pipeline Archive Filters (All / Landscape / Portrait) */
    .pipeline-filter-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 24px;
      position: relative;
      z-index: 10;
    }

    .pipeline-filter-btn {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      padding: 8px 18px;
      border-radius: 4px;
      background: rgba(18, 18, 22, 0.75);
      border: 1px solid var(--dbl-border-base);
      color: var(--dbl-text-secondary);
      cursor: pointer;
      transition: all 0.2s ease;
      backdrop-filter: blur(8px);
    }

    .pipeline-filter-btn:hover {
      border-color: var(--dbl-border-hover);
      color: var(--dbl-text-primary);
    }

    .pipeline-filter-btn.is-active {
      background: rgba(255, 48, 56, 0.15);
      border-color: var(--dbl-crimson);
      color: var(--dbl-text-primary);
    }

    [data-theme="light"] .pipeline-filter-btn {
      background: rgba(255, 255, 255, 0.85);
      border-color: var(--dbl-border-base);
    }

    .dbl-content-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: clamp(72px, 9vh, 120px) clamp(24px, 4.5vw, 64px);
      position: relative;
      z-index: 2;
    }

    .dbl-section-header {
      margin-bottom: clamp(40px, 5.5vh, 60px);
    }

    .dbl-meta-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dbl-text-tertiary);
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
    }

    .dbl-meta-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dbl-crimson);
      box-shadow: 0 0 6px var(--dbl-crimson);
    }

    .dbl-title-main {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(2.4rem, 4.8vw, 4.2rem);
      letter-spacing: -0.02em;
      line-height: 1;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
    }

    .dbl-subtitle-desc {
      font-size: clamp(14px, 1.2vw, 16.5px);
      color: var(--dbl-text-secondary);
      margin-top: 10px;
      font-weight: 400;
      max-width: 660px;
      line-height: 1.5;
    }

    /* ============================================================
       07. SECTION 02 — IMPACT (ASYMMETRICAL PRODUCTION ARCHIVE)
       ============================================================ */
    #impact-metrics {
      position: relative;
    }

    .index-composition-grid {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    /* WIDESCREEN CINEMATIC PROJECT SHOWCASE */
    .cinematic-showcase-zone {
      position: relative;
      width: 100%;
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      border-radius: 10px;
      padding: clamp(20px, 2.5vw, 32px);
      overflow: hidden;
      box-shadow: 0 20px 48px -10px rgba(0, 0, 0, 0.45);
      transition: var(--dbl-theme-transition);
    }

    .showcase-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .showcase-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--dbl-text-secondary);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .showcase-tag .signal-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--dbl-crimson);
      box-shadow: 0 0 8px var(--dbl-crimson);
      animation: signalPulse 2.4s ease-in-out infinite;
    }

    @keyframes signalPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.45; transform: scale(0.85); }
    }

    .showcase-rotation-nav {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .rot-index-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      color: var(--dbl-text-tertiary);
      letter-spacing: 0.16em;
    }

    .rot-tabs {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .rot-tab-btn {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 5px 12px;
      border-radius: 4px;
      border: 1px solid var(--dbl-border-subtle);
      background: rgba(255, 255, 255, 0.04);
      color: var(--dbl-text-tertiary);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      position: relative;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    [data-theme="light"] .rot-tab-btn {
      background: rgba(0, 0, 0, 0.03);
    }

    .rot-tab-btn:hover {
      color: var(--dbl-text-primary);
      border-color: var(--dbl-border-strong);
    }

    .rot-tab-btn.is-active {
      color: var(--dbl-text-primary);
      border-color: var(--dbl-crimson-border);
      background: var(--dbl-crimson-subtle);
    }

    .rot-tab-btn .tab-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--dbl-text-tertiary);
      transition: background 0.25s ease;
    }

    .rot-tab-btn.is-active .tab-dot {
      background: var(--dbl-crimson);
      box-shadow: 0 0 6px var(--dbl-crimson);
    }

    .tab-progress-line {
      position: absolute;
      bottom: 0;
      left: 0;
      height: 2px;
      background: var(--dbl-crimson);
      width: 0%;
    }

    .rot-tab-btn.is-active .tab-progress-line {
      width: 100%;
      transition: width 10s linear;
    }

    .cinematic-stage {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 5.2;
      min-height: 240px;
      max-height: 400px;
      border-radius: 8px;
      overflow: hidden;
      background: #08080A;
      border: 1px solid var(--dbl-border-subtle);
    }

    .cinematic-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      transform: scale(1.02) translateX(6px);
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .cinematic-slide.is-active {
      opacity: 1;
      transform: scale(1) translateX(0);
      pointer-events: auto;
    }

    .cinematic-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: brightness(0.96) contrast(1.04);
      transition: transform 0.6s ease;
    }

    .cinematic-stage:hover .cinematic-slide.is-active img {
      transform: scale(1.015);
    }

    .slide-metadata-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: clamp(14px, 2.2vw, 24px) clamp(16px, 2.8vw, 32px);
      background: linear-gradient(180deg, transparent 0%, rgba(8, 8, 11, 0.72) 40%, rgba(8, 8, 11, 0.95) 100%);
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
    }

    .slide-info-left {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .slide-badge-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--dbl-crimson);
      text-transform: uppercase;
    }

    .slide-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(1.4rem, 2.8vw, 2.4rem);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: #ffffff;
      line-height: 1;
      text-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
    }

    .slide-caption-desc {
      font-size: clamp(11.5px, 1.1vw, 13.5px);
      color: rgba(255, 255, 255, 0.82);
      max-width: 620px;
      line-height: 1.4;
      margin-top: 2px;
    }

    .slide-tag-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.16em;
      padding: 6px 14px;
      border-radius: 4px;
      background: rgba(18, 18, 24, 0.85);
      backdrop-filter: blur(8px);
      border: 1px solid var(--dbl-border-base);
      color: #ffffff;
      white-space: nowrap;
    }

    /* ASYMMETRIC METRIC ARCHIVE */
    .metrics-production-archive {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 20px;
    }

    .metric-module {
      position: relative;
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      border-radius: 8px;
      padding: clamp(24px, 2.4vw, 32px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      cursor: default;
      transition: border-color 0.3s ease, transform 0.25s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    .metric-module:hover {
      border-color: var(--dbl-border-strong);
      transform: translateY(-2px);
      box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.35);
    }

    /* LOCALIZED INTERNAL PIXEL GRID CANVAS (STRICTLY INSIDE BLOCK) */
    .pixel-grid-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.85;
    }

    /* MATRIX-LIKE SQUARE CUBES HOVER CANVAS (STRICTLY INSIDE TILE) */
    .matrix-cube-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      border-radius: inherit;
    }

    /* Spatial localized illumination for metric tiles */
    [data-matrix-tile="true"],
    [data-star-tile="true"] {
      position: relative;
      overflow: hidden;
      --matrix-glow-x: 50%;
      --matrix-glow-y: 50%;
      --matrix-glow-strength: 0;
    }

    [data-matrix-tile="true"]::before,
    [data-star-tile="true"]::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      z-index: 1;
      background: radial-gradient(130px circle at var(--matrix-glow-x, 50%) var(--matrix-glow-y, 50%), rgba(90, 205, 255, calc(0.10 * var(--matrix-glow-strength, 0))), transparent 72%);
      opacity: var(--matrix-glow-strength, 0);
      transition: opacity 0.25s ease;
    }

    [data-theme="light"] [data-matrix-tile="true"]::before,
    [data-theme="light"] [data-star-tile="true"]::before {
      background: radial-gradient(130px circle at var(--matrix-glow-x, 50%) var(--matrix-glow-y, 50%), rgba(30, 48, 80, calc(0.07 * var(--matrix-glow-strength, 0))), transparent 72%);
    }

    .metric-module-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .metric-tag-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--dbl-text-tertiary);
      text-transform: uppercase;
      margin-bottom: 14px;
    }

    .metric-tag-row .metric-sig {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dbl-border-strong);
      transition: background 0.3s ease, box-shadow 0.3s ease;
    }

    .metric-module:hover .metric-sig {
      background: var(--dbl-crimson);
      box-shadow: 0 0 6px var(--dbl-crimson);
    }

    /* PRIMARY HERO METRIC: 25K+ AI IMAGES (WITH ROTATING AI SLIDESHOW) */
    .metric-module.is-primary {
      grid-column: span 1;
      grid-row: span 2;
      background: var(--dbl-surface-charcoal);
      border-color: var(--dbl-border-strong);
    }

    .metric-slideshow-wrap {
      position: absolute;
      inset: 0;
      overflow: hidden;
      border-radius: inherit;
      z-index: 1;
      pointer-events: none;
    }

    .metric-slide-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      filter: brightness(0.32) contrast(1.15) saturate(1.1);
      transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 3.6s ease-out;
      transform: scale(1.06);
    }

    .metric-slide-img.is-active {
      opacity: 0.38;
      transform: scale(1);
    }

    .metric-slideshow-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 35% 35%, rgba(21, 21, 25, 0.45) 0%, rgba(15, 15, 18, 0.92) 85%);
    }

    [data-theme="light"] .metric-slide-img.is-active {
      opacity: 0.16;
    }

    [data-theme="light"] .metric-slideshow-overlay {
      background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.5) 0%, rgba(244, 242, 238, 0.94) 85%);
    }

    .metric-module.is-primary .metric-val {
      font-size: clamp(3.6rem, 5.4vw, 5rem);
    }

    .metric-module.is-primary .metric-label {
      font-size: 16.5px;
      margin-top: 12px;
    }

    .metric-module.is-primary .metric-desc {
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--dbl-text-secondary);
      margin-top: 8px;
    }

    .metric-val {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(2.4rem, 3.6vw, 3.2rem);
      letter-spacing: -0.02em;
      line-height: 0.95;
      color: var(--dbl-text-primary);
      display: flex;
      align-items: baseline;
      gap: 2px;
    }

    .metric-val .plus-sym {
      color: var(--dbl-crimson);
      font-size: 0.78em;
    }

    .metric-label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
      margin-top: 10px;
    }

    .metric-desc {
      font-size: 12px;
      line-height: 1.5;
      color: var(--dbl-text-secondary);
      margin-top: 6px;
    }

    /* DESIGNED "SEE MORE" INTERACTION BAR */
    .see-more-archive-trigger {
      display: flex;
      align-items: center;
      gap: 16px;
      margin: 8px 0 0;
      cursor: pointer;
      user-select: none;
      padding: 8px 0;
    }

    .see-more-line {
      flex: 1;
      height: 1px;
      background: var(--dbl-border-base);
      transition: background 0.3s ease;
    }

    .see-more-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 11px 24px;
      border-radius: 6px;
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      color: var(--dbl-text-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .see-more-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--dbl-crimson);
      box-shadow: 0 0 6px var(--dbl-crimson);
      transition: transform 0.3s ease;
    }

    .see-more-arrow {
      color: var(--dbl-text-secondary);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.25s ease;
    }

    .see-more-archive-trigger:hover .see-more-pill {
      border-color: var(--dbl-crimson-border);
      background: var(--dbl-crimson-subtle);
      transform: translateY(-1px);
    }

    .see-more-archive-trigger:hover .see-more-line {
      background: var(--dbl-border-strong);
    }

    .see-more-archive-trigger.is-expanded .see-more-arrow {
      transform: rotate(180deg);
      color: var(--dbl-crimson);
    }

    /* REMAINING METRICS DRAWER (15+, 50+, 140+) */
    .remaining-metrics-drawer {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transform: translateY(-8px);
      transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.4s ease,
                  transform 0.4s ease,
                  margin 0.3s ease;
      margin-top: 0;
    }

    .remaining-metrics-drawer.is-open {
      max-height: 320px;
      opacity: 1;
      transform: translateY(0);
      margin-top: 14px;
    }

    .sub-metric-item {
      position: relative;
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-subtle);
      border-radius: 6px;
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    .sub-metric-item:hover {
      border-color: var(--dbl-border-strong);
      transform: translateY(-2px);
      box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.3);
    }

    .sub-metric-val {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(1.8rem, 2.4vw, 2.2rem);
      letter-spacing: -0.01em;
      color: var(--dbl-text-primary);
      line-height: 1;
      display: flex;
      align-items: baseline;
      gap: 2px;
    }

    .sub-metric-val .plus-sym {
      color: var(--dbl-crimson);
      font-size: 0.8em;
    }

    .sub-metric-label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
      margin-top: 6px;
    }

    .sub-metric-desc {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      color: var(--dbl-text-tertiary);
      letter-spacing: 0.04em;
      margin-top: 4px;
      line-height: 1.35;
    }

    /* ============================================================
       07B. MONOCHROME GEOMETRIC IDENTITY — ISOMETRIC TRIANGLE LATTICE
       ============================================================ */
    .geometric-identity-section {
      border-top: 1px solid var(--dbl-border-base);
      padding-top: clamp(48px, 6vh, 80px);
      margin-top: clamp(48px, 6vh, 80px);
      position: relative;
      box-sizing: border-box;
      background: var(--dbl-bg-root);
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .triangle-grid-container {
      position: relative;
      width: 100%;
      height: 250px;
      margin-top: 24px;
      border: 1px solid var(--dbl-border-subtle);
      border-radius: 4px;
      background: rgba(0, 0, 0, 0.45);
      overflow: hidden;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    [data-theme="light"] .triangle-grid-container {
      background: #FFFFFF;
      border: 1px solid rgba(0, 0, 0, 0.12);
    }

    #triangle-grid-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .triangle-grid-overlay-meta {
      position: absolute;
      bottom: 12px;
      left: 16px;
      right: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.12em;
      color: var(--dbl-text-tertiary);
      pointer-events: none;
      z-index: 2;
    }

    /* ============================================================
       08. SECTION 03 — MY JOURNEY (FLUID CAREER FILMOGRAPHY)
       ============================================================ */
    .journey-section {
      border-top: 1px solid var(--dbl-border-base);
      padding-top: clamp(64px, 8.5vh, 100px);
      margin-top: clamp(64px, 8.5vh, 100px);
      position: relative;
    }

    .fluid-ribbon-container {
      position: relative;
      margin-bottom: 38px;
      z-index: 2;
    }

    .career-evolution-strip {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px 20px;
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      border-radius: 6px;
      width: fit-content;
      user-select: none;
      transition: var(--dbl-theme-transition);
    }

    .evo-step {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--dbl-text-secondary);
    }

    .evo-step.is-cinema {
      color: var(--dbl-text-primary);
    }

    .evo-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dbl-text-tertiary);
    }

    .evo-step.is-cinema .evo-dot {
      background: var(--dbl-crimson);
      box-shadow: 0 0 6px var(--dbl-crimson);
    }

    .evo-arrow {
      color: var(--dbl-text-tertiary);
      font-size: 12px;
    }

    .journey-layout {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 28px;
      align-items: start;
    }

    .company-spine-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .company-row-item {
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      border-radius: 8px;
      padding: 22px 24px;
      cursor: pointer;
      position: relative;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.25s ease,
                  background 0.25s ease,
                  box-shadow 0.25s ease;
      outline: none;
    }

    .company-row-item:hover {
      border-color: var(--dbl-border-strong);
      transform: translateX(4px);
    }

    .company-row-item.is-selected {
      border-color: var(--dbl-crimson-border);
      background: var(--dbl-surface-charcoal);
      transform: translateX(6px);
      box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.35);
    }

    .company-row-item.is-selected::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: var(--dbl-crimson);
      border-radius: 8px 0 0 8px;
    }

    .company-row-item.is-dneg {
      border-left: 3px solid rgba(255, 48, 56, 0.4);
    }

    .company-row-item.is-dneg.is-selected {
      border-left: 4px solid var(--dbl-crimson);
    }

    .comp-item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .comp-index {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      color: var(--dbl-crimson);
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .comp-dates {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--dbl-text-tertiary);
      text-transform: uppercase;
    }

    .comp-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: 22px;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
      line-height: 1.1;
    }

    .comp-role {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--dbl-text-secondary);
      margin-top: 3px;
    }

    .comp-loc {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      color: var(--dbl-text-tertiary);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-top: 6px;
    }

    .journey-workspace-panel {
      background: var(--dbl-surface-matte);
      color: var(--dbl-text-primary);
      border: 1px solid var(--dbl-border-base);
      border-radius: 10px;
      padding: clamp(28px, 4vw, 44px);
      min-height: 580px;
      position: sticky;
      top: 86px;
      box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.45);
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), var(--dbl-theme-transition);
    }

    .ws-header {
      border-bottom: 1px solid var(--dbl-border-base);
      padding-bottom: 20px;
      margin-bottom: 22px;
    }

    .ws-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: var(--dbl-text-tertiary);
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .ws-badge-live {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--dbl-text-primary);
      background: var(--dbl-crimson-subtle);
      border: 1px solid var(--dbl-crimson-border);
      padding: 3px 9px;
      border-radius: 3px;
      font-size: 9.5px;
    }

    .ws-badge-live::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dbl-crimson);
      box-shadow: 0 0 6px var(--dbl-crimson);
    }

    .ws-company-name {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(2.2rem, 3.8vw, 3.4rem);
      letter-spacing: -0.02em;
      line-height: 1;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
      margin-top: 4px;
    }

    .ws-role-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 15.5px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--dbl-crimson);
      margin-top: 8px;
      text-transform: uppercase;
    }

    .ws-statement-lead {
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--dbl-text-primary);
      font-weight: 500;
      margin: 16px 0;
      padding-left: 12px;
      border-left: 2px solid var(--dbl-crimson);
    }

    .ws-key-points-list {
      display: flex;
      flex-direction: column;
      gap: 9px;
      margin-bottom: 20px;
    }

    .ws-point-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 13px;
      line-height: 1.5;
      color: var(--dbl-text-secondary);
    }

    .ws-point-bullet {
      color: var(--dbl-crimson);
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .dneg-visual-box {
      width: 100%;
      height: 200px;
      border-radius: 6px;
      overflow: hidden;
      margin: 18px 0;
      position: relative;
      border: 1px solid var(--dbl-border-base);
    }

    .dneg-visual-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: brightness(0.95);
    }

    .dneg-visual-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 8px 14px;
      background: linear-gradient(180deg, transparent 0%, rgba(8, 8, 11, 0.9) 100%);
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.16em;
      color: rgba(255, 255, 255, 0.85);
      text-transform: uppercase;
    }

    /* CHIP MODULES FOR STACK / OUTPUT / PROCESS */
    .ws-tri-module-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 18px;
    }

    .ws-pill-box {
      background: var(--dbl-surface-charcoal);
      border: 1px solid var(--dbl-border-subtle);
      border-radius: 6px;
      padding: 12px 16px;
    }

    .ws-pill-box-header {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: var(--dbl-text-tertiary);
      text-transform: uppercase;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .ws-pill-box-header .box-dot {
      color: var(--dbl-crimson);
    }

    .ws-chips-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }

    .ws-chip-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 500;
      letter-spacing: 0.05em;
      padding: 4px 9px;
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--dbl-border-subtle);
      color: var(--dbl-text-primary);
    }

    [data-theme="light"] .ws-chip-pill {
      background: rgba(0, 0, 0, 0.04);
    }

    /* ============================================================
       09. SECTION 04 — MY WORK (EXACTLY 6 MEDIA SLOTS)
       ============================================================ */
    .mywork-section {
      border-top: 1px solid var(--dbl-border-base);
      padding-top: clamp(64px, 8.5vh, 100px);
      margin-top: clamp(64px, 8.5vh, 100px);
      position: relative;
    }

    .mywork-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .mywork-card {
      position: relative;
      background: var(--dbl-surface-matte);
      border: 1px solid var(--dbl-border-base);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--dbl-theme-transition);
    }

    .mywork-card:hover {
      border-color: var(--dbl-border-strong);
      transform: translateY(-3px);
      box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.4);
    }

    .mywork-card.is-featured-cinema {
      grid-column: span 2;
    }

    .film-media-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 7.5;
      overflow: hidden;
      background: #09090C;
    }

    .mywork-card.is-featured-cinema .film-media-wrap {
      aspect-ratio: 21 / 8.5;
    }

    .film-media-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
      filter: brightness(0.92) contrast(1.05);
    }

    .mywork-card:hover .film-media-wrap img {
      transform: scale(1.025);
      filter: brightness(1.02) contrast(1.05);
    }

    .film-meta-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      font-weight: 700;
      letter-spacing: 0.18em;
      padding: 4px 10px;
      border-radius: 4px;
      background: rgba(14, 14, 18, 0.88);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #ffffff;
      text-transform: uppercase;
      z-index: 2;
    }

    .film-slot-badge {
      position: absolute;
      top: 14px;
      right: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      font-weight: 700;
      letter-spacing: 0.14em;
      padding: 4px 10px;
      border-radius: 4px;
      background: var(--dbl-crimson-subtle);
      border: 1px solid var(--dbl-crimson-border);
      color: var(--dbl-crimson);
      text-transform: uppercase;
      z-index: 2;
    }

    .film-card-body {
      padding: 22px 24px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .film-tag-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 700;
      letter-spacing: 0.18em;
      color: var(--dbl-crimson);
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .film-title {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(1.3rem, 2vw, 1.85rem);
      letter-spacing: 0.01em;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
      margin-bottom: 8px;
    }

    .film-desc {
      font-size: 13px;
      line-height: 1.6;
      color: var(--dbl-text-secondary);
      margin-bottom: 16px;
    }

    .film-tech-tags {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: auto;
    }

    .film-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.12em;
      padding: 3px 8px;
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--dbl-border-subtle);
      color: var(--dbl-text-tertiary);
      text-transform: uppercase;
    }

    [data-theme="light"] .film-pill {
      background: rgba(0, 0, 0, 0.03);
    }

    /* ============================================================
       10. SECTION 05 — THE PIPELINE (PROCESS WITHOUT A MANUAL)
       ============================================================ */
    /* ============================================================
       10. SECTION 05 — THE PIPELINE (OUMAHI-INSPIRED 3D IMAGE SPHERE)
       ============================================================ */
    .pipeline-section {
      border-top: 1px solid var(--dbl-border-base);
      padding-top: clamp(64px, 8.5vh, 100px);
      margin-top: clamp(64px, 8.5vh, 100px);
      position: relative;
    }

    .pipeline-sphere-viewport {
      position: relative;
      width: 100%;
      height: clamp(520px, 68vh, 680px);
      background: #08080C !important;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
      user-select: none;
    }

    .pipeline-sphere-viewport:active {
      cursor: grabbing;
    }

    #pipeline-3d-sphere-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .sphere-hint-badge {
      position: absolute;
      top: 18px;
      left: 20px;
      z-index: 10;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(11, 11, 13, 0.85);
      border: 1px solid var(--dbl-border-base);
      border-radius: 100px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--dbl-text-secondary);
      pointer-events: none;
      backdrop-filter: blur(12px);
    }

    .sphere-hint-icon {
      color: var(--dbl-crimson);
      font-size: 12px;
    }

    /* Modal / Inspector Drawer for selected sphere image */
    .sphere-inspect-panel {
      position: absolute;
      bottom: 20px;
      right: 20px;
      width: clamp(300px, 30vw, 400px);
      background: rgba(16, 16, 20, 0.95);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--dbl-border-strong);
      border-radius: 8px;
      padding: 20px;
      z-index: 20;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sphere-inspect-panel.is-active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .inspect-close-btn {
      position: absolute;
      top: 10px;
      right: 12px;
      background: transparent;
      border: none;
      color: var(--dbl-text-tertiary);
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s ease;
    }
    .inspect-close-btn:hover {
      color: var(--dbl-text-primary);
    }

    .inspect-media-preview {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 14px;
      border: 1px solid var(--dbl-border-base);
    }

    .inspect-media-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .inspect-cat-tag {
      position: absolute;
      bottom: 8px;
      left: 8px;
      background: rgba(0, 0, 0, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 3px 8px;
      border-radius: 3px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.14em;
      color: var(--dbl-crimson);
    }

    .inspect-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.06em;
      margin-bottom: 6px;
      color: var(--dbl-text-primary);
      text-transform: uppercase;
    }

    .inspect-desc {
      font-size: 12px;
      line-height: 1.55;
      color: var(--dbl-text-secondary);
      margin-bottom: 12px;
    }

    .inspect-meta-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .inspect-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      font-weight: 600;
      letter-spacing: 0.1em;
      padding: 3px 8px;
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--dbl-border-base);
      color: var(--dbl-text-secondary);
      text-transform: uppercase;
    }

    .inspect-metadata-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      border-top: 1px solid var(--dbl-border-subtle);
      padding-top: 12px;
    }

    .inspect-meta-cell {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .inspect-meta-cell .m-k {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      letter-spacing: 0.14em;
      color: var(--dbl-text-tertiary);
    }

    .inspect-meta-cell .m-v {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      font-weight: 600;
      color: var(--dbl-text-primary);
    }

    /* ============================================================
       11. SECTION 06 — DISCIPLINES (PRODUCT INC 3D RELATIONAL UNIVERSE)
       ============================================================ */
    .disciplines-section {
      border-top: 1px solid var(--dbl-border-base);
      padding-top: clamp(64px, 8.5vh, 100px);
      margin-top: clamp(64px, 8.5vh, 100px);
      position: relative;
    }

    .disciplines-universe-stage {
      position: relative;
      width: 100%;
      height: clamp(540px, 70vh, 680px);
      background: #08080C !important;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      user-select: none;
    }

    #disciplines-universe-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .universe-hint-badge {
      position: absolute;
      top: 18px;
      left: 20px;
      z-index: 10;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: rgba(11, 11, 13, 0.85);
      border: 1px solid var(--dbl-border-base);
      border-radius: 100px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.16em;
      color: var(--dbl-text-secondary);
      pointer-events: none;
      backdrop-filter: blur(12px);
    }

    .universe-hint-icon {
      color: var(--dbl-crimson);
      font-size: 12px;
    }

    .discipline-detail-panel {
      position: absolute;
      bottom: 20px;
      right: 20px;
      width: clamp(300px, 28vw, 380px);
      background: rgba(16, 16, 20, 0.95);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid var(--dbl-border-strong);
      border-radius: 8px;
      padding: 20px;
      z-index: 20;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .discipline-detail-panel.is-active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .d-detail-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .d-detail-category {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.16em;
      color: var(--dbl-crimson);
      text-transform: uppercase;
    }

    .d-detail-close {
      background: transparent;
      border: none;
      color: var(--dbl-text-tertiary);
      font-size: 20px;
      cursor: pointer;
      line-height: 1;
      transition: color 0.2s ease;
    }
    .d-detail-close:hover {
      color: var(--dbl-text-primary);
    }

    .d-detail-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--dbl-text-primary);
      text-transform: uppercase;
      margin-bottom: 8px;
      line-height: 1.25;
    }

    .d-detail-desc {
      font-size: 11.5px;
      line-height: 1.5;
      color: var(--dbl-text-secondary);
      margin-bottom: 12px;
    }

    .d-detail-visual {
      width: 100%;
      height: 110px;
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid var(--dbl-border-base);
      margin-bottom: 12px;
    }

    .d-detail-visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .d-detail-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .d-chip {
      font-family: 'JetBrains Mono', monospace;
      font-size: 8.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      padding: 3px 8px;
      border-radius: 3px;
      background: rgba(156, 40, 255, 0.14);
      border: 1px solid rgba(156, 40, 255, 0.35);
      color: #D8B4FE;
      text-transform: uppercase;
    }

    /* ============================================================
       12. SECTION 07 — LET'S BUILD (CLOSING FRAME & CONTACT)
       ============================================================ */
    .closing-build-section {
      border-top: 1px solid var(--dbl-border-base);
      padding-top: clamp(72px, 10vh, 120px);
      margin-top: clamp(64px, 8.5vh, 100px);
      position: relative;
      text-align: left;
    }

    .build-headline {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 800;
      font-size: clamp(2.6rem, 5.5vw, 5.4rem);
      letter-spacing: -0.03em;
      line-height: 0.95;
      text-transform: uppercase;
      color: var(--dbl-text-primary);
      margin-bottom: 24px;
      max-width: 900px;
    }

    .build-statement {
      font-size: clamp(15px, 1.35vw, 18px);
      line-height: 1.6;
      color: var(--dbl-text-secondary);
      max-width: 640px;
      margin-bottom: 42px;
    }

    .build-contact-actions {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .build-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 14px 26px;
      border-radius: 6px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .build-btn-primary {
      background: var(--dbl-crimson);
      color: #ffffff;
      border: 1px solid var(--dbl-crimson);
      box-shadow: 0 4px 18px var(--dbl-crimson-glow);
    }

    .build-btn-primary:hover {
      background: #e62028;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px var(--dbl-crimson-glow);
    }

    .build-btn-secondary {
      background: var(--dbl-surface-matte);
      color: var(--dbl-text-primary);
      border: 1px solid var(--dbl-border-base);
    }

    .build-btn-secondary:hover {
      border-color: var(--dbl-border-strong);
      transform: translateY(-2px);
    }

    /* SITE FOOTER STRIP */
    .site-footer-strip {
      border-top: 1px solid var(--dbl-border-base);
      padding: 40px 0;
      margin-top: 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--dbl-text-tertiary);
      text-transform: uppercase;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-contact-links {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .footer-link {
      color: var(--dbl-text-secondary);
      text-decoration: none;
      transition: color 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .footer-link:hover {
      color: var(--dbl-crimson);
    }

    /* ============================================================
       13. RESPONSIVE BREAKPOINTS
       ============================================================ */
    @media (max-width: 1080px) {
      .metrics-production-archive {
        grid-template-columns: 1fr 1fr;
      }
      .metric-module.is-primary {
        grid-column: span 2;
        grid-row: auto;
      }
      .supporting-metric-band {
        grid-template-columns: 1fr 1fr;
      }
      .filmography-grid {
        grid-template-columns: 1fr;
      }
      .film-card.is-featured-cinema {
        grid-column: span 1;
      }
      .pipeline-chain-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .disciplines-grid {
        grid-template-columns: 1fr 1fr;
      }
      .journey-layout {
        grid-template-columns: 1fr;
      }
      .journey-workspace-panel {
        position: relative;
        top: 0;
      }
    }

    @media (max-width: 680px) {
      .metrics-production-archive {
        grid-template-columns: 1fr;
      }
      .metric-module.is-primary {
        grid-column: span 1;
      }
      .supporting-metric-band {
        grid-template-columns: 1fr;
      }
      .pipeline-chain-grid {
        grid-template-columns: 1fr 1fr;
      }
      .disciplines-grid {
        grid-template-columns: 1fr;
      }
      .ws-modular-grid {
        grid-template-columns: 1fr;
      }
      .career-evolution-strip {
        flex-wrap: wrap;
      }
      .hero-header {
        height: 56px;
        padding: 0 16px;
      }
      .brand-designfolio,
      .header-tag-pill {
        display: none;
      }
      .hero-left-stage {
        left: 16px;
        top: 50%;
        transform: translateY(-46%);
        width: calc(100vw - 32px);
      }
      .sticky-note {
        width: min(calc(100vw - 36px), 295px);
        padding: 20px 18px 16px 18px;
      }
      .cinematic-stage {
        aspect-ratio: 16 / 9;
        min-height: 200px;
      }
    }
  </style>
</head>

<body>

  <!-- AQUA GLOW TRAIL CANVAS -->
  <canvas id="cursor-trail-canvas" aria-hidden="true"></canvas>

  <!-- SECTION-AWARE VECTOR TRIANGULAR ARROWHEAD CURSOR -->
  <div id="section-cursor" class="section-cursor" aria-hidden="true">
    <svg class="section-cursor-svg" viewBox="0 0 24 24" width="18" height="18">
      <polygon points="2,2 18,7 11,11 7,18" />
    </svg>
  </div>

  <!-- CIRCULAR THEME REVEAL CURTAIN (EXPANDS FROM THEME ICON POSITION IN POST-HERO) -->
  <div id="theme-circle-curtain" aria-hidden="true"></div>

  <!-- HERO-ONLY THIN GLOSSY CIRCULAR RIPPLE RING -->
  <div id="hero-theme-gloss-ring" aria-hidden="true"></div>

  <!-- ============================================================
       0. OPENING CENTER SPLASH (GLYPH LOTTERY BRANDING + GLITCH — EXACT 0.5S)
       ============================================================ -->
  <div class="center-splash" id="center-splash">
    <div class="splash-content splash-glitching" id="splash-content">
      <span class="splash-title" id="splash-title">CBK <span id="splash-df">DESIGNFOLIO</span></span>
    </div>
  </div>

  <!-- MULTIVERSE / DIMENSIONAL GLITCH LAYER (SECOND GLITCH TRANSITION) -->
  <div class="multiverse-glitch-layer" id="multiverse-glitch-layer" aria-hidden="true"></div>

  <!-- ============================================================
       1. FIXED DBL HEADER (THEME TOGGLE + LIVE CLOCK)
       ============================================================ -->
  <header class="hero-header" id="hero-header">
    <div class="header-left">
      <a href="#hero-section" class="brand-group" aria-label="Home — C. Bala Krishnan">
        <span class="brand-cbk">CBK</span>
        
        <span class="brand-designfolio" id="brand-df"><span class="df-char" data-orig="D" data-idx="0">D</span><span class="df-char" data-orig="E" data-idx="1">E</span><span class="df-char" data-orig="S" data-idx="2">S</span><span class="df-char" data-orig="I" data-idx="3">I</span><span class="df-char" data-orig="G" data-idx="4">G</span><span class="df-char" data-orig="N" data-idx="5">N</span><span class="df-char" data-orig="F" data-idx="6">F</span><span class="df-char" data-orig="O" data-idx="7">O</span><span class="df-char" data-orig="L" data-idx="8">L</span><span class="df-char" data-orig="I" data-idx="9">I</span><span class="df-char" data-orig="O" data-idx="10">O</span><span class="df-slot-indicator" id="df-slot"></span></span>
      </a>

      <span class="header-tag-pill">DBL // V3 ARCHIVE</span>
    </div>

    <div class="header-right">
      <div class="time-block">
        <span class="time-prefix">LOCAL</span>
        <span class="time-digits" id="time-digits">--:--:--</span>
        <span class="time-period" id="time-period">--</span>
      </div>

      <!-- THEME TOGGLE ICON (COMPACT, MINIMAL, NO TEXT) -->
      <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle visual theme">
        <!-- Sun icon (for dark mode: click to switch to light) -->
        <svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (for light mode: click to switch to dark) -->
        <svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
