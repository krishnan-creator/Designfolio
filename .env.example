# ============================================================
# CBK DESIGNFOLIO — BACKSTAGE CMS CONFIGURATION
# ============================================================

# PORT for the local portfolio development server (default: 3000)
PORT=3000

# ADMINISTRATIVE PASSPHRASE (Fallback Authentication Method)
# If provided, this passphrase takes top priority for BACKSTAGE access.
# If left blank or omitted, BACKSTAGE will prompt you to set your
# passphrase securely on your first visit, storing it as a salted cryptographic
# scrypt hash in data/auth.json (server-side only).
#
# To reset your passphrase at any time:
#   Option A: Enter a new BACKSTAGE_PASSWORD here in .env
#   Option B: Delete data/auth.json to re-trigger the visual setup screen
BACKSTAGE_PASSWORD=

# ============================================================
# METHOD 1: GMAIL OTP DELIVERY (Default Sign-in Method)
# Destination: project2krishnan@gmail.com
# ============================================================
# For live email OTP dispatch to project2krishnan@gmail.com, configure
# your Gmail credentials using a 16-character Google App Password:
#
# How to generate a Google App Password:
# 1. Sign in to your Google Account (project2krishnan@gmail.com).
# 2. Go to Security -> 2-Step Verification (must be enabled).
# 3. Scroll to "App passwords" -> Create a new app password named "CBK Backstage".
# 4. Copy the generated 16-character code (e.g. "abcd efgh ijkl mnop") below.
GMAIL_USER=project2krishnan@gmail.com
GMAIL_APP_PASSWORD=

# Optional: Alternative Generic SMTP Configuration
# (If GMAIL_USER / GMAIL_APP_PASSWORD are not used)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CBK Security <project2krishnan@gmail.com>"

# Optional: Alternative Resend API Key
RESEND_API_KEY=
EMAIL_FROM=

# ============================================================
# METHOD 2: AUTHENTICATOR APP (TOTP)
# Standard RFC 6238 time-based one-time passwords (30s window).
# Compatible with Google Authenticator, Microsoft Authenticator, 1Password, etc.
# Enrollment is handled directly inside Backstage via QR code scanning.
# Secret keys are stored securely in data/auth.json and never exposed.
# ============================================================
